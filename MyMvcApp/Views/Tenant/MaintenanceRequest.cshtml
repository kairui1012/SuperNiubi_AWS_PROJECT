@model MaintenanceRequestViewModel
@{
    ViewData["Title"] = "Maintenance Requests";
    var pendingCount = Model.Requests.Count(r => r.Status == MaintenanceStatus.Pending);
    var approvedCount = Model.Requests.Count(r => r.Status == MaintenanceStatus.Approved);
    var completedCount = Model.Requests.Count(r => r.Status == MaintenanceStatus.Completed);
}

<link rel="stylesheet" href="~/css/pages/tenant-theme.css" asp-append-version="true" />


<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a asp-action="Dashboard" class="tenant-rail-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a asp-action="MyProperty" class="tenant-rail-link"><i class="bi bi-house-door-fill"></i> Property</a>
            <a asp-action="MaintenanceRequest" class="tenant-rail-link active"><i class="bi bi-tools"></i> Maintenance</a>
            <a asp-action="Payments" class="tenant-rail-link"><i class="bi bi-wallet2"></i> Payments</a>
            <a asp-action="Visitors" class="tenant-rail-link"><i class="bi bi-qr-code-scan"></i> Visitors</a>
            <a asp-action="Documents" class="tenant-rail-link"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
            <a asp-action="Announcements" class="tenant-rail-link"><i class="bi bi-megaphone-fill"></i> Announcements</a>
        </nav>
    </aside>

    <section class="tenant-workspace">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="tenant-toolbar">
            <div>
                <p class="tenant-kicker">Maintenance Desk</p>
                <h1 class="tenant-heading">Service Requests</h1>
                <p class="tenant-sub">Create tickets, monitor status changes, and maintain a clear issue timeline.</p>
            </div>
            <button class="btn tenant-btn tenant-btn-primary" onclick="toggleForm()">+ New Request</button>
        </div>

        <div class="tenant-grid-4">
            <div class="tenant-stat"><div class="tenant-stat-label">Total</div><div class="tenant-stat-value">@Model.Requests.Count</div><span class="tenant-badge badge-primary">Tickets</span></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Pending</div><div class="tenant-stat-value">@pendingCount</div><span class="tenant-badge badge-warning">Waiting</span></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Approved</div><div class="tenant-stat-value">@approvedCount</div><span class="tenant-badge badge-primary">Scheduled</span></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Completed</div><div class="tenant-stat-value">@completedCount</div><span class="tenant-badge badge-success">Closed</span></div>
        </div>

        <div class="tenant-panel">
            <div class="tenant-panel-head">
                <h3 class="tenant-panel-title">Maintenance Analytics</h3>
            </div>
            <div class="tenant-panel-body">
                <div class="tenant-chart-wrap tenant-chart-wrap-sm">
                    <canvas id="tenantMaintenanceQueueChart" aria-label="Maintenance queue chart"></canvas>
                </div>
            </div>
        </div>

        <div class="tenant-panel" id="createForm" style="display:none;">
            <div class="tenant-panel-head">
                <h3 class="tenant-panel-title">Create Maintenance Ticket</h3>
            </div>
            <div class="tenant-panel-body tenant-form">
                <form asp-action="CreateMaintenance" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="tenant-form-grid">
                        <div>
                            <label for="issue">Issue Title</label>
                            <input id="issue" class="form-control" type="text" name="NewRequest.Title" value="@Model.NewRequest?.Title" placeholder="e.g. Air conditioner not working" required />
                            <span asp-validation-for="NewRequest.Title" class="text-danger"></span>
                        </div>
                        <div>
                            <label for="category">Category</label>
                            <select id="category" class="form-select" asp-for="NewRequest.Category" required>
                                <option value="" disabled>Select category</option>
                                <option value="Plumbing">Plumbing</option>
                                <option value="Electrical">Electrical</option>
                                <option value="AirConditioning">Air Conditioning</option>
                                <option value="Structural">Structural</option>
                                <option value="Appliances">Appliances</option>
                                <option value="PestControl">Pest Control</option>
                                <option value="Others">Others</option>
                            </select>
                        </div>
                        <div>
                            <label for="priority">Priority</label>
                            <select id="priority" class="form-select" asp-for="NewRequest.Priority" required>
                                <option value="" disabled>Select priority</option>
                                <option value="High">High - Urgent</option>
                                <option value="Medium">Medium - Normal</option>
                                <option value="Low">Low - Non-urgent</option>
                            </select>
                        </div>
                        <div>
                            <label for="date">Preferred Date</label>
                            <input id="date" class="form-control" type="date" name="NewRequest.PreferredDate" />
                            <span asp-validation-for="NewRequest.PreferredDate" class="text-danger"></span>
                        </div>
                        <div class="full">
                            <label for="description">Description</label>
                            <textarea id="description" class="form-control" name="NewRequest.Description" placeholder="Please describe the issue in detail..."></textarea>
                            <span asp-validation-for="NewRequest.Description" class="text-danger"></span>
                        </div>
                        <div class="full">
                            <label for="issueImage">Issue Image (optional)</label>
                            <input id="issueImage" class="form-control" type="file" asp-for="NewRequest.IssueImage" accept=".jpg,.jpeg,.png,.webp" />
                            <span asp-validation-for="NewRequest.IssueImage" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn tenant-btn tenant-btn-outline" onclick="toggleForm()">Cancel</button>
                        <button type="submit" class="btn tenant-btn tenant-btn-primary">Submit Request</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="tenant-panel">
            <div class="tenant-panel-head">
                <h3 class="tenant-panel-title">Request Queue</h3>
                <div class="tenant-filter">
                    <button class="filter-btn active" onclick="filterRequests(this,'all')">All</button>
                    <button class="filter-btn" onclick="filterRequests(this,'Pending')">Pending</button>
                    <button class="filter-btn" onclick="filterRequests(this,'Approved')">Approved</button>
                    <button class="filter-btn" onclick="filterRequests(this,'Completed')">Completed</button>
                </div>
            </div>
            <div class="tenant-panel-body p-0">
                @if (Model.Requests.Count <= 0)
                {
                    <div class="tenant-empty"><i class="bi bi-inbox d-block mb-2"></i>No requests made recently.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="tenant-table requests-table">
                            <thead>
                                <tr>
                                    <th>Issue</th>
                                    <th>Category</th>
                                    <th>Priority</th>
                                    <th>Submitted</th>
                                    <th>Status</th>
                                    <th>Timeline / Response</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in Model.Requests)
                                {
                                    var statusClass = req.Status == MaintenanceStatus.Completed
                                        ? "badge-success"
                                        : req.Status == MaintenanceStatus.Approved || req.Status == MaintenanceStatus.InProgress
                                            ? "badge-primary"
                                            : req.Status == MaintenanceStatus.Rejected
                                                ? "badge-danger"
                                                : "badge-warning";
                                    <tr data-status="@req.Status">
                                        <td>
                                            <strong>@req.Title</strong>
                                            <div class="tenant-sub">@req.Description</div>
                                            @if (!string.IsNullOrWhiteSpace(req.IssueImageKey))
                                            {
                                                <div class="mt-2">
                                                    <a class="tenant-link" href="@($"/{req.IssueImageKey}")" target="_blank" rel="noopener noreferrer">View issue image</a>
                                                </div>
                                            }
                                        </td>
                                        <td>@req.Category</td>
                                        <td>@req.Priority</td>
                                        <td>@req.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td><span class="tenant-badge @statusClass">@req.Status</span></td>
                                        <td>
                                            <div class="tenant-sub">Updated: @req.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</div>
                                            @if (req.ResolvedDate.HasValue)
                                            {
                                                <div class="tenant-sub">Resolved: @req.ResolvedDate.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(req.LandlordRemarks))
                                            {
                                                <div class="tenant-sub mt-1"><strong>Landlord:</strong> @req.LandlordRemarks</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(req.AssignedVendor))
                                            {
                                                <div class="tenant-sub mt-1"><strong>Vendor:</strong> @req.AssignedVendor</div>
                                            }
                                            @if (req.EstimatedRepairCost.HasValue)
                                            {
                                                <div class="tenant-sub mt-1"><strong>Estimate:</strong> RM @req.EstimatedRepairCost.Value.ToString("N2")</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(req.RepairImageKey))
                                            {
                                                <div class="mt-1">
                                                    <a class="tenant-link" href="@($"/{req.RepairImageKey}")" target="_blank" rel="noopener noreferrer">View repair image</a>
                                                </div>
                                            }
                                            @if (req.TenantConfirmedAt.HasValue)
                                            {
                                                <div class="tenant-sub mt-1">Confirmed by tenant @req.TenantConfirmedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                @if (req.TenantFeedbackRating.HasValue)
                                                {
                                                    <div class="tenant-sub">Rating: @req.TenantFeedbackRating / 5</div>
                                                }
                                            }
                                            @if (req.Timeline.Any())
                                            {
                                                <details class="mt-2">
                                                    <summary class="tenant-link">View timeline</summary>
                                                    <div class="tenant-sub mt-2">
                                                        @foreach (var item in req.Timeline.OrderBy(t => t.CreatedAt))
                                                        {
                                                            <div class="mb-2">
                                                                <strong>@item.Action</strong>
                                                                <div>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm") by @item.ActorEmail</div>
                                                                @if (!string.IsNullOrWhiteSpace(item.Details))
                                                                {
                                                                    <div>@item.Details</div>
                                                                }
                                                            </div>
                                                        }
                                                    </div>
                                                </details>
                                            }
                                        </td>
                                        <td>
                                            @if (req.Status == MaintenanceStatus.Completed && !req.TenantConfirmedAt.HasValue)
                                            {
                                                <form asp-action="ConfirmMaintenanceCompletion" method="post" class="d-grid gap-2">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="requestId" value="@req.RequestId" />
                                                    <select class="form-select form-select-sm" name="rating">
                                                        <option value="">Rate service (optional)</option>
                                                        <option value="5">5 - Excellent</option>
                                                        <option value="4">4 - Good</option>
                                                        <option value="3">3 - Fair</option>
                                                        <option value="2">2 - Poor</option>
                                                        <option value="1">1 - Very Poor</option>
                                                    </select>
                                                    <input class="form-control form-control-sm" name="feedbackComment" placeholder="Feedback (optional)" maxlength="1000" />
                                                    <button type="submit" class="btn btn-sm tenant-btn tenant-btn-primary">Confirm Completion</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="tenant-sub">No action</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
    const hasError = @(ViewData.ModelState.IsValid ? "false" : "true");

    if (hasError) {
        window.addEventListener('DOMContentLoaded', () => toggleForm());
    }

    function toggleForm() {
        const form = document.getElementById('createForm');
        form.classList.toggle('console-open');
        if (form.classList.contains('console-open')) {
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function filterRequests(btn, status) {
        document.querySelectorAll('.tenant-filter .filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.requests-table tbody tr').forEach(row => {
            row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
        });
    }

    (() => {
        const chartElement = document.getElementById('tenantMaintenanceQueueChart');
        if (!chartElement || !window.Chart) {
            return;
        }

        const values = [@pendingCount, @approvedCount, @Model.Requests.Count(r => r.Status == MaintenanceStatus.InProgress), @completedCount, @Model.Requests.Count(r => r.Status == MaintenanceStatus.Rejected)];
        const hasData = values.some((v) => v > 0);
        const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        const tickColor = isDark ? '#94a3b8' : '#64748b';
        const borderColor = isDark ? '#1e293b' : '#ffffff';

        new Chart(chartElement, {
            type: 'doughnut',
            data: {
                labels: hasData ? ['Pending', 'Approved', 'In Progress', 'Completed', 'Rejected'] : ['No data'],
                datasets: [{
                    data: hasData ? values : [1],
                    backgroundColor: hasData ? ['#f59e0b', '#0ea5e9', '#2563eb', '#10b981', '#ef4444'] : ['#cbd5e1'],
                    borderColor,
                    borderWidth: 3,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '62%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: tickColor, boxWidth: 12, padding: 12 }
                    }
                }
            }
        });
    })();
</script>
