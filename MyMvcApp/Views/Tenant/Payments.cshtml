@model TenantPaymentsViewModel
@{
    ViewData["Title"] = "Payments";
    var displayMonthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.NewPayment.PaymentMonth);
}

<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a asp-action="Dashboard" class="tenant-rail-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a asp-action="MyProperty" class="tenant-rail-link"><i class="bi bi-house-door-fill"></i> Property</a>
            <a asp-action="MaintenanceRequest" class="tenant-rail-link"><i class="bi bi-tools"></i> Maintenance</a>
            <a asp-action="Payments" class="tenant-rail-link active"><i class="bi bi-wallet2"></i> Payments</a>
            <a asp-action="Visitors" class="tenant-rail-link"><i class="bi bi-qr-code-scan"></i> Visitors</a>
            <a asp-action="Documents" class="tenant-rail-link"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
            <a asp-action="Announcements" class="tenant-rail-link"><i class="bi bi-megaphone-fill"></i> Announcements</a>
        </nav>
    </aside>

    <section class="tenant-workspace">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <div class="tenant-toolbar">
            <div>
                <p class="tenant-kicker">Billing Center</p>
                <h1 class="tenant-heading">Rent Payment Portal</h1>
                <p class="tenant-sub">Pay your rent instantly, keep a clean payment history, and avoid manual receipt uploads.</p>
            </div>
            <button class="btn tenant-btn tenant-btn-primary" onclick="toggleForm()">+ Pay Now</button>
        </div>

        <div class="tenant-grid-4">
            <div class="tenant-stat"><div class="tenant-stat-label">Total Verified</div><div class="tenant-stat-value">@Model.TotalVerifiedAmount.ToString("C")</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Payments Recorded</div><div class="tenant-stat-value">@Model.Payments.Count</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Next Due</div><div class="tenant-stat-value">@(Model.NextDueDate?.ToLocalTime().ToString("dd MMM") ?? "-")</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Monthly Rent</div><div class="tenant-stat-value">@Model.MonthlyRent.ToString("C")</div></div>
        </div>

        <div class="tenant-panel" id="uploadForm" style="display:none;">
            <div class="tenant-panel-head"><h3 class="tenant-panel-title">Payment Checkout</h3></div>
            <div class="tenant-panel-body tenant-form">
                <form asp-action="UploadPayment" method="post" id="paymentForm">
                    @Html.AntiForgeryToken()
                    <div class="tenant-form-grid">
                        <div>
                            <label>Payment Month</label>
                            <input class="form-control"
                                value="@displayMonthName"
                                readonly 
                                style="background-color: #e9ecef; cursor: not-allowed;" />
                            
                            <input type="hidden" asp-for="NewPayment.PaymentMonth"/>
                            <span asp-validation-for="NewPayment.PaymentMonth" class="text-danger"></span>
                        </div>
                        <div>
                            <label>Payment Year</label>
                            <input class="form-control" asp-for="NewPayment.PaymentYear" type="number" min="2000" max="2100" readonly style="background-color: #e9ecef; cursor: not-allowed;" />
                            <input type="hidden" asp-for="NewPayment.PaymentYear" />
                            <span asp-validation-for="NewPayment.PaymentYear" class="text-danger"></span>
                        </div>
                        <div>
                            <label>Amount Paid (RM)</label>
                            <input class="form-control" asp-for="NewPayment.Amount" type="number" placeholder="1200.00" step="0.01" min="0" readonly style="background-color: #e9ecef; cursor: not-allowed;" />
                            <input type="hidden" asp-for="NewPayment.Amount" />
                            <span asp-validation-for="NewPayment.Amount" class="text-danger"></span>
                        </div>
                        <div>
                            <label>Payment Date</label>
                            <input class="form-control" asp-for="NewPayment.PaymentDate" type="date" readonly style="background-color: #e9ecef; cursor: not-allowed;" />
                            <input type="hidden" asp-for="NewPayment.PaymentDate" />
                            <span asp-validation-for="NewPayment.PaymentDate" class="text-danger"></span>
                        </div>
                        <div>
                            <label>Payment Method</label>
                            <select class="form-select" asp-for="NewPayment.PaymentMethod">
                                <option value="OnlineTransfer">Online Transfer</option>
                                <option value="Cash">Cash</option>
                                <option value="Cheque">Cheque</option>
                                <option value="DuitNow">DuitNow / QR</option>
                                <option value="Others">Others</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn tenant-btn tenant-btn-outline" onclick="toggleForm()">Cancel</button>
                        <button type="submit" class="btn tenant-btn tenant-btn-primary" id="confirmPaymentBtn">Confirm Payment</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="paymentProcessingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content">
                    <div class="modal-body text-center py-4">
                        <div class="spinner-border text-primary mb-3" role="status" aria-hidden="true"></div>
                        <h5 class="mb-1">Processing payment</h5>
                        <p class="text-muted mb-0">We are processing your payment. Please wait...</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="tenant-panel">
            <div class="tenant-panel-head"><h3 class="tenant-panel-title">Payment History</h3></div>
            <div class="tenant-panel-body p-0">
                <div class="table-responsive">
                    <table class="tenant-table">
                        <thead>
                            <tr>
                                <th>Month</th>
                                <th>Amount</th>
                                <th>Date Paid</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th>Note</th>
                                <th>Receipt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Payments.Count == 0)
                            {
                                <tr><td colspan="8" class="text-center">No payment records yet.</td></tr>
                            }
                            else
                            {
                                @foreach (var payment in Model.Payments)
                                {
                                    var badgeClass = payment.Status == PaymentStatus.Verified
                                        ? "badge-success"
                                        : payment.Status == PaymentStatus.Submitted
                                            ? "badge-primary"
                                            : payment.Status == PaymentStatus.Pending || payment.Status == PaymentStatus.Overdue
                                                ? "badge-warning"
                                                : "badge-danger";
                                    <tr>
                                        <td><strong>@payment.PaymentMonth @payment.PaymentYear</strong></td>
                                        <td>@payment.Amount.ToString("C")</td>
                                        <td>@(payment.PaymentDate?.ToLocalTime().ToString("dd MMM yyyy") ?? "-")</td>
                                        <td>@(payment.PaymentMethod?.ToString() ?? "-")</td>
                                        <td>@(string.IsNullOrWhiteSpace(payment.ReferenceNo) ? "-" : payment.ReferenceNo)</td>
                                        <td><span class="tenant-badge @badgeClass">@payment.Status</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(payment.LandlordRemarks) ? "-" : payment.LandlordRemarks)</td>
                                        <td>
                                            @if (string.IsNullOrWhiteSpace(payment.ReceiptFileKey))
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                <a class="tenant-link" href="@($"/{payment.ReceiptFileKey}")" target="_blank" rel="noopener noreferrer">View PDF</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    function toggleForm() {
        const form = document.getElementById('uploadForm');
        form.classList.toggle('console-open');
        if (form.classList.contains('console-open')) {
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    const paymentForm = document.getElementById('paymentForm');
    
    if (paymentForm) {
        paymentForm.addEventListener('submit', function (event) {
            event.preventDefault();

            const submitButton = document.getElementById('confirmPaymentBtn');
            const processingModalElement = document.getElementById('paymentProcessingModal');

            if (submitButton) submitButton.disabled = true;

            if (processingModalElement) {
                const processingModal = new bootstrap.Modal(processingModalElement);
                processingModal.show();
            }

            setTimeout(function () {
                paymentForm.submit();
            }, 1500); 
        });
    }

    if (document.querySelector('#uploadForm span.text-danger:not(:empty)')) {
        toggleForm();
    }
</script>
