@{
    ViewData["Title"] = "Payments";
}
<link rel="stylesheet" href="~/css/pages/tenant-theme.css" asp-append-version="true" />

<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a href="/Tenant/Tenant" class="tenant-rail-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a href="/Tenant/MyProperty" class="tenant-rail-link"><i class="bi bi-house-door-fill"></i> Property</a>
            <a href="/Tenant/MaintenanceRequest" class="tenant-rail-link"><i class="bi bi-tools"></i> Maintenance</a>
            <a href="/Tenant/Payments" class="tenant-rail-link active"><i class="bi bi-wallet2"></i> Payments</a>
            <a href="/Tenant/Documents" class="tenant-rail-link"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
        </nav>
    </aside>

    <section class="tenant-workspace">
        <div class="tenant-toolbar">
            <div>
                <p class="tenant-kicker">Billing Center</p>
                <h1 class="tenant-heading">Rent Payments</h1>
                <p class="tenant-sub">Track payment cycles, upload receipts, and keep billing records audit-ready.</p>
            </div>
            <button class="btn tenant-btn tenant-btn-primary" onclick="toggleForm()">+ Upload Receipt</button>
        </div>

        <div class="tenant-grid-4">
            <div class="tenant-stat"><div class="tenant-stat-label">Total Paid (2025)</div><div class="tenant-stat-value">RM 6,000</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Payments Recorded</div><div class="tenant-stat-value">5</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Next Due</div><div class="tenant-stat-value">1 May</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Monthly Rent</div><div class="tenant-stat-value">RM 1,200</div></div>
        </div>

        <div class="tenant-panel" id="uploadForm" style="display:none;">
            <div class="tenant-panel-head"><h3 class="tenant-panel-title">Upload Payment Receipt</h3></div>
            <div class="tenant-panel-body tenant-form">
                <form asp-action="UploadPayment" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="tenant-form-grid">
                        <div>
                            <label>Payment Month</label>
                            <select class="form-select" name="PaymentMonth" required>
                                <option value="" disabled selected>Select month</option>
                                <option>January 2025</option>
                                <option>February 2025</option>
                                <option>March 2025</option>
                                <option>April 2025</option>
                                <option>May 2025</option>
                            </select>
                        </div>
                        <div>
                            <label>Amount Paid (RM)</label>
                            <input class="form-control" type="number" name="Amount" placeholder="1200.00" step="0.01" min="0" required />
                        </div>
                        <div>
                            <label>Payment Date</label>
                            <input class="form-control" type="date" name="PaymentDate" required />
                        </div>
                        <div>
                            <label>Payment Method</label>
                            <select class="form-select" name="PaymentMethod">
                                <option>Online Transfer</option>
                                <option>Cash</option>
                                <option>Cheque</option>
                                <option>DuitNow / QR</option>
                            </select>
                        </div>
                        <div>
                            <label>Reference No.</label>
                            <input class="form-control" type="text" name="ReferenceNo" placeholder="e.g. TXN123456789" />
                        </div>
                        <div>
                            <label>Receipt / Proof</label>
                            <div class="drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
                                <input type="file" id="fileInput" name="ReceiptFile" accept=".pdf,.jpg,.jpeg,.png" />
                                <div><i class="bi bi-paperclip fs-4"></i></div>
                                <div class="tenant-sub drop-zone-text"><strong>Click to upload</strong> or drag and drop</div>
                                <div class="tenant-sub">PDF, JPG, PNG - max 5MB</div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn tenant-btn tenant-btn-outline" onclick="toggleForm()">Cancel</button>
                        <button type="submit" class="btn tenant-btn tenant-btn-primary">Upload Payment</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="tenant-panel">
            <div class="tenant-panel-head"><h3 class="tenant-panel-title">Payment History</h3></div>
            <div class="tenant-panel-body p-0">
                <div class="table-responsive">
                    <table class="tenant-table">
                        <thead>
                            <tr>
                                <th>Month</th>
                                <th>Amount</th>
                                <th>Date Paid</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th>Status</th>
                                <th>Receipt</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><strong>April 2025</strong></td><td>RM 1,200.00</td><td>1 Apr 2025</td><td>Online Transfer</td><td>TXN-0041234</td><td><span class="tenant-badge badge-success">Verified</span></td><td><a href="#" class="tenant-link">Download</a></td></tr>
                            <tr><td><strong>March 2025</strong></td><td>RM 1,200.00</td><td>2 Mar 2025</td><td>DuitNow</td><td>TXN-0038921</td><td><span class="tenant-badge badge-success">Verified</span></td><td><a href="#" class="tenant-link">Download</a></td></tr>
                            <tr><td><strong>February 2025</strong></td><td>RM 1,200.00</td><td>1 Feb 2025</td><td>Online Transfer</td><td>TXN-0035678</td><td><span class="tenant-badge badge-success">Verified</span></td><td><a href="#" class="tenant-link">Download</a></td></tr>
                            <tr><td><strong>January 2025</strong></td><td>RM 1,200.00</td><td>1 Jan 2025</td><td>Cash</td><td>-</td><td><span class="tenant-badge badge-success">Verified</span></td><td><a href="#" class="tenant-link">Download</a></td></tr>
                            <tr><td><strong>May 2025</strong></td><td>RM 1,200.00</td><td>-</td><td>-</td><td>-</td><td><span class="tenant-badge badge-warning">Pending</span></td><td>-</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<script>
    function toggleForm() {
        const form = document.getElementById('uploadForm');
        form.classList.toggle('console-open');
        if (form.classList.contains('console-open')) {
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');

    dropZone.addEventListener('dragover', e => {
        e.preventDefault();
        dropZone.classList.add('dragover');
    });

    dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('dragover');
    });

    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer.files.length) {
            fileInput.files = e.dataTransfer.files;
            dropZone.querySelector('.drop-zone-text').innerHTML = '<strong>' + e.dataTransfer.files[0].name + '</strong>';
        }
    });

    fileInput.addEventListener('change', () => {
        if (fileInput.files.length) {
            dropZone.querySelector('.drop-zone-text').innerHTML = '<strong>' + fileInput.files[0].name + '</strong>';
        }
    });
</script>
