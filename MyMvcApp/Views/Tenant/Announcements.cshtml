@model List<MyMvcApp.Models.SystemAnnouncement>
@{
    ViewData["Title"] = "Announcements";
}

<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a asp-action="TenantDashboard" class="tenant-rail-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a asp-action="MyProperty" class="tenant-rail-link"><i class="bi bi-house-door-fill"></i> Property</a>
            <a asp-action="MaintenanceRequest" class="tenant-rail-link"><i class="bi bi-tools"></i> Maintenance</a>
            <a asp-action="Payments" class="tenant-rail-link"><i class="bi bi-wallet2"></i> Payments</a>
            <a asp-action="Visitors" class="tenant-rail-link"><i class="bi bi-qr-code-scan"></i> Visitors</a>
            <a asp-action="Documents" class="tenant-rail-link"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
            <a asp-action="Announcements" class="tenant-rail-link active"><i class="bi bi-megaphone-fill"></i> Announcements</a>
        </nav>
    </aside>

    <section class="tenant-workspace">
        <div class="tenant-toolbar">
            <div>
                <p class="tenant-kicker">System Notices</p>
                <h1 class="tenant-heading">Announcements</h1>
                <p class="tenant-sub">Important notices from property management.</p>
            </div>
            <div class="tenant-time">
                <strong>@DateTime.Now.ToString("dddd, dd MMM yyyy")</strong>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (Model == null || Model.Count == 0)
        {
            <div class="tenant-overview-panel">
                <div class="tenant-empty compact">No announcements at this time.</div>
            </div>
        }
        else
        {
            <div class="tenant-announce-list">
                @foreach (var ann in Model)
                {
                    var badgeClass = ann.VisibleTo switch
                    {
                        "Tenant" => "badge-primary",
                        "Landlord" => "badge-warning",
                        _ => "badge-success"
                    };
                    var badgeLabel = ann.VisibleTo switch
                    {
                        "Tenant" => "Tenants",
                        "Landlord" => "Landlords",
                        _ => "All users"
                    };

                    <article class="tenant-overview-panel tenant-announce-card">
                        <div class="tenant-announce-header">
                            <div>
                                <h3 class="tenant-announce-title">@ann.Title</h3>
                                <div class="tenant-announce-meta">
                                    <span class="tenant-badge @badgeClass">@badgeLabel</span>
                                    <span class="tenant-sub">@ann.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                    @if (ann.UpdatedAt.HasValue)
                                    {
                                        <span class="tenant-sub">(edited @ann.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy"))</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <p class="tenant-announce-body">@ann.Body</p>
                    </article>
                }
            </div>
        }
    </section>
</div>

<style>
    .tenant-announce-list { display: flex; flex-direction: column; gap: 1rem; }
    .tenant-announce-card { padding: 1.25rem 1.5rem; }
    .tenant-announce-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: .5rem; }
    .tenant-announce-title { font-size: 1rem; font-weight: 700; margin: 0 0 .35rem; }
    .tenant-announce-meta { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .tenant-announce-body { margin: 0; white-space: pre-wrap; }
</style>
