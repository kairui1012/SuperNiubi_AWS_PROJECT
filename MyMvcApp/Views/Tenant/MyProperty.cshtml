@model TenantPropertyViewModel
@{
    ViewData["Title"] = "My Property";

    var property = Model.Property;
    var fullAddress = string.Join(", ", new[]
    {
        property.AddressLine1,
        property.AddressLine2,
        property.City,
        property.State,
        property.PostalCode
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}

<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a asp-action="Dashboard" class="tenant-rail-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a asp-action="MyProperty" class="tenant-rail-link active"><i class="bi bi-house-door-fill"></i> Property</a>
            <a asp-action="MaintenanceRequest" class="tenant-rail-link"><i class="bi bi-tools"></i> Maintenance</a>
            <a asp-action="Payments" class="tenant-rail-link"><i class="bi bi-wallet2"></i> Payments</a>
            <a asp-action="Visitors" class="tenant-rail-link"><i class="bi bi-qr-code-scan"></i> Visitors</a>
            <a asp-action="Documents" class="tenant-rail-link"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
            <a asp-action="Announcements" class="tenant-rail-link"><i class="bi bi-megaphone-fill"></i> Announcements</a>
            <a asp-controller="Home" asp-action="Index" class="tenant-rail-link"><i class="bi bi-calendar-event"></i> Community Hub</a>
        </nav>
    </aside>

    <section class="tenant-workspace">
        <div class="tenant-toolbar">
            <div>
                <p class="tenant-kicker">Property Profile</p>
                <h1 class="tenant-heading">Assigned Property</h1>
                <p class="tenant-sub">Complete property profile with lease terms, contact details, and tenancy rules.</p>
            </div>
            <span class="tenant-badge badge-success">@Model.LeaseStatus Lease</span>
        </div>

        <div class="tenant-hero">
            <div>
                <h2>@property.PropertyName</h2>
                <p>@fullAddress</p>
            </div>
            <div>
                <p class="mb-1">Monthly Rent: <strong>@Model.MonthlyRent.ToString("C")</strong></p>
                <p class="mb-0">Payment Due: <strong>@Model.RentDueDay day of month</strong></p>
            </div>
        </div>

        <div class="tenant-grid-4">
            <div class="tenant-stat"><div class="tenant-stat-label">Floor</div><div class="tenant-stat-value">@(string.IsNullOrWhiteSpace(property.FloorNumber) ? "-" : property.FloorNumber)</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Unit Size</div><div class="tenant-stat-value">@(property.SizeSqFt.HasValue ? $"{property.SizeSqFt.Value:0} sqft" : "-")</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Bedrooms</div><div class="tenant-stat-value">@property.Bedrooms</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Bathrooms</div><div class="tenant-stat-value">@property.Bathrooms</div></div>
        </div>

        <div class="tenant-layout-2">
            <article class="tenant-panel">
                <div class="tenant-panel-head"><h3 class="tenant-panel-title">Lease Details</h3></div>
                <div class="tenant-panel-body">
                    <div class="tenant-list">
                        <div class="tenant-list-item"><span class="tenant-sub">Start Date</span><strong>@Model.LeaseStartDate.ToString("dd MMMM yyyy")</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">End Date</span><strong>@Model.LeaseEndDate.ToString("dd MMMM yyyy")</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Duration</span><strong>@Math.Max(1, ((Model.LeaseEndDate.Year - Model.LeaseStartDate.Year) * 12) + Model.LeaseEndDate.Month - Model.LeaseStartDate.Month) months</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Security Deposit</span><strong>@Model.DepositPaid.ToString("C")</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Deposit Status</span><span class="tenant-badge @(Model.DepositStatus == DepositStatus.Paid ? "badge-success" : "badge-warning")">@Model.DepositStatus</span></div>
                    </div>
                </div>
            </article>

            <article class="tenant-panel">
                <div class="tenant-panel-head"><h3 class="tenant-panel-title">Property Details</h3></div>
                <div class="tenant-panel-body">
                    <div class="tenant-list">
                        <div class="tenant-list-item"><span class="tenant-sub">Property Type</span><strong>@property.PropertyType</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Unit Number</span><strong>@(string.IsNullOrWhiteSpace(property.UnitNumber) ? "-" : property.UnitNumber)</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Parking Bay</span><strong>@(string.IsNullOrWhiteSpace(property.ParkingBay) ? "-" : property.ParkingBay)</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Tenant Email</span><strong>@Model.TenantEmail</strong></div>
                    </div>
                </div>
            </article>
        </div>

        <div class="tenant-layout-2">
            <article class="tenant-panel">
                <div class="tenant-panel-head"><h3 class="tenant-panel-title">Utilities & Amenities</h3></div>
                <div class="tenant-panel-body">
                    <div class="tenant-list">
                        @if (Model.Amenities.Count == 0)
                        {
                            <div class="tenant-list-item"><span class="tenant-sub">Amenities</span><strong>None listed</strong></div>
                        }
                        else
                        {
                            @foreach (var amenity in Model.Amenities)
                            {
                                <div class="tenant-list-item">
                                    <span class="tenant-sub">@amenity.AmenityName</span>
                                    <span class="tenant-badge badge-success">Available</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </article>

            <article class="tenant-panel">
                <div class="tenant-panel-head"><h3 class="tenant-panel-title">House Rules</h3></div>
                <div class="tenant-panel-body">
                    <div class="tenant-list">
                        @if (!string.IsNullOrWhiteSpace(property.Description))
                        {
                            <div class="tenant-list-item"><span class="tenant-sub">Notes</span><strong>@property.Description</strong></div>
                        }
                        <div class="tenant-list-item"><span class="tenant-sub">Lease Status</span><span class="tenant-badge @(Model.LeaseStatus == LeaseStatus.Active ? "badge-success" : "badge-warning")">@Model.LeaseStatus</span></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Deposit</span><span class="tenant-badge @(Model.DepositStatus == DepositStatus.Paid ? "badge-success" : "badge-warning")">@Model.DepositStatus</span></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Created</span><strong>@property.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Last Updated</span><strong>@property.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
