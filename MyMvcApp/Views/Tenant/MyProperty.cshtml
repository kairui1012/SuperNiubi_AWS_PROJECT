@{
    ViewData["Title"] = "My Property";
}
<link rel="stylesheet" href="~/css/pages/tenant-theme.css" asp-append-version="true" />

<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a href="/Tenant/Tenant" class="tenant-rail-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a href="/Tenant/MyProperty" class="tenant-rail-link active"><i class="bi bi-house-door-fill"></i> Property</a>
            <a href="/Tenant/MaintenanceRequest" class="tenant-rail-link"><i class="bi bi-tools"></i> Maintenance</a>
            <a href="/Tenant/Payments" class="tenant-rail-link"><i class="bi bi-wallet2"></i> Payments</a>
            <a href="/Tenant/Documents" class="tenant-rail-link"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
        </nav>
    </aside>

    <section class="tenant-workspace">
        <div class="tenant-toolbar">
            <div>
                <p class="tenant-kicker">Property Profile</p>
                <h1 class="tenant-heading">Assigned Property</h1>
                <p class="tenant-sub">Complete property profile with lease terms, contact details, and tenancy rules.</p>
            </div>
            <span class="tenant-badge badge-success">Active Lease</span>
        </div>

        <div class="tenant-hero">
            <div>
                <h2>Sunrise Residences, Unit 12A</h2>
                <p>Jalan Utama 3, 83000 Batu Pahat, Johor</p>
            </div>
            <div>
                <p class="mb-1">Monthly Rent: <strong>RM 1,200</strong></p>
                <p class="mb-0">Payment Due: <strong>1st of month</strong></p>
            </div>
        </div>

        <div class="tenant-grid-4">
            <div class="tenant-stat"><div class="tenant-stat-label">Floor</div><div class="tenant-stat-value">12</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Unit Size</div><div class="tenant-stat-value">850 sqft</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Bedrooms</div><div class="tenant-stat-value">3</div></div>
            <div class="tenant-stat"><div class="tenant-stat-label">Bathrooms</div><div class="tenant-stat-value">2</div></div>
        </div>

        <div class="tenant-layout-2">
            <article class="tenant-panel">
                <div class="tenant-panel-head"><h3 class="tenant-panel-title">Lease Details</h3></div>
                <div class="tenant-panel-body">
                    <div class="tenant-list">
                        <div class="tenant-list-item"><span class="tenant-sub">Start Date</span><strong>1 January 2025</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">End Date</span><strong>31 December 2025</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Duration</span><strong>12 months</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Security Deposit</span><strong>RM 2,400</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Deposit Status</span><span class="tenant-badge badge-success">Paid</span></div>
                    </div>
                </div>
            </article>

            <article class="tenant-panel">
                <div class="tenant-panel-head"><h3 class="tenant-panel-title">Landlord Contact</h3></div>
                <div class="tenant-panel-body">
                    <div class="tenant-list">
                        <div class="tenant-list-item"><span class="tenant-sub">Name</span><strong>Mr. Ahmad Razali</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Phone</span><strong>+60 12-345 6789</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Email</span><strong>ahmad.razali@email.com</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Response Hours</span><strong>9:00 AM - 6:00 PM</strong></div>
                    </div>
                </div>
            </article>
        </div>

        <div class="tenant-layout-2">
            <article class="tenant-panel">
                <div class="tenant-panel-head"><h3 class="tenant-panel-title">Utilities & Amenities</h3></div>
                <div class="tenant-panel-body">
                    <div class="tenant-list">
                        <div class="tenant-list-item"><span class="tenant-sub">Water</span><span class="tenant-badge badge-success">Included</span></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Electricity</span><span class="tenant-badge badge-warning">Tenant Pays</span></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Internet</span><span class="tenant-badge badge-success">Included</span></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Parking</span><strong>1 Bay (B1-42)</strong></div>
                    </div>
                </div>
            </article>

            <article class="tenant-panel">
                <div class="tenant-panel-head"><h3 class="tenant-panel-title">House Rules</h3></div>
                <div class="tenant-panel-body">
                    <div class="tenant-list">
                        <div class="tenant-list-item"><span class="tenant-sub">Pets</span><span class="tenant-badge badge-danger">Not Allowed</span></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Smoking</span><span class="tenant-badge badge-danger">Not Allowed</span></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Guests</span><strong>Max 2 overnight</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Quiet Hours</span><strong>10:00 PM - 7:00 AM</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Subletting</span><span class="tenant-badge badge-danger">Not Allowed</span></div>
                    </div>
                </div>
            </article>
        </div>
    </section>
</div>
