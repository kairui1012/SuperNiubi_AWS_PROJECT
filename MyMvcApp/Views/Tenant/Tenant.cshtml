@{
	ViewData["Title"] = "My Dashboard";
	// Mock data - replace with your actual Model
	var tenantName = ViewBag.TenantEmail ?? "Sarah Johnson";
	var propertyAddress = ViewBag.PropertyAddress ?? "Unit 12A, Sunrise Residences, Jalan Utama 3";
	var leaseEnd = ViewBag.LeaseEnd ?? "31 Dec 2025";
	var pendingMaintenance = ViewBag.PendingMaintenance ?? 2;
	var totalPayments = ViewBag.TotalPayments ?? 5;
	var pendingDocuments = ViewBag.PendingDocuments ?? 1;
}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
	:root {
		--bg-deep: #14110F;
		--bg-card: #1E1B18;
		--bg-elevated: #2A2723;
		--border: rgba(126,127,131,0.25);
		--border-hover: rgba(126,127,131,0.55);
		--text-primary: #E8D9C8;
		--text-muted: #7E7F83;
		--text-faint: #4A4A4E;
		--accent: #C8965A;
		--accent-glow: rgba(200,150,90,0.18);
		--accent-dim: rgba(200,150,90,0.08);
		--green: #6BBF8E;
		--green-dim: rgba(107,191,142,0.12);
		--red: #D97B6C;
		--red-dim: rgba(217,123,108,0.12);
		--blue: #7AA8C7;
		--blue-dim: rgba(122,168,199,0.12);
		--yellow: #D4AC5A;
		--yellow-dim: rgba(212,172,90,0.12);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		background-color: var(--bg-deep);
		color: var(--text-primary);
		font-family: 'DM Sans', sans-serif;
		font-weight: 400;
		line-height: 1.6;
		min-height: 100vh;
	}

		/*  Ambient background  */
		body::before {
			content: '';
			position: fixed;
			top: -20%;
			right: -10%;
			width: 600px;
			height: 600px;
			background: radial-gradient(circle, rgba(200,150,90,0.07) 0%, transparent 65%);
			pointer-events: none;
			z-index: 0;
		}

	.tenant-wrap {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem;
		position: relative;
		z-index: 1;
	}

	/*  Page header  */
	.page-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 2.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border);
		flex-wrap: wrap;
		gap: 1rem;
	}

	.page-header-left .greeting {
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
		font-family: 'DM Sans', sans-serif;
		font-weight: 500;
		margin-bottom: 0.35rem;
	}

	.page-header-left h1 {
		font-family: 'Syne', sans-serif;
		font-weight: 800;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		color: var(--text-primary);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}

		.page-header-left h1 span {
			color: var(--accent);
		}

	.header-date {
		margin-left: auto;
		font-size: 0.8rem;
		color: var(--text-muted);
		font-weight: 300;
		text-align: right;
	}

		.header-date strong {
			display: block;
			font-size: 1rem;
			font-weight: 500;
			color: var(--text-primary);
		}

	/*  Property banner  */
	.property-banner {
		background: linear-gradient(135deg, var(--bg-elevated) 0%, #2F2B25 100%);
		border: 1px solid var(--border);
		border-left: 3px solid var(--accent);
		border-radius: 10px;
		padding: 1.5rem 2rem;
		margin-bottom: 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		position: relative;
		overflow: hidden;
	}

		.property-banner::after {
			position: absolute;
			right: 1.5rem;
			top: 50%;
			transform: translateY(-50%);
			font-size: 3rem;
			opacity: 0.08;
		}

	.property-banner-info .label {
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 0.3rem;
	}

	.property-banner-info .address {
		font-family: 'Syne', sans-serif;
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--text-primary);
	}

	.property-banner-meta {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.meta-item .meta-label {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-muted);
		margin-bottom: 0.2rem;
	}

	.meta-item .meta-value {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-primary);
	}

		.meta-item .meta-value.accent {
			color: var(--accent);
		}

	/*  Stat cards  */
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
		margin-bottom: 2.5rem;
	}

	.stat-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.4rem 1.6rem;
		cursor: pointer;
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		transition: border-color 0.2s, transform 0.2s, background 0.2s;
		position: relative;
		overflow: hidden;
	}

		.stat-card:hover {
			border-color: var(--border-hover);
			background: var(--bg-elevated);
			transform: translateY(-2px);
			color: inherit;
			text-decoration: none;
		}

		.stat-card::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 2px;
			border-radius: 10px 10px 0 0;
			opacity: 0;
			transition: opacity 0.2s;
		}

		.stat-card:hover::before {
			opacity: 1;
		}

		.stat-card.c-orange::before {
			background: var(--accent);
		}

		.stat-card.c-green::before {
			background: var(--green);
		}

		.stat-card.c-blue::before {
			background: var(--blue);
		}

		.stat-card.c-yellow::before {
			background: var(--yellow);
		}

	.stat-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.stat-icon {
		width: 38px;
		height: 38px;
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.1rem;
	}

	.c-orange .stat-icon {
		background: var(--accent-dim);
	}

	.c-green .stat-icon {
		background: var(--green-dim);
	}

	.c-blue .stat-icon {
		background: var(--blue-dim);
	}

	.c-yellow .stat-icon {
		background: var(--yellow-dim);
	}

	.stat-badge {
		font-size: 0.65rem;
		padding: 0.2rem 0.55rem;
		border-radius: 20px;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.badge-warn {
		background: var(--yellow-dim);
		color: var(--yellow);
	}

	.badge-ok {
		background: var(--green-dim);
		color: var(--green);
	}

	.badge-info {
		background: var(--blue-dim);
		color: var(--blue);
	}

	.badge-alert {
		background: var(--red-dim);
		color: var(--red);
	}

	.stat-number {
		font-family: 'Syne', sans-serif;
		font-weight: 700;
		font-size: 2.2rem;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.c-orange .stat-number {
		color: var(--accent);
	}

	.c-green .stat-number {
		color: var(--green);
	}

	.c-blue .stat-number {
		color: var(--blue);
	}

	.c-yellow .stat-number {
		color: var(--yellow);
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--text-muted);
		font-weight: 400;
		margin-top: 0.1rem;
	}

	.stat-link {
		font-size: 0.75rem;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		gap: 0.3rem;
		transition: color 0.2s;
	}

	.stat-card:hover .stat-link {
		color: var(--text-primary);
	}

	/*  Main content grid  */
	.content-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	@@media (max-width: 768px) {
		.content-grid {
			grid-template-columns: 1fr;
		}
	}

	/*  Section cards  */
	.section-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow: hidden;
	}

		.section-card.full-width {
			grid-column: 1 / -1;
		}

	.section-header {
		padding: 1.2rem 1.5rem;
		border-bottom: 1px solid var(--border);
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.section-title {
		font-family: 'Syne', sans-serif;
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.01em;
		color: var(--text-primary);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

		.section-title .dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
		}

	.c-orange .dot, .dot-orange {
		background: var(--accent);
	}

	.c-green .dot, .dot-green {
		background: var(--green);
	}

	.c-blue .dot, .dot-blue {
		background: var(--blue);
	}

	.section-action {
		font-size: 0.75rem;
		color: var(--accent);
		text-decoration: none;
		font-weight: 500;
		transition: opacity 0.2s;
	}

		.section-action:hover {
			opacity: 0.75;
			color: var(--accent);
			text-decoration: none;
		}

	.section-body {
		padding: 1.2rem 1.5rem;
	}

	/*  Request list items  */
	.request-item {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--border);
	}

		.request-item:last-child {
			border-bottom: none;
			padding-bottom: 0;
		}

		.request-item:first-child {
			padding-top: 0;
		}

	.request-icon {
		width: 34px;
		height: 34px;
		flex-shrink: 0;
		border-radius: 7px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.9rem;
		margin-top: 0.1rem;
	}

	.ri-maint {
		background: var(--yellow-dim);
	}

	.ri-pay {
		background: var(--green-dim);
	}

	.ri-doc {
		background: var(--blue-dim);
	}

	.request-info {
		flex: 1;
		min-width: 0;
	}

	.request-title {
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--text-primary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.request-sub {
		font-size: 0.75rem;
		color: var(--text-muted);
		margin-top: 0.15rem;
	}

	.status-pill {
		font-size: 0.65rem;
		padding: 0.2rem 0.6rem;
		border-radius: 20px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		white-space: nowrap;
		flex-shrink: 0;
		margin-top: 0.1rem;
	}

	.sp-pending {
		background: var(--yellow-dim);
		color: var(--yellow);
	}

	.sp-approved {
		background: var(--blue-dim);
		color: var(--blue);
	}

	.sp-completed {
		background: var(--green-dim);
		color: var(--green);
	}

	/*  Quick Actions  */
	.quick-actions {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.8rem;
	}

	.qa-btn {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1rem;
		text-decoration: none;
		color: var(--text-primary);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		text-align: center;
		transition: border-color 0.2s, background 0.2s, transform 0.18s;
		cursor: pointer;
	}

		.qa-btn:hover {
			border-color: var(--accent);
			background: var(--accent-dim);
			transform: translateY(-1px);
			color: var(--text-primary);
			text-decoration: none;
		}

		.qa-btn .qa-icon {
			width: 36px;
			height: 36px;
			background: var(--accent-dim);
			border-radius: 8px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1rem;
		}

		.qa-btn span {
			font-size: 0.78rem;
			font-weight: 500;
			color: var(--text-muted);
			transition: color 0.2s;
		}

		.qa-btn:hover span {
			color: var(--text-primary);
		}

	/*  Lease timeline  */
	.lease-bar-wrap {
		margin-top: 0.8rem;
	}

	.lease-bar-labels {
		display: flex;
		justify-content: space-between;
		font-size: 0.72rem;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.lease-bar-track {
		height: 6px;
		background: var(--bg-elevated);
		border-radius: 3px;
		overflow: hidden;
		border: 1px solid var(--border);
	}

	.lease-bar-fill {
		height: 100%;
		background: linear-gradient(90deg, var(--accent) 0%, var(--yellow) 100%);
		border-radius: 3px;
		transition: width 1s ease;
	}

	.lease-bar-sub {
		font-size: 0.73rem;
		color: var(--text-muted);
		margin-top: 0.5rem;
		text-align: right;
	}

	/* Empty state  */
	.empty-state {
		text-align: center;
		padding: 2rem 1rem;
		color: var(--text-muted);
		font-size: 0.82rem;
	}

		.empty-state .empty-icon {
			font-size: 1.8rem;
			margin-bottom: 0.6rem;
			opacity: 0.4;
		}

	/*  Fade in animation  */
	@@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(12px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.tenant-wrap > * {
		animation: fadeUp 0.45s ease both;
	}

	.page-header {
		animation-delay: 0s;
	}

	.property-banner {
		animation-delay: 0.07s;
	}

	.stats-grid {
		animation-delay: 0.14s;
	}

	.content-grid {
		animation-delay: 0.21s;
	}
</style>

<div class="tenant-wrap">

	<!-- Header -->
	<div class="page-header">
		<div class="page-header-left">
			<div class="greeting">Tenant Portal</div>
			<h1>Good morning, <span>@tenantName.Split(' ')[0]</span></h1>
		</div>
		<div class="header-date">
			<strong id="currentDate">—</strong>
			<span id="currentTime">—</span>
		</div>
	</div>

	<!-- Property Banner -->
	<div class="property-banner">
		<div class="property-banner-info">
			<div class="label">
				<i class="bi bi-building"></i>Your Property
			</div>
			<div class="address">@propertyAddress</div>
		</div>
		<div class="property-banner-meta">
			<div class="meta-item">
				<div class="meta-label">Lease Ends</div>
				<div class="meta-value accent">@leaseEnd</div>
			</div>
			<div class="meta-item">
				<div class="meta-label">Status</div>
				<div class="meta-value" style="color:var(--green);">Active</div>
			</div>
			<div class="meta-item">
				<div class="meta-label">Tenant</div>
				<div class="meta-value">@tenantName</div>
			</div>
		</div>
	</div>

	<!-- Stat Cards -->
	<div class="stats-grid">
		<a href="/Tenant/MyProperty" class="stat-card c-orange">
			<div class="stat-card-top">
				<i class="bi bi-house-door stat-icon"></i>
				<span class="stat-badge badge-ok">Active</span>
			</div>
			<div>
				<div class="stat-number">1</div>
				<div class="stat-label">Assigned Property</div>
			</div>
			<div class="stat-link">View details <i class="bi bi-arrow-right"></i></div>
		</a>

		<a href="/Tenant/MaintenanceRequest" class="stat-card c-yellow">
			<div class="stat-card-top">
				<i class="bi bi-wrench-adjustable stat-icon"></i>
				<span class="stat-badge badge-warn">@pendingMaintenance Pending</span>
			</div>
			<div>
				<div class="stat-number">@pendingMaintenance</div>
				<div class="stat-label">Maintenance Requests</div>
			</div>
			<div class="stat-link">Manage requests </div>
		</a>

		<a href="/Tenant/Payments" class="stat-card c-green">
			<div class="stat-card-top">
				<i class="bi bi-credit-card stat-icon"></i>
				<span class="stat-badge badge-ok">Up to date</span>
			</div>
			<div>
				<div class="stat-number">@totalPayments</div>
				<div class="stat-label">Payment Records</div>
			</div>
			<div class="stat-link">View history <i class="bi bi-arrow-right"></i></div>
		</a>

		<a href="/Tenant/Documents" class="stat-card c-blue">
			<div class="stat-card-top">
				<i class="bi bi-file-earmark-text stat-icon"></i>
				<span class="stat-badge badge-info">@pendingDocuments New</span>
			</div>
			<div>
				<div class="stat-number">@pendingDocuments</div>
				<div class="stat-label">Documents</div>
			</div>
			<div class="stat-link">Manage files </div>
		</a>
	</div>

	<!-- Content Grid -->
	<div class="content-grid">

		<!-- Recent Maintenance Requests -->
		<div class="section-card">
			<div class="section-header">
				<div class="section-title">
					<span class="dot dot-orange"></span>
					Recent Requests
				</div>
				<a href="/Tenant/MaintenanceRequest" class="section-action">View All <i class="bi bi-arrow-right"></i></a>
			</div>
			<div class="section-body">
				<div class="request-item">
					<i class="bi bi-wrench-adjustable request-icon ri-maint"></i>
					<div class="request-info">
						<div class="request-title">Air conditioner not cooling</div>
						<div class="request-sub">Submitted 12 Apr 2025</div>
					</div>
					<span class="status-pill sp-pending">Pending</span>
				</div>
				<div class="request-item">
					<i class="bi bi-wrench-adjustable request-icon ri-maint"></i>
					<div class="request-info">
						<div class="request-title">Leaking pipe in bathroom</div>
						<div class="request-sub">Submitted 3 Apr 2025</div>
					</div>
					<span class="status-pill sp-approved">Approved</span>
				</div>
				<div class="request-item">
					<i class="bi bi-wrench-adjustable request-icon ri-maint"></i>
					<div class="request-info">
						<div class="request-title">Broken door lock</div>
						<div class="request-sub">Submitted 18 Mar 2025</div>
					</div>
					<span class="status-pill sp-completed">Completed</span>
				</div>
			</div>
		</div>

		<!-- Quick Actions -->
		<div class="section-card">
			<div class="section-header">
				<div class="section-title">
					<span class="dot dot-green"></span>
					Quick Actions
				</div>
			</div>
			<div class="section-body">
				<div class="quick-actions">
					<a href="/Tenant/MaintenanceRequest/Create" class="qa-btn">
						<i class="bi bi-wrench-adjustable qa-icon"></i>
						<span>New Request</span>
					</a>
					<a href="/Tenant/Payments/Upload" class="qa-btn">
						<i class="bi bi-credit-card qa-icon"></i>
						<span>Upload Payment</span>
					</a>
					<a href="/Tenant/Documents/Upload" class="qa-btn">
						<i class="bi bi-paperclip stat-icon"></i>
						<span>Upload Document</span>
					</a>
					<a href="/Tenant/MyProperty" class="qa-btn">
						<i class="bi bi-house-door qa-icon"></i>
						<span>My Property</span>
					</a>
				</div>
			</div>
		</div>

		<!-- Lease Timeline (full width) -->
		<div class="section-card full-width">
			<div class="section-header">
				<div class="section-title">
					<span class="dot dot-orange"></span>
					Lease Overview
				</div>
			</div>
			<div class="section-body">
				<div style="display:flex; justify-content:space-between; flex-wrap:wrap; gap:1.5rem;">
					<div style="flex:1; min-width:220px;">
						<div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.3rem;">Lease Start</div>
						<div style="font-size:1rem; font-weight:500;">1 Jan 2025</div>
					</div>
					<div style="flex:1; min-width:220px;">
						<div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.3rem;">Lease End</div>
						<div style="font-size:1rem; font-weight:500; color:var(--accent);">@leaseEnd</div>
					</div>
					<div style="flex:1; min-width:220px;">
						<div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.3rem;">Monthly Rent</div>
						<div style="font-size:1rem; font-weight:500; color:var(--green);">RM 1,200</div>
					</div>
				</div>
				<div class="lease-bar-wrap">
					<div class="lease-bar-labels">
						<span>Jan 2025</span>
						<span>Dec 2025</span>
					</div>
					<div class="lease-bar-track">
						<div class="lease-bar-fill" id="leaseBar" style="width:0%"></div>
					</div>
					<div class="lease-bar-sub" id="leaseBarSub">Calculating...</div>
				</div>
			</div>
		</div>

	</div>
</div>

<script>
	// Live date/time
	function updateDateTime() {
		const now = new Date();
		document.getElementById('currentDate').textContent = now.toLocaleDateString('en-MY', {
			weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
		});
		document.getElementById('currentTime').textContent = now.toLocaleTimeString('en-MY', {
			hour: '2-digit', minute: '2-digit'
		});
	}
	updateDateTime();
	setInterval(updateDateTime, 30000);

	// Lease progress bar
	window.addEventListener('load', () => {
		const start = new Date('2025-01-01');
		const end = new Date('2025-12-31');
		const now = new Date();
		const total = end - start;
		const elapsed = Math.min(Math.max(now - start, 0), total);
		const pct = Math.round((elapsed / total) * 100);
		const remaining = Math.ceil((end - now) / (1000 * 60 * 60 * 24));

		setTimeout(() => {
			document.getElementById('leaseBar').style.width = pct + '%';
			document.getElementById('leaseBarSub').textContent =
				pct + '% elapsed · ' + (remaining > 0 ? remaining + ' days remaining' : 'Lease ended');
		}, 300);
	});
</script>
