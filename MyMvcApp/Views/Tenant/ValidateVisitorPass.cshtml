@model VisitorPassValidationViewModel
@{
    ViewData["Title"] = "Validate Visitor Pass";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
    <style>
        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, #0f172a, #1d4ed8 55%, #0ea5e9);
            color: #fff;
            font-family: "Segoe UI", Tahoma, sans-serif;
        }

        .scanner-shell {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 20px;
        }

        .scanner-card {
            width: min(640px, 100%);
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 18px;
            backdrop-filter: blur(8px);
            padding: 22px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        }

        .scanner-head {
            margin-bottom: 14px;
            text-align: center;
        }

        .scanner-head h1 {
            font-size: 1.6rem;
            margin: 0;
            font-weight: 700;
        }

        .scanner-head p {
            margin: 6px 0 0;
            color: rgba(255, 255, 255, 0.9);
        }

        #qr-reader {
            width: 100%;
            border: none;
            border-radius: 12px;
            overflow: hidden;
            background: #000;
        }

        .manual-form {
            margin-top: 14px;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 10px;
        }

        .manual-form .form-control {
            min-height: 44px;
        }

        .status-note {
            margin-top: 10px;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.85);
            text-align: center;
        }

        @@media (max-width: 640px) {
            .manual-form {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="scanner-shell">
        <div class="scanner-card">
            <div class="scanner-head">
                <h1><i class="bi bi-qr-code-scan"></i> Guard QR Validation</h1>
                <p>Scan visitor QR code or enter pass code manually</p>
            </div>

            <div id="qr-reader"></div>

            <form method="get" action="/ValidateQrPass" class="manual-form">
                <input type="text"
                       id="passCode"
                       name="passCode"
                       class="form-control"
                       value="@Model.PassCode"
                       placeholder="Manual pass code, e.g. VIS-ABC12345"
                       autocomplete="off" />
                <button type="submit" class="btn btn-light">Validate</button>
            </form>

            <p class="status-note">Allow camera permission in browser to scan QR directly.</p>
        </div>
    </div>

    <div class="modal fade" id="resultModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title">Validation Result</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center px-4 py-2">
                    @if (Model.CheckedIn)
                    {
                        <div class="mb-3">
                            <div style="font-size: 3rem; color: #28a745;"><i class="bi bi-check-circle-fill"></i></div>
                        </div>
                        <h5>Visitor Checked In</h5>
                        <p class="text-muted">The visitor pass was marked as used successfully.</p>
                        @if (Model.Pass is not null)
                        {
                            <div class="text-start bg-light p-3 rounded mb-3" style="font-size: 0.9rem;">
                                <div><strong>Visitor:</strong> @Model.Pass.VisitorName</div>
                                <div><strong>Visit Date:</strong> @Model.Pass.VisitDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                                <div><strong>Status:</strong> @Model.Pass.Status</div>
                            </div>
                        }
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.PassCode))
                    {
                        if (!Model.Found)
                        {
                            <div class="mb-3">
                                <div style="font-size: 3rem; color: #dc3545;"><i class="bi bi-x-circle-fill"></i></div>
                            </div>
                            <h5>Pass Not Found</h5>
                            <p class="text-muted">Pass code <strong>@Model.PassCode</strong> is not in the system.</p>
                        }
                        else if (!Model.IsValid)
                        {
                            <div class="mb-3">
                                <div style="font-size: 3rem; color: #ffc107;"><i class="bi bi-exclamation-triangle-fill"></i></div>
                            </div>
                            <h5>Entry Denied</h5>
                            <p class="text-muted mb-3">@Model.StatusMessage</p>
                            @if (Model.Pass is not null)
                            {
                                <div class="text-start bg-light p-3 rounded" style="font-size: 0.9rem;">
                                    <div><strong>Visitor:</strong> @Model.Pass.VisitorName</div>
                                    <div><strong>Visit Date:</strong> @Model.Pass.VisitDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <div><strong>Status:</strong> @Model.Pass.Status</div>
                                </div>
                            }
                        }
                        else if (Model.Pass is not null)
                        {
                            <div class="mb-3">
                                <div style="font-size: 3rem; color: #28a745;"><i class="bi bi-check-circle-fill"></i></div>
                            </div>
                            <h5>Pass Active</h5>
                            <p class="text-muted">@Model.StatusMessage</p>
                            <div class="text-start bg-light p-3 rounded mb-3" style="font-size: 0.9rem;">
                                <div><strong>Visitor:</strong> @Model.Pass.VisitorName</div>
                                <div><strong>Visit Date:</strong> @Model.Pass.VisitDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                                <div><strong>Purpose:</strong> @Model.Pass.Purpose</div>
                            </div>
                            <form asp-action="ValidateVisitorPassAndCheckIn" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="passCode" value="@Model.PassCode" />
                                <button type="submit" class="btn btn-success w-100">Check In Visitor</button>
                            </form>
                        }
                    }
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="window.location.href='/ValidateQrPass'">Scan Another</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let scanner;
        let scanLocked = false;

        function extractPassCode(rawValue) {
            const text = (rawValue || '').trim();
            if (!text) {
                return '';
            }

            const codeFieldMatch = text.match(/(?:^|\|)\s*Code\s*:\s*([^|]+)/i);
            if (codeFieldMatch && codeFieldMatch[1]) {
                return codeFieldMatch[1].trim().toUpperCase();
            }

            const tokenMatch = text.match(/VIS-[A-Z0-9]+/i);
            if (tokenMatch && tokenMatch[0]) {
                return tokenMatch[0].toUpperCase();
            }

            return text.toUpperCase();
        }

        function onScanSuccess(decodedText) {
            if (scanLocked) {
                return;
            }

            scanLocked = true;
            const code = extractPassCode(decodedText);
            if (!code) {
                scanLocked = false;
                return;
            }

            window.location.href = `/ValidateQrPass?passCode=${encodeURIComponent(code)}`;
        }

        function onScanFailure() {
        }

        async function initScanner() {
            try {
                scanner = new Html5Qrcode("qr-reader");
                await scanner.start(
                    { facingMode: "environment" },
                    {
                        fps: 10,
                        qrbox: { width: 260, height: 260 }
                    },
                    onScanSuccess,
                    onScanFailure
                );
            } catch {
                const note = document.querySelector('.status-note');
                if (note) {
                    note.textContent = "Unable to start camera. Check browser permission and HTTPS/localhost usage.";
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initScanner();

            const hasResult = '@(!string.IsNullOrWhiteSpace(Model.PassCode))'.toLowerCase() === 'true';
            if (hasResult) {
                const resultModal = new bootstrap.Modal(document.getElementById('resultModal'));
                resultModal.show();
            }
        });

        window.addEventListener('beforeunload', async () => {
            if (scanner) {
                try {
                    await scanner.stop();
                    await scanner.clear();
                } catch {
                }
            }
        });
    </script>
</body>
</html>
