@model TenantDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    var tenantName = Model.TenantEmail;
    var propertyAddress = Model.PropertyAddress ?? "Unit 12A, Sunrise Residences, Jalan Utama 3";
    var leaseStart = Model.LeaseStartDate.ToString("dd MMM yyyy");
    var leaseEnd = Model.LeaseEndDate.ToString("dd MMM yyyy");
    var totalPayments = Model.PaymentRecord;
    var documentCount = Model.DocumentQuantity;
}

<link rel="stylesheet" href="~/css/pages/tenant-theme.css" asp-append-version="true" />


<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a asp-action="Dashboard" class="tenant-rail-link active"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a asp-action="MyProperty" class="tenant-rail-link"><i class="bi bi-house-door-fill"></i> Property</a>
            <a asp-action="MaintenanceRequest" class="tenant-rail-link"><i class="bi bi-tools"></i> Maintenance</a>
            <a asp-action="Payments" class="tenant-rail-link"><i class="bi bi-wallet2"></i> Payments</a>
            <a asp-action="Visitors" class="tenant-rail-link"><i class="bi bi-qr-code-scan"></i> Visitors</a>
            <a asp-action="Documents" class="tenant-rail-link"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
            <a asp-action="Announcements" class="tenant-rail-link"><i class="bi bi-megaphone-fill"></i> Announcements</a>
            <a asp-controller="Home" asp-action="Index" class="tenant-rail-link"><i class="bi bi-calendar-event"></i> Community Hub</a>
        </nav>
    </aside>

    <section class="tenant-workspace tenant-dashboard-simple">
        <div class="tenant-dashboard-header">
            <div>
                <p class="tenant-kicker">Tenant Dashboard</p>
                <h1 class="tenant-heading">@tenantName.Split('@')[0]</h1>
                <p class="tenant-sub">@propertyAddress</p>
            </div>
            <div class="tenant-time">
                <strong id="currentDate"></strong>
                <span id="currentTime"></span>
            </div>
        </div>

        <section class="tenant-overview-panel">
            <div class="tenant-overview-top">
                <div>
                    <div class="tenant-overview-label">Lease period</div>
                    <div class="tenant-overview-title">@leaseStart - @leaseEnd</div>
                </div>
                <span class="tenant-badge badge-success">@Model.LeaseStatus</span>
            </div>

            <div class="tenant-lease-track" role="progressbar" aria-label="Lease timeline">
                <div id="leaseBar" class="tenant-lease-fill" style="width:0%"></div>
            </div>
            <div id="leaseBarSub" class="tenant-sub mt-2">Calculating lease timeline...</div>

            <div class="tenant-overview-metrics">
                <div>
                    <span>Current Rent</span>
                    <strong>RM @Model.MonthlyRent.ToString("N2")</strong>
                </div>
                <div>
                    <span>Next Payment Due</span>
                    <strong>@Model.NextPaymentDue.ToLocalTime().ToString("dd MMM yyyy")</strong>
                </div>
                <div>
                    <span>Maintenance Status</span>
                    <strong>@Model.MaintenanceStatusSummary</strong>
                </div>
                <div>
                    <span>Payments</span>
                    <strong>@totalPayments</strong>
                </div>
                <div>
                    <span>Documents</span>
                    <strong>@documentCount</strong>
                </div>
            </div>
        </section>

        <div class="tenant-layout-2">
            <article class="tenant-panel">
                <div class="tenant-panel-head">
                    <h3 class="tenant-panel-title">Payment Trend (6 Months)</h3>
                </div>
                <div class="tenant-panel-body">
                    <div class="tenant-chart-wrap">
                        <canvas id="tenantPaymentTrendChart" aria-label="Tenant payment trend chart"></canvas>
                    </div>
                </div>
            </article>

            <article class="tenant-panel">
                <div class="tenant-panel-head">
                    <h3 class="tenant-panel-title">Maintenance Split</h3>
                </div>
                <div class="tenant-panel-body">
                    <div class="tenant-chart-wrap tenant-chart-wrap-sm">
                        <canvas id="tenantMaintenanceStatusChart" aria-label="Tenant maintenance status chart"></canvas>
                    </div>
                </div>
            </article>
        </div>

        <div class="tenant-dashboard-content">
            <article class="tenant-overview-panel">
                <div class="tenant-section-head">
                    <h2>Recent Maintenance</h2>
                    <a asp-action="MaintenanceRequest" class="tenant-link">View all</a>
                </div>

                @if (Model.MaintenanceRequest.Count <= 0)
                {
                    <div class="tenant-empty compact">No recent maintenance requests.</div>
                }
                else
                {
                    <div class="tenant-plain-list">
                        @foreach (var request in Model.MaintenanceRequest.Take(5))
                        {
                            var statusClass = request.Status.ToString() == "Completed" ? "badge-success" : "badge-warning";
                            <div class="tenant-plain-row">
                                <div>
                                    <strong>@request.Title</strong>
                                    <span>Submitted @request.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                                <span class="tenant-badge @statusClass">@request.Status</span>
                            </div>
                        }
                    </div>
                }
            </article>

            <article class="tenant-overview-panel">
                <div class="tenant-section-head">
                    <h2>Notifications</h2>
                </div>

                @if (Model.Notifications.Count == 0)
                {
                    <div class="tenant-empty compact">No alerts right now.</div>
                }
                else
                {
                    <div class="tenant-notification-list">
                        @foreach (var item in Model.Notifications)
                        {
                            <div class="tenant-notification-item">
                                <p class="tenant-kicker mb-1">@item.Category</p>
                                <strong>@item.Title</strong>
                                <p class="tenant-sub mt-1">@item.Message</p>
                                <div class="d-flex justify-content-between align-items-center mt-2 gap-2">
                                    <span class="tenant-sub">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                                    @if (!string.IsNullOrWhiteSpace(item.ActionUrl) && !string.IsNullOrWhiteSpace(item.ActionText))
                                    {
                                        <a class="tenant-link" href="@item.ActionUrl">@item.ActionText</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </article>
        </div>
    </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
    function updateDateTime() {
        const now = new Date();
        document.getElementById('currentDate').textContent = now.toLocaleDateString('en-MY', {
            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
        });
        document.getElementById('currentTime').textContent = now.toLocaleTimeString('en-MY', {
            hour: '2-digit', minute: '2-digit'
        });
    }

    updateDateTime();
    setInterval(updateDateTime, 30000);

    window.addEventListener('load', () => {
        const start = new Date('@Model.LeaseStartDate.ToString("yyyy-MM-dd")T00:00:00');
        const end = new Date('@Model.LeaseEndDate.ToString("yyyy-MM-dd")T23:59:59');
        const now = new Date();
        const total = end.getTime() - start.getTime();
        const elapsed = Math.min(Math.max(now.getTime() - start.getTime(), 0), total);
        const pct = total > 0 ? Math.round((elapsed / total) * 100) : 0;
        const remaining = Math.ceil((end.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));

        document.getElementById('leaseBar').style.width = pct + '%';
        document.getElementById('leaseBarSub').textContent =
            pct + '% elapsed | ' + (remaining > 0 ? remaining + ' days remaining' : 'Lease ended');

        const paymentLabels = @Json.Serialize(Model.PaymentChartLabels);
        const paymentAmounts = @Json.Serialize(Model.PaymentChartAmounts);
        const maintenanceCounts = @Json.Serialize(Model.MaintenanceStatusCounts);

        const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
        const gridColor = isDark ? 'rgba(148, 163, 184, 0.14)' : 'rgba(148, 163, 184, 0.24)';
        const tickColor = isDark ? '#94a3b8' : '#64748b';
        const borderColor = isDark ? '#1e293b' : '#ffffff';

        const paymentCanvas = document.getElementById('tenantPaymentTrendChart');
        if (paymentCanvas && window.Chart) {
            new Chart(paymentCanvas, {
                type: 'line',
                data: {
                    labels: paymentLabels,
                    datasets: [{
                        label: 'Verified rent',
                        data: paymentAmounts,
                        borderColor: '#2563eb',
                        backgroundColor: 'rgba(37, 99, 235, 0.15)',
                        pointBackgroundColor: '#1d4ed8',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: gridColor },
                            ticks: {
                                color: tickColor,
                                callback: (value) => `RM ${Number(value).toLocaleString()}`
                            }
                        },
                        x: {
                            grid: { color: gridColor },
                            ticks: { color: tickColor }
                        }
                    }
                }
            });
        }

        const maintenanceCanvas = document.getElementById('tenantMaintenanceStatusChart');
        if (maintenanceCanvas && window.Chart) {
            const hasData = maintenanceCounts.some((value) => Number(value) > 0);
            new Chart(maintenanceCanvas, {
                type: 'doughnut',
                data: {
                    labels: hasData
                        ? ['Pending', 'Approved', 'In Progress', 'Completed', 'Rejected']
                        : ['No data'],
                    datasets: [{
                        data: hasData ? maintenanceCounts : [1],
                        backgroundColor: hasData
                            ? ['#f59e0b', '#0ea5e9', '#2563eb', '#10b981', '#ef4444']
                            : ['#cbd5e1'],
                        borderColor: borderColor,
                        borderWidth: 3,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: tickColor, boxWidth: 12, padding: 12 }
                        }
                    }
                }
            });
        }
    });
</script>
