@model TenantDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    var tenantName = Model.TenantEmail;
    var propertyAddress = Model.PropertyAddress ?? "Unit 12A, Sunrise Residences, Jalan Utama 3";
    var leaseStart = Model.LeaseStartDate.ToString("dd MMM yyyy");
    var leaseEnd = Model.LeaseEndDate.ToString("dd MMM yyyy");
    var pendingMaintenance = Model.MaintenanceRequest.Count;
    var totalPayments = Model.PaymentRecord;
    var pendingDocuments = Model.DocumentQuantity;
}

<link rel="stylesheet" href="~/css/pages/tenant-theme.css" asp-append-version="true" />

<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a asp-action="TenantDashboard" class="tenant-rail-link active"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a asp-action="MyProperty" class="tenant-rail-link"><i class="bi bi-house-door-fill"></i> Property</a>
            <a asp-action="MaintenanceRequest" class="tenant-rail-link"><i class="bi bi-tools"></i> Maintenance</a>
            <a asp-action="Payments" class="tenant-rail-link"><i class="bi bi-wallet2"></i> Payments</a>
            <a asp-action="Visitors" class="tenant-rail-link"><i class="bi bi-qr-code-scan"></i> Visitors</a>
            <a asp-action="Documents" class="tenant-rail-link"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
        </nav>
    </aside>

    <section class="tenant-workspace">
        <div class="tenant-toolbar">
            <div>
                <p class="tenant-kicker">Tenant Workspace</p>
                <h1 class="tenant-heading">Welcome, @tenantName.Split('@')[0]</h1>
                <p class="tenant-sub">Centralized command center for property, maintenance, payment, and document workflows.</p>
            </div>
            <div class="tenant-time">
                <strong id="currentDate"></strong>
                <span id="currentTime"></span>
            </div>
        </div>

        <div class="tenant-hero">
            <div>
                <h2>@propertyAddress</h2>
                <p>Lease Window: @leaseStart to @leaseEnd</p>
            </div>
            <div>
                <span class="tenant-badge badge-success">@Model.LeaseStatus</span>
            </div>
        </div>

        <div class="tenant-grid-4">
            <div class="tenant-stat">
                <div class="tenant-stat-label">Assigned Property</div>
                <div class="tenant-stat-value">1</div>
                <span class="tenant-badge badge-success">Active</span>
            </div>
            <div class="tenant-stat">
                <div class="tenant-stat-label">Maintenance Requests</div>
                <div class="tenant-stat-value">@pendingMaintenance</div>
                <span class="tenant-badge badge-warning">Open Items</span>
            </div>
            <div class="tenant-stat">
                <div class="tenant-stat-label">Payment Records</div>
                <div class="tenant-stat-value">@totalPayments</div>
                <span class="tenant-badge badge-primary">Logged</span>
            </div>
            <div class="tenant-stat">
                <div class="tenant-stat-label">Document Library</div>
                <div class="tenant-stat-value">@pendingDocuments</div>
                <span class="tenant-badge badge-primary">Stored</span>
            </div>
            <div class="tenant-stat">
                <div class="tenant-stat-label">Visitor Passes</div>
                <div class="tenant-stat-value">@Model.VisitorPassCount</div>
                <span class="tenant-badge badge-primary">Generated</span>
            </div>
        </div>

        <div class="tenant-layout-2">
            <article class="tenant-panel">
                <div class="tenant-panel-head">
                    <h3 class="tenant-panel-title">Recent Maintenance Timeline</h3>
                    <a asp-action="MaintenanceRequest" class="tenant-link">Open Queue</a>
                </div>
                <div class="tenant-panel-body">
                    @if (Model.MaintenanceRequest.Count <= 0)
                    {
                        <div class="tenant-empty"><i class="bi bi-inbox d-block mb-2"></i>No recent maintenance requests.</div>
                    }
                    else
                    {
                        <div class="tenant-list">
                            @foreach (var request in Model.MaintenanceRequest.Take(5))
                            {
                                var statusClass = request.Status.ToString() == "Completed" ? "badge-success" : "badge-warning";
                                <div class="tenant-list-item">
                                    <div>
                                        <div class="fw-semibold">@request.Title</div>
                                        <div class="tenant-sub">Submitted @request.CreatedAt.ToString("dd MMM yyyy")</div>
                                    </div>
                                    <span class="tenant-badge @statusClass">@request.Status</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </article>

            <article class="tenant-panel">
                <div class="tenant-panel-head">
                    <h3 class="tenant-panel-title">Quick Actions</h3>
                </div>
                <div class="tenant-panel-body">
                    <div class="tenant-actions mb-3">
                        <a asp-action="MyProperty" class="btn tenant-btn tenant-btn-outline">View Property</a>
                        <a asp-action="MaintenanceRequest" class="btn tenant-btn tenant-btn-outline">Create Request</a>
                        <a asp-action="Payments" class="btn tenant-btn tenant-btn-outline">Make Payment</a>
                        <a asp-action="Visitors" class="btn tenant-btn tenant-btn-outline">Register Visitor</a>
                        <a asp-action="Documents" class="btn tenant-btn tenant-btn-outline">Upload Document</a>
                    </div>
                    <div class="tenant-list">
                        <div class="tenant-list-item"><span class="tenant-sub">Lease Start</span><strong>@leaseStart</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Lease End</span><strong>@leaseEnd</strong></div>
                        <div class="tenant-list-item"><span class="tenant-sub">Monthly Rent</span><strong>RM @Model.MonthlyRent</strong></div>
                    </div>
                    <div class="progress mt-3" role="progressbar">
                        <div id="leaseBar" class="progress-bar bg-primary" style="width:0%"></div>
                    </div>
                    <div id="leaseBarSub" class="tenant-sub mt-2">Calculating lease timeline...</div>
                </div>
            </article>
        </div>
    </section>
</div>

<script>
    function updateDateTime() {
        const now = new Date();
        document.getElementById('currentDate').textContent = now.toLocaleDateString('en-MY', {
            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
        });
        document.getElementById('currentTime').textContent = now.toLocaleTimeString('en-MY', {
            hour: '2-digit', minute: '2-digit'
        });
    }

    updateDateTime();
    setInterval(updateDateTime, 30000);

    window.addEventListener('load', () => {
        const start = new Date('@Model.LeaseStartDate');
        const end = new Date('@Model.LeaseEndDate');
        const now = new Date();
        const total = end - start;
        const elapsed = Math.min(Math.max(now - start, 0), total);
        const pct = total > 0 ? Math.round((elapsed / total) * 100) : 0;
        const remaining = Math.ceil((end - now) / (1000 * 60 * 60 * 24));

        document.getElementById('leaseBar').style.width = pct + '%';
        document.getElementById('leaseBarSub').textContent =
            pct + '% elapsed | ' + (remaining > 0 ? remaining + ' days remaining' : 'Lease ended');
    });
</script>
