@{
    ViewData["Title"] = "Documents";
}
<link rel="stylesheet" href="~/css/pages/tenant-theme.css" asp-append-version="true" />

<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a href="/Tenant/Tenant" class="tenant-rail-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a href="/Tenant/MyProperty" class="tenant-rail-link"><i class="bi bi-house-door-fill"></i> Property</a>
            <a href="/Tenant/MaintenanceRequest" class="tenant-rail-link"><i class="bi bi-tools"></i> Maintenance</a>
            <a href="/Tenant/Payments" class="tenant-rail-link"><i class="bi bi-wallet2"></i> Payments</a>
            <a href="/Tenant/Documents" class="tenant-rail-link active"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
        </nav>
    </aside>

    <section class="tenant-workspace">
        <div class="tenant-toolbar">
            <div>
                <p class="tenant-kicker">Document Vault</p>
                <h1 class="tenant-heading">Tenant Documents</h1>
                <p class="tenant-sub">Store agreements, identity files, and receipts securely in your S3-backed library.</p>
            </div>
            <button class="btn tenant-btn tenant-btn-primary" onclick="toggleForm()">+ Upload Document</button>
        </div>

        <div class="tenant-panel" id="uploadForm" style="display:none;">
            <div class="tenant-panel-head"><h3 class="tenant-panel-title">Upload New Document</h3></div>
            <div class="tenant-panel-body tenant-form">
                <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="tenant-form-grid">
                        <div>
                            <label>Document Name</label>
                            <input class="form-control" type="text" name="DocumentName" placeholder="e.g. Tenancy Agreement 2025" required />
                        </div>
                        <div>
                            <label>Document Type</label>
                            <select class="form-select" name="DocumentType" required>
                                <option value="" disabled selected>Select type</option>
                                <option>Tenancy Agreement</option>
                                <option>Identity Card</option>
                                <option>Payment Receipt</option>
                                <option>Inspection Report</option>
                                <option>Others</option>
                            </select>
                        </div>
                        <div class="full">
                            <label>Notes (optional)</label>
                            <textarea class="form-control" name="Notes" placeholder="Any notes about this document..."></textarea>
                        </div>
                        <div class="full">
                            <label>File</label>
                            <div class="drop-zone" id="dropZone">
                                <input type="file" id="docFile" name="File" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                                <div class="dz-content">
                                    <div class="fs-3"><i class="bi bi-cloud-arrow-up"></i></div>
                                    <div class="tenant-sub"><strong>Click to upload</strong> or drag and drop</div>
                                    <div class="tenant-sub">PDF, JPG, PNG, DOCX - max 10MB</div>
                                </div>
                                <div id="dz-file" class="fs-4 mt-2" style="display:none;"><i class="bi bi-file-earmark-text"></i></div>
                                <div class="tenant-sub mt-2" id="fileNameDisplay"></div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn tenant-btn tenant-btn-outline" onclick="toggleForm()">Cancel</button>
                        <button type="submit" class="btn tenant-btn tenant-btn-primary">Upload to S3</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="tenant-panel">
            <div class="tenant-panel-head">
                <h3 class="tenant-panel-title">Document Library</h3>
                <div style="max-width:240px;">
                    <input class="form-control" type="text" placeholder="Search documents..." oninput="searchDocs(this.value)" />
                </div>
            </div>
            <div class="tenant-panel-body">
                <div class="doc-grid" id="docsGrid">
                    <div class="doc-card doc-item" data-name="tenancy agreement 2025">
                        <div class="fw-semibold">Tenancy Agreement 2025.pdf</div>
                        <div class="tenant-sub small mb-2">Uploaded 1 Jan 2025 - 2.4 MB</div>
                        <span class="tenant-badge badge-primary mb-2">Tenancy Agreement</span>
                        <div class="d-flex gap-2">
                            <a href="#" class="btn tenant-btn tenant-btn-outline btn-sm">View</a>
                            <a href="#" class="btn tenant-btn tenant-btn-outline btn-sm">Download</a>
                        </div>
                    </div>
                    <div class="doc-card doc-item" data-name="identity card mykad">
                        <div class="fw-semibold">MyKad_Scan.jpg</div>
                        <div class="tenant-sub small mb-2">Uploaded 2 Jan 2025 - 0.8 MB</div>
                        <span class="tenant-badge badge-primary mb-2">Identity Card</span>
                        <div class="d-flex gap-2">
                            <a href="#" class="btn tenant-btn tenant-btn-outline btn-sm">View</a>
                            <a href="#" class="btn tenant-btn tenant-btn-outline btn-sm">Download</a>
                        </div>
                    </div>
                    <div class="doc-card doc-item" data-name="inspection report january">
                        <div class="fw-semibold">Inspection_Report_Jan2025.pdf</div>
                        <div class="tenant-sub small mb-2">Uploaded 5 Jan 2025 - 1.2 MB</div>
                        <span class="tenant-badge badge-primary mb-2">Inspection Report</span>
                        <div class="d-flex gap-2">
                            <a href="#" class="btn tenant-btn tenant-btn-outline btn-sm">View</a>
                            <a href="#" class="btn tenant-btn tenant-btn-outline btn-sm">Download</a>
                        </div>
                    </div>
                    <div class="doc-card doc-item" data-name="payment receipt march">
                        <div class="fw-semibold">Receipt_March2025.png</div>
                        <div class="tenant-sub small mb-2">Uploaded 2 Mar 2025 - 0.5 MB</div>
                        <span class="tenant-badge badge-primary mb-2">Payment Receipt</span>
                        <div class="d-flex gap-2">
                            <a href="#" class="btn tenant-btn tenant-btn-outline btn-sm">View</a>
                            <a href="#" class="btn tenant-btn tenant-btn-outline btn-sm">Download</a>
                        </div>
                    </div>
                </div>
                <div class="tenant-sub mt-3">All files are securely stored in AWS S3 and transmitted over HTTPS.</div>
            </div>
        </div>
    </section>
</div>

<script>
    function toggleForm() {
        const form = document.getElementById('uploadForm');
        form.classList.toggle('console-open');
        if (form.classList.contains('console-open')) {
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    const fileInput = document.getElementById('docFile');
    const fileNameDisplay = document.getElementById('fileNameDisplay');
    const dropZone = document.getElementById('dropZone');

    fileInput.addEventListener('change', function () {
        const icon = document.getElementById('dz-file');
        const content = document.getElementsByClassName('dz-content')[0];

        if (this.files.length > 0) {
            icon.style.display = 'block';
            content.style.display = 'none';
            fileNameDisplay.textContent = this.files[0].name;
        } else {
            icon.style.display = 'none';
            content.style.display = 'block';
            fileNameDisplay.textContent = '';
        }
    });

    dropZone.addEventListener('dragover', e => {
        e.preventDefault();
        dropZone.classList.add('dragover');
    });

    dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('dragover');
    });

    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer.files.length) {
            fileInput.files = e.dataTransfer.files;
            fileInput.dispatchEvent(new Event('change'));
        }
    });

    function searchDocs(query) {
        const q = query.toLowerCase();
        document.querySelectorAll('#docsGrid .doc-item').forEach(card => {
            const name = card.dataset.name || '';
            card.style.display = name.includes(q) ? '' : 'none';
        });
    }
</script>
