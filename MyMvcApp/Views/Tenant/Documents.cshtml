@model TenantDocumentsViewModel
@{
    ViewData["Title"] = "Documents";
}

<link rel="stylesheet" href="~/css/pages/tenant-theme.css" asp-append-version="true" />

<div class="tenant-console">
    <aside class="tenant-rail">
        <div class="tenant-rail-brand">
            <span class="tenant-rail-logo"><i class="bi bi-buildings"></i></span>
            <div>
                <p class="tenant-rail-title">Tenant Console</p>
                <p class="tenant-rail-sub">Property Operations</p>
            </div>
        </div>
        <nav class="tenant-rail-nav">
            <a asp-action="Dashboard" class="tenant-rail-link"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a>
            <a asp-action="MyProperty" class="tenant-rail-link"><i class="bi bi-house-door-fill"></i> Property</a>
            <a asp-action="MaintenanceRequest" class="tenant-rail-link"><i class="bi bi-tools"></i> Maintenance</a>
            <a asp-action="Payments" class="tenant-rail-link"><i class="bi bi-wallet2"></i> Payments</a>
            <a asp-action="Visitors" class="tenant-rail-link"><i class="bi bi-qr-code-scan"></i> Visitors</a>
            <a asp-action="Documents" class="tenant-rail-link active"><i class="bi bi-file-earmark-text-fill"></i> Documents</a>
            <a asp-action="Announcements" class="tenant-rail-link"><i class="bi bi-megaphone-fill"></i> Announcements</a>
            <a asp-controller="Home" asp-action="Index" class="tenant-rail-link"><i class="bi bi-calendar-event"></i> Community Hub</a>
        </nav>
    </aside>

    <section class="tenant-workspace">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <div class="tenant-toolbar">
            <div>
                <p class="tenant-kicker">Document Vault</p>
                <h1 class="tenant-heading">Tenant Documents</h1>
                <p class="tenant-sub">Store agreements, identity files, and receipts securely in your tenant document library.</p>
            </div>
            <button type="button" class="btn tenant-btn tenant-btn-primary" onclick="toggleForm()">+ Upload Document</button>
        </div>

        <div class="tenant-panel" id="uploadForm" style="display:none; margin-bottom: 20px;">
            <div class="tenant-panel-head"><h3 class="tenant-panel-title">Upload New Document</h3></div>
            <div class="tenant-panel-body tenant-form">
                <form id="docForm" asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="alert alert-info" id="uploadStatusMessage" style="display:none;"></div>
                    <div class="tenant-form-grid">
                        <div>
                            <label>Document Name</label>
                            <input class="form-control" asp-for="NewDocument.DocumentName" placeholder="e.g. Tenancy Agreement 2025" />
                            <span asp-validation-for="NewDocument.DocumentName" class="text-danger"></span>
                        </div>
                        <div>
                            <label>Document Type</label>
                            <select class="form-select" asp-for="NewDocument.DocumentType">
                                <option value="">Select type</option>
                                <option value="TenancyAgreement">Tenancy Agreement</option>
                                <option value="IdentityCard">Identity Card</option>
                                <option value="PaymentReceipt">Payment Receipt</option>
                                <option value="InspectionReport">Inspection Report</option>
                                <option value="Others">Others</option>
                            </select>
                            <span asp-validation-for="NewDocument.DocumentType" class="text-danger"></span>
                        </div>
                        <div class="full">
                            <label>Notes (optional)</label>
                            <textarea class="form-control" asp-for="NewDocument.Notes" placeholder="Any notes about this document..."></textarea>
                            <span asp-validation-for="NewDocument.Notes" class="text-danger"></span>
                        </div>
                        <div class="full">
                            <label>File (Required)</label>
                            <div class="drop-zone" id="dropZone">
                                <input type="file" id="docFile" name="NewDocument.File" required accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.txt,.xlsx,.xls" />
                                <div class="dz-content">
                                    <div class="fs-3"><i class="bi bi-cloud-arrow-up"></i></div>
                                    <div class="tenant-sub"><strong>Click to upload</strong> or drag and drop</div>
                                    <div class="tenant-sub">PDF, JPG, JPEG, PNG, DOC, DOCX, TXT, XLS, XLSX - max 10MB</div>
                                </div>
                                <div id="dz-file" class="fs-4 mt-2" style="display:none;"><i class="bi bi-file-earmark-text"></i></div>
                                <div class="tenant-sub mt-2" id="fileNameDisplay"></div>
                            </div>
                            <span asp-validation-for="NewDocument.File" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <button type="button" class="btn tenant-btn tenant-btn-outline" onclick="toggleForm()">Cancel</button>
                        <button type="submit" class="btn tenant-btn tenant-btn-primary" id="uploadButton">Upload Document</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="tenant-panel">
            <div class="tenant-panel-head">
                <h3 class="tenant-panel-title">Document Library</h3>
                <div style="max-width:240px;">
                    <input class="form-control" type="text" placeholder="Search documents..." oninput="searchDocs(this.value)" />
                </div>
            </div>
            <div class="tenant-panel-body">
                <div class="doc-grid" id="docsGrid">
                    @if (Model.Documents.Count == 0)
                    {
                        <div class="tenant-empty">No documents uploaded yet.</div>
                    }
                    else
                    {
                        @foreach (var document in Model.Documents)
                        {
                            var fileSizeText = document.FileSize.HasValue
                                ? $"{Math.Round(document.FileSize.Value / 1024d, 1)} KB"
                                : "Unknown size";

                            <div class="doc-card doc-item" data-name="@document.DocumentName.ToLowerInvariant()">
                                <div class="fw-semibold">@document.DocumentName</div>
                                <div class="tenant-sub small mb-2">Uploaded @document.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") - @fileSizeText</div>
                                <span class="tenant-badge badge-primary mb-2">@document.DocumentType</span>
                                @if (document.UploadStatus != DocumentUploadStatus.Confirmed)
                                {
                                    <span class="tenant-badge mb-2">@document.UploadStatus</span>
                                }
                                <div class="d-flex gap-2 flex-wrap">
                                    @if (document.UploadStatus == DocumentUploadStatus.Confirmed)
                                    {
                                        <a asp-action="DownloadDocument" asp-route-id="@document.DocumentId" target="_blank" class="btn tenant-btn tenant-btn-outline btn-sm">View</a>
                                        <a asp-action="DownloadDocument" asp-route-id="@document.DocumentId" class="btn tenant-btn tenant-btn-outline btn-sm">Download</a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn tenant-btn tenant-btn-outline btn-sm" disabled>Validating</button>
                                    }
                                    <form asp-action="DeleteDocument" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@document.DocumentId" />
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Archive this document?')">Archive</button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="tenant-sub mt-3">Uploaded files are protected by ownership checks. Archiving keeps an audit trail with soft delete.</div>
            </div>
        </div>
    </section>
</div>

<script>
    function toggleForm() {
        const form = document.getElementById('uploadForm');
        if (form.style.display === 'none') {
            form.style.display = 'block';
            form.scrollIntoView({ behavior: 'smooth', block: 'start' });
            // Clear form when opening
            document.getElementById('docForm').reset();
        } else {
            form.style.display = 'none';
        }
    }

    // Show form if there are validation errors
    if (document.querySelector('.text-danger:not(:empty)')) {
        document.getElementById('uploadForm').style.display = 'block';
    }

    const fileInput = document.getElementById('docFile');
    const fileNameDisplay = document.getElementById('fileNameDisplay');
    const dropZone = document.getElementById('dropZone');
    const docForm = document.getElementById('docForm');
    const uploadButton = document.getElementById('uploadButton');
    const uploadStatusMessage = document.getElementById('uploadStatusMessage');

    fileInput.addEventListener('change', function () {
        const icon = document.getElementById('dz-file');
        const content = document.querySelector('.dz-content');

        if (this.files.length > 0) {
            icon.style.display = 'block';
            content.style.display = 'none';
            fileNameDisplay.textContent = this.files[0].name + ' (' + (this.files[0].size / 1024 / 1024).toFixed(2) + ' MB)';
        } else {
            icon.style.display = 'none';
            content.style.display = 'block';
            fileNameDisplay.textContent = '';
        }
    });

    dropZone.addEventListener('dragover', e => {
        e.preventDefault();
        dropZone.classList.add('dragover');
    });

    dropZone.addEventListener('dragleave', () => {
        dropZone.classList.remove('dragover');
    });

    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.classList.remove('dragover');
        if (e.dataTransfer.files.length) {
            fileInput.files = e.dataTransfer.files;
            fileInput.dispatchEvent(new Event('change'));
        }
    });

    dropZone.addEventListener('click', function (e) {
        if (e.target !== fileInput) {
            fileInput.click();
        }
    });

    function searchDocs(query) {
        const q = query.toLowerCase();
        document.querySelectorAll('#docsGrid .doc-item').forEach(card => {
            const name = card.dataset.name || '';
            card.style.display = name.includes(q) ? '' : 'none';
        });
    }

    function setUploadMessage(message, isError) {
        uploadStatusMessage.textContent = message;
        uploadStatusMessage.className = isError ? 'alert alert-danger' : 'alert alert-info';
        uploadStatusMessage.style.display = 'block';
    }

    async function pollUploadStatus(documentId) {
        for (let attempt = 0; attempt < 15; attempt++) {
            await new Promise(resolve => setTimeout(resolve, 2000));
            const response = await fetch(`/Tenant/GetDocumentUploadStatus/${documentId}`, {
                headers: { 'Accept': 'application/json' }
            });

            if (!response.ok) {
                continue;
            }

            const result = await response.json();
            if (result.status === 'Confirmed') {
                setUploadMessage('Upload confirmed. Refreshing document library...', false);
                window.location.reload();
                return;
            }

            if (result.status === 'FailedValidation') {
                setUploadMessage(result.validationMessage || 'Upload failed validation.', true);
                uploadButton.disabled = false;
                uploadButton.textContent = 'Upload Document';
                return;
            }
        }

        setUploadMessage('File reached S3. Waiting for backend validation event; the document will become available after confirmation.', false);
        setTimeout(() => window.location.reload(), 2500);
    }

    docForm.addEventListener('submit', async function (event) {
        event.preventDefault();

        const file = fileInput.files[0];
        if (!file) {
            setUploadMessage('Please choose a valid file.', true);
            return;
        }

        uploadButton.disabled = true;
        uploadButton.textContent = 'Preparing upload...';
        setUploadMessage('Creating secure upload session...', false);

        try {
            const token = docForm.querySelector('input[name="__RequestVerificationToken"]').value;
            const payload = {
                documentName: document.getElementById('NewDocument_DocumentName').value,
                documentType: document.getElementById('NewDocument_DocumentType').value,
                notes: document.getElementById('NewDocument_Notes').value,
                fileName: file.name,
                contentType: file.type || 'application/octet-stream',
                fileSize: file.size
            };

            const createResponse = await fetch('/Tenant/CreateDocumentUpload', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token,
                    'Accept': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            if (!createResponse.ok) {
                const responseText = await createResponse.text();
                let message = 'Unable to create upload session.';
                try {
                    const error = JSON.parse(responseText);
                    message = error.message || message;
                } catch {
                    message = `${message} Server returned ${createResponse.status}. ${responseText.substring(0, 180)}`;
                }
                throw new Error(message);
            }

            const uploadSession = await createResponse.json();
            uploadButton.textContent = 'Uploading to S3...';
            setUploadMessage('Uploading file directly to S3...', false);

            const putResponse = await fetch(uploadSession.uploadUrl, {
                method: 'PUT',
                headers: { 'Content-Type': payload.contentType },
                body: file
            });

            if (!putResponse.ok) {
                throw new Error('S3 upload failed. Please try again.');
            }

            uploadButton.textContent = 'Waiting for validation...';
            setUploadMessage('Upload completed. Waiting for S3 validation event...', false);
            await pollUploadStatus(uploadSession.documentId);
        } catch (error) {
            setUploadMessage(error.message || 'Upload failed.', true);
            uploadButton.disabled = false;
            uploadButton.textContent = 'Upload Document';
        }
    });
</script>
