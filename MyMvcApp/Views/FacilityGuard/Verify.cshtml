@model MyMvcApp.Models.FacilityBooking

@{
    ViewData["Title"] = "Verify Facility Pass";
    Layout = "_Layout"; // You can use a blank layout here if you don't want the main navbar for guards
}

<div class="container mt-5 mb-5" style="max-width: 500px;">
    <div class="text-center mb-4">
        <h2>Security Scanner</h2>
        <p class="text-muted">Enter the 8-character pass code or scan the QR.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="Verify">
                <div class="input-group input-group-lg">
                    <input type="text" name="code" class="form-control text-uppercase text-center fw-bold" placeholder="E.G. A1B2C3D4" value="@Context.Request.Query["code"]" required maxlength="8">
                    <button class="btn btn-primary" type="submit">Verify</button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.Status != null)
    {
        <div class="card shadow border-0">
            @if (ViewBag.Status == "Valid")
            {
                <div class="card-header bg-success text-white text-center py-4">
                    <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
                    <h3 class="mt-2 mb-0">VALID PASS</h3>
                </div>
            }
            else if (ViewBag.Status == "Invalid")
            {
                <div class="card-header bg-danger text-white text-center py-4">
                    <i class="bi bi-x-octagon-fill" style="font-size: 4rem;"></i>
                    <h3 class="mt-2 mb-0">INVALID PASS</h3>
                </div>
            }
            else
            {
                <div class="card-header bg-warning text-dark text-center py-4">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem;"></i>
                    <h3 class="mt-2 mb-0">@ViewBag.Status.ToUpper()</h3>
                </div>
            }

            <div class="card-body text-center p-4">
                <h5 class="text-muted mb-4">@ViewBag.Message</h5>

                @if (Model != null)
                {
                    <ul class="list-group list-group-flush text-start">
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Facility:</span>
                            <strong>@Model.Facility.Name</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Booked By:</span>
                            <strong>@(Model.GuestName ?? Model.AppUser?.Email)</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Date:</span>
                            <strong>@Model.BookingDate.ToString("dd MMM yyyy")</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Time:</span>
                            <strong>@Model.StartTime.ToString("hh\\:mm") - @Model.EndTime.ToString("hh\\:mm")</strong>
                        </li>
                    </ul>
                }
            </div>
        </div>
    }
</div>