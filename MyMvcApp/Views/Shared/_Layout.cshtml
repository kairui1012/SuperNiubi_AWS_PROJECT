<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PropEase</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/app-shell.css" asp-append-version="true" />
    
    @if ((ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).Equals("Landlord", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/pages/landlord.css" asp-append-version="true" />
    }
    else if ((ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty).Equals("Tenant", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/pages/tenant-theme.css" asp-append-version="true" />
    }
    else if (!(ViewData["IsAuthPage"] as bool? ?? false))
    {
        <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/MyMvcApp.styles.css" asp-append-version="true" />
    
    @await RenderSectionAsync("Styles", required: false)

    <script>
        const storedTheme = localStorage.getItem('theme');
        const getPreferredTheme = () => {
            if (storedTheme) return storedTheme;
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        document.documentElement.setAttribute('data-bs-theme', getPreferredTheme());
    </script>
</head>

@{ 
    var isAuthPage = ViewData["IsAuthPage"] as bool? ?? false; 
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty; 
    var isLandlordPage = controllerName.Equals("Landlord", StringComparison.OrdinalIgnoreCase); 
    var isTenantPage = controllerName.Equals("Tenant", StringComparison.OrdinalIgnoreCase); 
    var currentUrl = $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}
<body class="@(isAuthPage ? null : (isLandlordPage ? "landlord-cloud-skin" : (isTenantPage ? "tenant-cloud-skin" : "admin-cloud-skin")))">
    
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-4 py-2 app-topbar-shell">
            <div class="container">
                <a class="navbar-brand app-brand-link" asp-controller="Home" asp-action="Index" aria-label="PropEase community events">
                    <span class="app-brand-mark">
                        <img class="app-brand-emblem" src="~/images/auth-side.png" alt="" />
                    </span>
                    <span class="app-brand-name">Prop<span class="app-brand-accent">Ease</span></span>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="FacilityBooking" asp-action="Index">
                                Book Facilities
                            </a>
                        </li>
                    </ul>
                    
                    <div class="d-flex align-items-center gap-3 mt-3 mt-sm-0 app-topbar-actions">
                        <button id="theme-toggle" class="btn p-2 app-page-theme-toggle" aria-label="Toggle theme">
                            <i class="bi bi-moon-stars fs-5" id="theme-icon"></i>
                        </button>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var userEmail = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity.Name;

                            <div class="dropdown app-account-menu">
                                <button type="button"
                                        class="app-account-trigger"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Open account menu">
                                    <span class="app-account-avatar"><i class="bi bi-person"></i></span>
                                    <span class="app-account-email">@userEmail</span>
                                    <i class="bi bi-chevron-down app-account-chevron"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end app-account-dropdown">
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit" class="app-account-item app-account-item-danger">
                                            <i class="bi bi-box-arrow-right"></i>
                                            Logout
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else if (!isAuthPage)
                        {
                            <a class="btn btn-primary px-4 rounded-pill fw-medium shadow-sm" asp-controller="Account" asp-action="Login">
                                Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('theme-toggle');
            const icon = document.getElementById('theme-icon');
            const htmlElement = document.documentElement;

            const currentTheme = htmlElement.getAttribute('data-bs-theme');
            if(currentTheme === 'dark' && icon) {
                icon.classList.replace('bi-moon-stars', 'bi-sun');
            }

            if(toggleBtn) {
                toggleBtn.addEventListener('click', () => {
                    const isDark = htmlElement.getAttribute('data-bs-theme') === 'dark';
                    const newTheme = isDark ? 'light' : 'dark';
                    
                    htmlElement.setAttribute('data-bs-theme', newTheme);
                    localStorage.setItem('theme', newTheme);
                    
                    if(icon) {
                        if(newTheme === 'dark') {
                            icon.classList.replace('bi-moon-stars', 'bi-sun');
                        } else {
                            icon.classList.replace('bi-sun', 'bi-moon-stars');
                        }
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
