<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PropEase</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    @await RenderSectionAsync("Styles", required: false)

    <script>
        // 页面加载前立即设置主题，防止闪烁 (FOUC)
        const storedTheme = localStorage.getItem('theme');
        const getPreferredTheme = () => {
            if (storedTheme) {
                return storedTheme;
            }
            return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        document.documentElement.setAttribute('data-bs-theme', getPreferredTheme());
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-4 py-2">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    PropEase
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>
                    
                    <div class="d-flex align-items-center gap-3 mt-3 mt-sm-0">
                        <button id="theme-toggle" class="btn p-2" aria-label="Toggle theme">
                            <i class="bi bi-moon-stars fs-5" id="theme-icon"></i>
                        </button>
                        
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var userEmail = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value ?? User.Identity.Name;

                            <div class="dropdown">
                                <button type="button" class="btn btn-outline-secondary rounded-pill dropdown-toggle d-flex align-items-center gap-2" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i> 
                                    <span>@userEmail</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userMenuDropdown">
                                    
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Admin"><i class="bi bi-shield-lock me-2 text-muted"></i>Admin Panel</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Landlord" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2 text-muted"></i>Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Landlord" asp-action="MyProperties"><i class="bi bi-building me-2 text-muted"></i>Properties</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                                                <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-primary px-4 rounded-pill fw-medium shadow-sm" asp-controller="Account" asp-action="Login">
                                Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('theme-toggle');
            const icon = document.getElementById('theme-icon');
            const htmlElement = document.documentElement;

            // 初始化图标状态
            const currentTheme = htmlElement.getAttribute('data-bs-theme');
            if(currentTheme === 'dark') {
                icon.classList.replace('bi-moon-stars', 'bi-sun');
            }

            toggleBtn.addEventListener('click', () => {
                const isDark = htmlElement.getAttribute('data-bs-theme') === 'dark';
                const newTheme = isDark ? 'light' : 'dark';
                
                htmlElement.setAttribute('data-bs-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                
                if(newTheme === 'dark') {
                    icon.classList.replace('bi-moon-stars', 'bi-sun');
                } else {
                    icon.classList.replace('bi-sun', 'bi-moon-stars');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>