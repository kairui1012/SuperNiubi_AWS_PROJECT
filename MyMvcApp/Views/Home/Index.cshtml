@model IEnumerable<MyMvcApp.Models.CommunityUpdate>
@{
    ViewData["Title"] = "Community Hub";
    var updates = Model?.ToList() ?? new List<MyMvcApp.Models.CommunityUpdate>();
    var activeCount = updates.Count(m => m.EndDate >= DateTime.UtcNow);
    string? dashboardUrl = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        dashboardUrl = User.IsInRole("Admin")
            ? Url.Action("Dashboard", "Admin")
            : User.IsInRole("Landlord")
                ? Url.Action("Dashboard", "Landlord")
                : Url.Action("Dashboard", "Tenant");
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}

<div class="community-board">
    <section class="community-hero">
        <div>
            <p class="community-kicker">Propease Community Hub</p>
            <h1>Community Events</h1>
            <p class="community-subtitle">Stay updated with property announcements, community activities, and important notices.</p>
            @if (!string.IsNullOrEmpty(dashboardUrl))
            {
                <a href="@dashboardUrl" class="community-dashboard-link">
                    <i class="bi bi-arrow-left"></i>
                    Back to Dashboard
                </a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="CommunityAdmin" asp-action="Index" class="community-dashboard-link">
                    <i class="bi bi-pencil-square"></i>
                    Manage Updates
                </a>
            }
        </div>
        <div class="community-summary" aria-label="Community update summary">
            <div>
                <strong>@updates.Count</strong>
                <span>Total updates</span>
            </div>
            <div>
                <strong>@activeCount</strong>
                <span>Active now</span>
            </div>
        </div>
    </section>

    @if (ViewBag.DatabaseUnavailable == true)
    {
        <div class="alert alert-warning">
            Community updates are temporarily unavailable. Please try again shortly.
        </div>
    }

    @if (updates.Any())
    {
        <section class="community-grid" aria-label="Community events and updates">
            @foreach (var item in updates)
            {
                var isExpired = item.EndDate < DateTime.UtcNow;
                var plainDescription = System.Text.RegularExpressions.Regex.Replace(item.Description ?? string.Empty, "<.*?>", string.Empty);
                
                // Smart Date: Uses the actual event date if it exists, otherwise falls back to the end date
                var calendarDate = item.EventStartDate ?? item.EndDate;

                var typeClass = item.Type == MyMvcApp.Models.UpdateType.Event
                    ? "badge-soft-success"
                    : item.Type == MyMvcApp.Models.UpdateType.Promotion
                        ? "badge-soft-primary"
                        : "badge-soft-danger";
                var typeIcon = item.Type == MyMvcApp.Models.UpdateType.Event
                    ? "bi-calendar-event"
                    : item.Type == MyMvcApp.Models.UpdateType.Promotion
                        ? "bi-tags"
                        : "bi-megaphone";

                <article class="community-card">
                    <div class="community-card-media">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" />
                        }
                        else
                        {
                            <div class="community-card-placeholder">
                                <i class="bi @typeIcon"></i>
                            </div>
                        }
                    </div>

                    <div class="community-card-body">
                        <div class="community-card-topline">
                            <div class="community-date" aria-label="Date @calendarDate.ToString("MMM dd, yyyy")">
                                <span>@calendarDate.ToString("MMM")</span>
                                <strong>@calendarDate.ToString("dd")</strong>
                            </div>
                            <div class="community-badges">
                                <span class="community-badge @typeClass">
                                    <i class="bi @typeIcon me-1"></i>@item.Type
                                </span>
                                <span class="community-badge @(isExpired ? "badge-soft-secondary" : "badge-soft-success")">
                                    @(isExpired ? "Ended" : "Active")
                                </span>
                            </div>
                        </div>

                        <h2>@item.Title</h2>
                        <p class="community-description">@plainDescription</p>

                        <div class="community-card-footer">
                            <span>Posted @item.CreatedAt.AddHours(8).ToString("MMM dd, yyyy")</span>
                            <a asp-action="UpdateDetails" asp-route-id="@item.Id" class="community-link">
                                Details <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <section class="community-empty">
            <div class="community-empty-icon">
                <i class="bi bi-calendar2-event"></i>
            </div>
            <h2>No community events yet.</h2>
            <p>New announcements and property updates will appear here.</p>
        </section>
    }
</div>
