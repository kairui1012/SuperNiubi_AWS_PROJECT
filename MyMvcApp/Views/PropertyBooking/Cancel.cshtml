@{ ViewData["Title"] = "Booking Cancelled"; }
<div class="container mt-5 text-center">
    <div class="card shadow-sm border-0 p-5 mx-auto" style="max-width: 600px;">
        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 5rem;"></i>
        <h2 class="fw-bold mt-3">Payment Cancelled</h2>
        <p class="text-muted mt-3">You cancelled the checkout process. Your dates have been released and no charges were made.</p>
        <div class="mt-4">
            <a asp-controller="PropertyBooking" asp-action="Index" class="btn btn-secondary btn-lg px-5 rounded-pill">View Properties</a>
        </div>
    </div>
</div>