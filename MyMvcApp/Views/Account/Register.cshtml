@{
    Layout = null;
    var redirectUrl = Url.Action("Login", "Account", new { mode = "register" }) ?? "/Account/Login?mode=register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=@redirectUrl" />
    <title>Register</title>
</head>
<body>
    <script>
        window.location.replace('@redirectUrl');
    </script>
</body>
</html>