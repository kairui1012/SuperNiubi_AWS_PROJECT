@model MyMvcApp.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    ViewData["IsAuthPage"] = true;
    var authImageUrl = "/images/auth-side.jpg";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<div class="auth-page auth-page-shell" data-auth-page data-auth-mode="login">
    <main class="auth-layout">
        <section class="auth-panel auth-card auth-panel-form">
            <a class="auth-brand text-decoration-none" asp-controller="Home" asp-action="Index" aria-label="Propease community events">
                <span class="auth-brand-mark"><i class="bi bi-buildings"></i></span>
                <span>Propease</span>
            </a>

            <header class="auth-copy-block">
                <p class="auth-kicker">Account recovery</p>
                <h1 class="auth-title">Reset password</h1>
                <p class="auth-subtitle">Enter the code from your email and choose a new password.</p>
            </header>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success auth-alert">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger auth-alert auth-alert-danger">@TempData["ErrorMessage"]</div>
            }

            <form asp-action="ResetPassword" method="post" autocomplete="off" class="auth-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="auth-inline-error"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control auth-input" placeholder="name@company.com" />
                    <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label fw-semibold"></label>
                    <input asp-for="Code" class="form-control auth-input" placeholder="Enter reset code" />
                    <span asp-validation-for="Code" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                    <input asp-for="NewPassword" class="form-control auth-input" placeholder="Create a new password" />
                    <span asp-validation-for="NewPassword" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control auth-input" placeholder="Confirm new password" />
                    <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
                </div>

                <div class="auth-action-row">
                    <button type="submit" class="btn btn-primary auth-submit w-100">Reset password</button>
                </div>

                <div class="auth-form-row mt-3">
                    <a asp-action="Login" class="auth-forgot-button text-decoration-none">Back to login</a>
                </div>
            </form>
        </section>

        <section class="auth-panel auth-visual-panel auth-panel-visual" style="background-image: url('@authImageUrl');" aria-label="Propease platform overview">
            <div class="auth-visual-overlay">
                <div class="auth-visual-content">
                    <span class="auth-visual-kicker">Secure access</span>
                    <p>Keep property operations moving with protected account recovery and role-based access.</p>
                    <div class="auth-visual-metrics" aria-label="Platform capabilities">
                        <div>
                            <strong>AWS</strong>
                            <span>identity</span>
                        </div>
                        <div>
                            <strong>24/7</strong>
                            <span>access</span>
                        </div>
                        <div>
                            <strong>RBAC</strong>
                            <span>roles</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
