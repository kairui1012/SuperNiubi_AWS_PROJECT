@model MyMvcApp.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["IsAuthPage"] = true;
    ViewBag.AuthMode = ViewBag.AuthMode as string ?? "login";
    ViewBag.AuthImageUrl = "/images/auth-side.jpg";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth.css" asp-append-version="true" />
}

<partial name="_AuthPage" model="Model" />