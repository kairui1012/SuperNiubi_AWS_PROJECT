@model MyMvcApp.Models.LoginViewModel
@{
    var authMode = (ViewBag.AuthMode as string ?? "login").ToLowerInvariant();
    var authImageUrl = ViewBag.AuthImageUrl as string ?? "/images/auth-side.jpg";
    var isLogin = authMode != "register";
    var loginErrorMessage = ViewBag.LoginError as string;
    var registerErrorMessage = ViewBag.RegisterError as string;
}

<div class="auth-page auth-page-shell" data-auth-page data-auth-mode="@(isLogin ? "login" : "register")">
    <main class="auth-layout">
        <section class="auth-panel auth-card auth-panel-form">
            <a class="auth-brand text-decoration-none" asp-controller="Home" asp-action="Index" aria-label="Propease community events">
                <span class="auth-brand-mark"><i class="bi bi-buildings"></i></span>
                <span>Propease</span>
            </a>

            <header class="auth-copy-block">
                <p class="auth-kicker">Cloud property management</p>
                <h1 class="auth-title" data-auth-title>@(isLogin ? "Welcome back" : "Create your Propease account")</h1>
                <p class="auth-subtitle" data-auth-subtitle>@(isLogin ? "Sign in to manage properties, tenants, payments, and maintenance in one place." : "Start managing properties, tenants, requests, and payments from one secure cloud dashboard.")</p>
            </header>

            <div class="auth-mode-switch" role="tablist" aria-label="Authentication mode">
                <button type="button" class="auth-mode-tab @(isLogin ? "is-active" : "")" data-auth-switch="login" aria-pressed="@(isLogin ? "true" : "false")">Login</button>
                <button type="button" class="auth-mode-tab @(!isLogin ? "is-active" : "")" data-auth-switch="register" aria-pressed="@(!isLogin ? "true" : "false")">Sign up</button>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success auth-alert">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger auth-alert auth-alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div class="auth-form-stack">
                <form asp-action="Login" method="post" autocomplete="off" class="auth-form @(isLogin ? "" : "d-none")" data-auth-form="login">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="Email" class="form-control auth-input" placeholder="name@company.com" />
                        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Password</label>
                        <input asp-for="Password" type="password" class="form-control auth-input" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="auth-form-row">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                    </div>

                    @if (isLogin && !string.IsNullOrWhiteSpace(loginErrorMessage))
                    {
                        <div class="auth-inline-error">@loginErrorMessage</div>
                    }

                    <div class="auth-action-row">
                        <button type="submit" class="btn btn-primary auth-submit w-100 auth-submit-login">Sign in</button>
                    </div>
                </form>

                <partial name="_GoogleLoginForm" model="@(new GoogleLoginFormViewModel { Mode = "login", ButtonText = "Continue with Google", DataAuthForm = "login-external", IsVisible = isLogin })" />

                <form asp-action="RequestPasswordReset" method="post" class="auth-forgot-form @(isLogin ? "" : "d-none")" data-auth-form="forgot">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="email" data-forgot-email />
                    <button type="submit" class="auth-forgot-button">Forgot password?</button>
                </form>

                <form asp-action="Register" method="post" autocomplete="off" class="auth-form @(!isLogin ? "" : "d-none")" data-auth-form="register">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email</label>
                        <input asp-for="Email" id="registerEmail" class="form-control auth-input" placeholder="name@company.com" />
                        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Password</label>
                        <input asp-for="Password" id="registerPassword" type="password" class="form-control auth-input" placeholder="Create a password" />
                        <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
                    </div>

                    @if (!isLogin && !string.IsNullOrWhiteSpace(registerErrorMessage))
                    {
                        <div class="auth-inline-error">@registerErrorMessage</div>
                    }

                    <div class="auth-action-row">
                        <button type="submit" class="btn btn-primary auth-submit w-100 auth-submit-register">Create account</button>
                    </div>
                </form>

                <partial name="_GoogleLoginForm" model="@(new GoogleLoginFormViewModel { Mode = "register", ButtonText = "Sign up with Google", DataAuthForm = "register-external", IsVisible = !isLogin })" />
            </div>
        </section>

        <section class="auth-panel auth-visual-panel auth-panel-visual" style="background-image: url('@authImageUrl');" aria-label="Propease platform overview">
            <div class="auth-visual-overlay">
                <div class="auth-visual-content">
                    <span class="auth-visual-kicker">AWS-ready operations</span>
                    <p>Coordinate residents, landlords, payments, maintenance, and community updates with a secure cloud foundation built for daily operations.</p>
                    <div class="auth-visual-metrics" aria-label="Platform capabilities">
                        <div>
                            <strong>24/7</strong>
                            <span>cloud access</span>
                        </div>
                        <div>
                            <strong>6</strong>
                            <span>core modules</span>
                        </div>
                        <div>
                            <strong>AWS</strong>
                            <span>deployment</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</div>

<script>
    (() => {
        const page = document.querySelector('[data-auth-page]');
        const tabs = document.querySelectorAll('[data-auth-switch]');
        const loginForm = document.querySelector('[data-auth-form="login"]');
        const registerForm = document.querySelector('[data-auth-form="register"]');
        const forgotForm = document.querySelector('[data-auth-form="forgot"]');
        const loginExternalForm = document.querySelector('[data-auth-form="login-external"]');
        const registerExternalForm = document.querySelector('[data-auth-form="register-external"]');
        const forgotEmail = document.querySelector('[data-forgot-email]');
        const modeTabs = document.querySelectorAll('.auth-mode-tab');
        const loginSubmit = document.querySelector('.auth-submit-login');
        const registerSubmit = document.querySelector('.auth-submit-register');
        const title = document.querySelector('[data-auth-title]');
        const subtitle = document.querySelector('[data-auth-subtitle]');

        const setMode = (mode) => {
            const isLogin = mode === 'login';
            if (page) page.dataset.authMode = mode;
            loginForm?.classList.toggle('d-none', !isLogin);
            registerForm?.classList.toggle('d-none', isLogin);
            forgotForm?.classList.toggle('d-none', !isLogin);
            loginExternalForm?.classList.toggle('d-none', !isLogin);
            registerExternalForm?.classList.toggle('d-none', isLogin);
            title.textContent = isLogin ? 'Welcome back' : 'Create your Propease account';
            subtitle.textContent = isLogin ? 'Sign in to manage properties, tenants, payments, and maintenance in one place.' : 'Start managing properties, tenants, requests, and payments from one secure cloud dashboard.';
            loginSubmit && (loginSubmit.textContent = 'Sign in');
            registerSubmit && (registerSubmit.textContent = 'Create account');
            modeTabs.forEach(tab => {
                const active = tab.dataset.authSwitch === mode;
                tab.classList.toggle('is-active', active);
                tab.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
        };

        tabs.forEach(tab => tab.addEventListener('click', (event) => {
            event.preventDefault();
            setMode(tab.dataset.authSwitch);
        }));

        forgotForm?.addEventListener('submit', () => {
            const emailInput = loginForm?.querySelector('input[name="Email"]');
            if (forgotEmail && emailInput) {
                forgotEmail.value = emailInput.value;
            }
        });

        setMode(page?.dataset.authMode || 'login');
    })();
</script>
