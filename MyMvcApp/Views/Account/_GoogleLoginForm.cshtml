@model MyMvcApp.Models.GoogleLoginFormViewModel

@{
    var formId = $"{Model.DataAuthForm}-form";
}

<form id="@formId"
      asp-controller="GoogleLogin"
      asp-action="ExternalLogin"
      method="post"
      class="auth-external-form @(Model.IsVisible ? "" : "d-none")"
      data-auth-form="@Model.DataAuthForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="mode" value="@Model.Mode" />
    <button type="submit" form="@formId" class="auth-google-button">
        <i class="bi bi-google" aria-hidden="true"></i>
        <span>@Model.ButtonText</span>
    </button>
</form>
