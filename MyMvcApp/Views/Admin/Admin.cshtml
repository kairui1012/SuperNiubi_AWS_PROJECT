@model MyMvcApp.Models.Admin.AdminDashboardViewModel
@using MyMvcApp.Models

@functions {
    private static string GetUserStatusLabel(AppUser user)
    {
        if (user.IsDisabled)
        {
            return "Disabled";
        }

        return user.IsApproved ? "Approved" : "Pending";
    }

    private static string GetUserStatusBadgeClass(AppUser user)
    {
        if (user.IsDisabled)
        {
            return "badge-soft-danger";
        }

        return user.IsApproved ? "badge-soft-success" : "badge-soft-warning";
    }

    private static string GetMaintenanceBadgeClass(MaintenanceStatus status)
    {
        return status switch
        {
            MaintenanceStatus.Pending => "badge-soft-warning",
            MaintenanceStatus.Approved => "badge-soft-info",
            MaintenanceStatus.InProgress => "badge-soft-primary",
            MaintenanceStatus.Completed => "badge-soft-success",
            _ => "badge-soft-danger"
        };
    }

    private static string GetPaymentBadgeClass(PaymentStatus status)
    {
        return status switch
        {
            PaymentStatus.Pending => "badge-soft-secondary",
            PaymentStatus.Submitted => "badge-soft-info",
            PaymentStatus.Verified => "badge-soft-success",
            PaymentStatus.Overdue => "badge-soft-warning",
            _ => "badge-soft-danger"
        };
    }

    private static string GetPriorityBadgeClass(MaintenancePriority priority)
    {
        return priority switch
        {
            MaintenancePriority.High => "badge-soft-danger",
            MaintenancePriority.Medium => "badge-soft-warning",
            _ => "badge-soft-secondary"
        };
    }

    private static string GetAuditActionBadgeClass(string action)
    {
        return action switch
        {
            "ApproveUser" or "EnableUser" or "ApprovePasswordReset" => "badge-soft-success",
            "DisableUser" or "RejectPasswordReset" => "badge-soft-danger",
            "ChangeRole" => "badge-soft-info",
            "CreateAnnouncement" => "badge-soft-primary",
            "EditAnnouncement" => "badge-soft-warning",
            "DeleteAnnouncement" => "badge-soft-danger",
            _ => "badge-soft-secondary"
        };
    }
}

@{
    ViewData["Title"] = "Admin Dashboard";

    var totalUsers = Model.Overview.TotalUsers;
    var totalProperties = Model.Overview.TotalProperties;
    var occupiedProperties = Model.Overview.OccupiedProperties;

    var occupancyRate = totalProperties > 0
        ? Math.Round((double)occupiedProperties / totalProperties * 100)
        : 0;

    var pendingApprovalRate = totalUsers > 0
        ? Math.Round((double)Model.Overview.PendingUsers / totalUsers * 100)
        : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/landlord.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}

<div class="landlord-console admin-console" data-admin-page data-admin-default="@Model.ActivePane">
    <aside class="landlord-rail">
        <div class="landlord-rail-brand">
            <span class="landlord-rail-logo">
                <i class="bi bi-shield-lock"></i>
            </span>
            <div>
                <p class="landlord-rail-title">Admin Console</p>
                <p class="landlord-rail-sub">System Operations</p>
            </div>
        </div>

        <nav class="landlord-rail-nav" aria-label="Admin sections">
            <button type="button"
                    class="landlord-rail-link admin-rail-switch active"
                    data-admin-switch="dashboard"
                    data-admin-kicker="Dashboard"
                    data-admin-title="Analytics"
                    aria-pressed="true">
                <i class="bi bi-grid-1x2-fill"></i>
                Dashboard
            </button>
            <button type="button"
                    class="landlord-rail-link admin-rail-switch"
                    data-admin-switch="users"
                    data-admin-kicker="Users"
                    data-admin-title="User Management"
                    aria-pressed="false">
                <i class="bi bi-people-fill"></i>
                User Management
            </button>
            <button type="button"
                    class="landlord-rail-link admin-rail-switch"
                    data-admin-switch="properties"
                    data-admin-kicker="Properties"
                    data-admin-title="Property Overview"
                    aria-pressed="false">
                <i class="bi bi-houses-fill"></i>
                Property Overview
            </button>
            <button type="button"
                    class="landlord-rail-link admin-rail-switch"
                    data-admin-switch="maintenance"
                    data-admin-kicker="Maintenance"
                    data-admin-title="Maintenance Queue"
                    aria-pressed="false">
                <i class="bi bi-tools"></i>
                Maintenance Queue
            </button>
            <button type="button"
                    class="landlord-rail-link admin-rail-switch"
                    data-admin-switch="payments"
                    data-admin-kicker="Payments"
                    data-admin-title="Payment Center"
                    aria-pressed="false">
                <i class="bi bi-wallet2"></i>
                Payment Center
            </button>
            <button type="button"
                    class="landlord-rail-link admin-rail-switch"
                    data-admin-switch="audit"
                    data-admin-kicker="Audit"
                    data-admin-title="Audit Trail"
                    aria-pressed="false">
                <i class="bi bi-clock-history"></i>
                Audit Trail
            </button>
            <button type="button"
                    class="landlord-rail-link admin-rail-switch"
                    data-admin-switch="announcements"
                    data-admin-kicker="Announcements"
                    data-admin-title="System Announcements"
                    aria-pressed="false">
                <i class="bi bi-megaphone-fill"></i>
                Announcements
            </button>
        </nav>
    </aside>

    <section class="landlord-workspace admin-workspace">
        <div class="admin-shell">
    <section class="admin-hero">
        <div class="admin-page-titlebar">
            <div>
                <div class="admin-kicker" data-admin-heading-kicker>Dashboard</div>
                <h1 class="admin-title" data-admin-heading-title>Analytics</h1>
            </div>
        </div>

    </section>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success admin-alert">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger admin-alert">@errorMessage</div>
    }

    <section class="admin-pane" data-admin-pane="dashboard">
        <div class="admin-ops-summary mb-4" aria-label="Admin dashboard overview">
            <div class="admin-ops-item">
                <span>Total Users</span>
                <strong>@Model.Overview.TotalUsers</strong>
            </div>
            <div class="admin-ops-item">
                <span>Total Properties</span>
                <strong>@Model.Overview.TotalProperties</strong>
            </div>
            <div class="admin-ops-item">
                <span>Total Payments</span>
                <strong>@Model.Overview.TotalPayments</strong>
            </div>
            <div class="admin-ops-item">
                <span>Pending Landlords</span>
                <strong>@Model.Overview.PendingLandlordApprovals</strong>
            </div>
            <div class="admin-ops-item">
                <span>Open Maintenance</span>
                <strong>@Model.Overview.OpenMaintenanceRequests</strong>
            </div>
            <div class="admin-ops-item">
                <span>Occupancy</span>
                <strong>@occupancyRate%</strong>
            </div>
        </div>

        <div class="row g-4 admin-chart-grid">
            <div class="col-xl-6">
                <div class="panel-card admin-chart-card h-100">
                    <div class="panel-heading">
                        <div>
                            <h2 class="panel-title">Collection trend</h2>
                            <span class="panel-meta">6-month verified payments with demand signals</span>
                        </div>
                    </div>
                    <div class="admin-chart-frame admin-chart-frame-wide">
                        <canvas id="adminCollectionTrendChart" aria-label="6-month collection trend chart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="panel-card admin-chart-card h-100">
                    <div class="panel-heading">
                        <div>
                            <h2 class="panel-title">Maintenance status</h2>
                            <span class="panel-meta">Current queue split</span>
                        </div>
                    </div>
                    <div class="admin-chart-frame">
                        <canvas id="adminMaintenanceStatusChart" aria-label="Maintenance status doughnut chart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-xl-3">
                <div class="panel-card admin-chart-card h-100">
                    <div class="panel-heading">
                        <div>
                            <h2 class="panel-title">User roles</h2>
                            <span class="panel-meta">Account composition</span>
                        </div>
                    </div>
                    <div class="admin-chart-frame">
                        <canvas id="adminUserRoleChart" aria-label="User role composition pie chart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="panel-card h-100">
                    <div class="panel-heading">
                        <h2 class="panel-title">User analytics</h2>
                        <span class="panel-meta">Accounts</span>
                    </div>
                    <div class="metric-row">
                        <span>Approved users</span>
                        <span class="metric-value">@Model.Overview.ApprovedUsers</span>
                    </div>
                    <div class="metric-row">
                        <span>Pending users</span>
                        <span class="metric-value">@Model.Overview.PendingUsers</span>
                    </div>
                    <div class="metric-row">
                        <span>Disabled users</span>
                        <span class="metric-value">@Model.Overview.DisabledUsers</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="panel-card h-100">
                    <div class="panel-heading">
                        <h2 class="panel-title">Property analytics</h2>
                        <span class="panel-meta">Portfolio</span>
                    </div>
                    <div class="metric-row">
                        <span>Occupied properties</span>
                        <span class="metric-value">@Model.Overview.OccupiedProperties</span>
                    </div>
                    <div class="metric-row">
                        <span>Vacant properties</span>
                        <span class="metric-value">@Model.Overview.VacantProperties</span>
                    </div>
                    <div class="metric-row">
                        <span>Active tenancies</span>
                        <span class="metric-value">@Model.Overview.ActiveTenancies</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="panel-card h-100">
                    <div class="panel-heading">
                        <h2 class="panel-title">Operations analytics</h2>
                        <span class="panel-meta">Workload</span>
                    </div>
                    <div class="metric-row">
                        <span>Open maintenance</span>
                        <span class="metric-value">@Model.Overview.OpenMaintenanceRequests</span>
                    </div>
                    <div class="metric-row">
                        <span>Overdue payments</span>
                        <span class="metric-value">@Model.Overview.OverduePayments</span>
                    </div>
                    <div class="metric-row">
                        <span>Documents</span>
                        <span class="metric-value">@Model.Overview.TotalDocuments</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="admin-pane d-none" data-admin-pane="users">
        <div class="row g-4 admin-user-stack">
            <div class="col-12 admin-user-main">
                <div class="panel-card admin-users-card">
                    <div class="panel-heading user-panel-heading">
                        <div>
                            <h2 class="panel-title">Manage users</h2>
                            <div class="panel-meta">Approval, role assignment, and disable/enable controls stay in one place.</div>
                        </div>
                        <span class="badge admin-count-badge">@Model.Users.Count result(s)</span>
                    </div>

                    <form asp-action="Dashboard" method="get" class="admin-filter-bar admin-user-filter">
                        <input type="hidden" name="activePane" value="users" />
                        <div class="admin-user-field admin-user-search">
                            <label class="admin-filter-label" for="searchEmail">Search</label>
                            <input type="text"
                                   id="searchEmail"
                                   name="searchEmail"
                                   class="form-control filter-input"
                                   placeholder="Search by email"
                                   value="@Model.SearchEmail" />
                        </div>
                        <div class="admin-user-field">
                            <label class="admin-filter-label" for="roleFilter">Role</label>
                            <select id="roleFilter" name="roleFilter" class="form-select filter-select">
                                <option value="">All roles</option>
                                <option value="Tenant" selected="@(Model.RoleFilter == "Tenant" ? "selected" : null)">Tenant</option>
                                <option value="Landlord" selected="@(Model.RoleFilter == "Landlord" ? "selected" : null)">Landlord</option>
                                <option value="Admin" selected="@(Model.RoleFilter == "Admin" ? "selected" : null)">Admin</option>
                            </select>
                        </div>
                        <div class="admin-user-field">
                            <label class="admin-filter-label" for="statusFilter">Status</label>
                            <select id="statusFilter" name="statusFilter" class="form-select filter-select">
                                <option value="">All status</option>
                                <option value="Pending" selected="@(Model.StatusFilter == "Pending" ? "selected" : null)">Pending</option>
                                <option value="Approved" selected="@(Model.StatusFilter == "Approved" ? "selected" : null)">Approved</option>
                                <option value="Disabled" selected="@(Model.StatusFilter == "Disabled" ? "selected" : null)">Disabled</option>
                            </select>
                        </div>
                        <div class="admin-user-submit">
                            <button type="submit" class="btn admin-btn-primary">Apply</button>
                        </div>
                        <div class="admin-filter-actions admin-user-actions">
                            <a asp-action="Dashboard" asp-route-activePane="users" class="btn admin-btn-secondary btn-sm">Reset filters</a>
                        </div>
                    </form>

                    <div class="table-responsive admin-users-scroll">
                        <table class="table admin-table">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th>Role</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Users.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 muted-copy">No users matched the current filter.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var user in Model.Users)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@user.Email</div>
                                                <div class="panel-meta">User #@user.Id</div>
                                            </td>
                                            <td>
                                                <span class="badge @GetUserStatusBadgeClass(user)">@GetUserStatusLabel(user)</span>
                                            </td>
                                            <td>
                                                <form asp-action="ChangeRole" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                                                    <input type="hidden" name="id" value="@user.Id" />
                                                    <select name="newRole"
                                                            class="form-select form-select-sm filter-select"
                                                            style="width: 150px;"
                                                            @(user.IsDisabled ? "disabled" : null)>
                                                        <option value="Tenant" selected="@(user.Role == "Tenant" ? "selected" : null)">Tenant</option>
                                                        <option value="Landlord" selected="@(user.Role == "Landlord" ? "selected" : null)">Landlord</option>
                                                        <option value="Admin" selected="@(user.Role == "Admin" ? "selected" : null)">Admin</option>
                                                    </select>
                                                    <button type="submit"
                                                            class="btn admin-btn-secondary btn-sm"
                                                            @(user.IsDisabled ? "disabled" : null)>
                                                        Save
                                                    </button>
                                                </form>
                                            </td>
                                            <td>
                                                <div class="table-actions">
                                                    @if (user.IsDisabled)
                                                    {
                                                        <form asp-action="EnableUser" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@user.Id" />
                                                            <button type="submit"
                                                                    class="btn btn-success btn-sm"
                                                                    onclick="return confirm('Enable this user account?');">
                                                                Enable
                                                            </button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        @if (!user.IsApproved)
                                                        {
                                                            <form asp-action="ApproveUser" method="post" class="d-inline">
                                                                <input type="hidden" name="id" value="@user.Id" />
                                                                <button type="submit" class="btn btn-warning btn-sm">Approve & Email</button>
                                                            </form>
                                                        }

                                                        <form asp-action="DisableUser" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@user.Id" />
                                                            <button type="submit"
                                                                    class="btn btn-danger btn-sm"
                                                                    onclick="return confirm('Disable this user account?');">
                                                                Disable
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="panel-card admin-user-section admin-user-password">
                    <div class="panel-heading">
                        <h2 class="panel-title">Password reset requests</h2>
                        <span class="badge admin-count-badge">@Model.PasswordResetRequests.Count pending</span>
                    </div>
                    @if (Model.PasswordResetRequests.Count == 0)
                    {
                        <div class="empty-state">No password reset requests.</div>
                    }
                    else
                    {
                        <div class="activity-list">
                            @foreach (var resetRequest in Model.PasswordResetRequests)
                            {
                                <div class="activity-item">
                                    <div class="activity-title">@resetRequest.Email</div>
                                    <div class="activity-meta">
                                        Requested @resetRequest.RequestedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                    </div>
                                    <div class="table-actions mt-3">
                                        <form asp-action="ApprovePasswordResetRequest" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@resetRequest.PasswordResetRequestId" />
                                            <button type="submit"
                                                    class="btn btn-success btn-sm"
                                                    onclick="return confirm('Approve this password reset request and send a Cognito reset email?');">
                                                Approve
                                            </button>
                                        </form>
                                        <form asp-action="RejectPasswordResetRequest" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@resetRequest.PasswordResetRequestId" />
                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Reject this password reset request?');">
                                                Reject
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-12">
                <div class="panel-card admin-user-section admin-user-latest">
                    <div class="panel-heading">
                        <h2 class="panel-title">Latest user records</h2>
                        <span class="panel-meta">Newest DB entries</span>
                    </div>
                    @if (Model.LatestUsers.Count == 0)
                    {
                        <div class="empty-state">No users available yet.</div>
                    }
                    else
                    {
                        <div class="activity-list">
                            @foreach (var user in Model.LatestUsers)
                            {
                                <div class="activity-item">
                                    <div class="activity-title">@user.Email</div>
                                    <div class="activity-meta">
                                        User #@user.Id • @user.Role •
                                        <span class="badge @GetUserStatusBadgeClass(new AppUser { IsApproved = user.IsApproved, IsDisabled = user.IsDisabled })">
                                            @GetUserStatusLabel(new AppUser { IsApproved = user.IsApproved, IsDisabled = user.IsDisabled })
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="admin-pane d-none" data-admin-pane="properties">
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="panel-card">
                    <div class="panel-heading">
                        <h2 class="panel-title">Property overview</h2>
                        <span class="panel-meta">Occupancy and asset health</span>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="summary-card">
                                <div class="summary-label">Total properties</div>
                                <div class="summary-value">@Model.PropertyReport.TotalProperties</div>
                                <div class="summary-footnote">Managed units in the system</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="summary-card">
                                <div class="summary-label">Occupied properties</div>
                                <div class="summary-value">@Model.PropertyReport.OccupiedProperties</div>
                                <div class="summary-footnote">Active rentals currently assigned</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="summary-card">
                                <div class="summary-label">Vacant properties</div>
                                <div class="summary-value">@Model.PropertyReport.VacantProperties</div>
                                <div class="summary-footnote">Available for new tenants</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="summary-card">
                                <div class="summary-label">Active tenancies</div>
                                <div class="summary-value">@Model.PropertyReport.ActiveTenancies</div>
                                <div class="summary-footnote">Live rental assignments</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="panel-card h-100">
                    <div class="panel-heading">
                        <h2 class="panel-title">Platform features</h2>
                        <span class="panel-meta">New additions</span>
                    </div>
                    <div class="activity-list">
                        <div class="activity-item">
                            <div class="activity-title">Documents tracked in cloud</div>
                            <div class="activity-meta">@Model.Overview.TotalDocuments files are available for review and audit.</div>
                        </div>
                        <div class="activity-item">
                            <div class="activity-title">Occupancy monitoring</div>
                            <div class="activity-meta">The control panel keeps rental occupancy and vacancies visible at a glance.</div>
                        </div>
                        <div class="activity-item">
                            <div class="activity-title">Property workflow shortcuts</div>
                            <div class="activity-meta">Quick actions help move from overview into management with fewer clicks.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="admin-pane d-none" data-admin-pane="maintenance">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="panel-card h-100">
                    <div class="panel-heading">
                        <h2 class="panel-title">Maintenance queue</h2>
                        <span class="panel-meta">Request pipeline</span>
                    </div>
                    <div class="metric-row">
                        <span>Pending</span>
                        <span class="metric-value">@Model.MaintenanceReport.PendingCount</span>
                    </div>
                    <div class="metric-row">
                        <span>Approved</span>
                        <span class="metric-value">@Model.MaintenanceReport.ApprovedCount</span>
                    </div>
                    <div class="metric-row">
                        <span>In progress</span>
                        <span class="metric-value">@Model.MaintenanceReport.InProgressCount</span>
                    </div>
                    <div class="metric-row">
                        <span>Completed</span>
                        <span class="metric-value">@Model.MaintenanceReport.CompletedCount</span>
                    </div>
                    <div class="metric-row">
                        <span>High priority open</span>
                        <span class="metric-value">@Model.MaintenanceReport.HighPriorityOpenCount</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="panel-card h-100">
                    <div class="panel-heading">
                        <h2 class="panel-title">Recent maintenance</h2>
                        <span class="panel-meta">Latest requests submitted</span>
                    </div>
                    @if (Model.RecentMaintenanceRequests.Count == 0)
                    {
                        <div class="empty-state">No maintenance requests found.</div>
                    }
                    else
                    {
                        <div class="activity-list">
                            @foreach (var item in Model.RecentMaintenanceRequests)
                            {
                                <div class="activity-item">
                                    <div class="activity-title">@item.Title</div>
                                    <div class="activity-meta">@item.PropertyName • @item.TenantEmail</div>
                                    <div class="activity-meta mt-2">
                                        <span class="badge @GetMaintenanceBadgeClass(item.Status)">@item.Status</span>
                                        <span class="badge @GetPriorityBadgeClass(item.Priority)">@item.Priority priority</span>
                                        <span>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="admin-pane d-none" data-admin-pane="payments">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="panel-card h-100">
                    <div class="panel-heading">
                        <h2 class="panel-title">Payment center</h2>
                        <span class="panel-meta">Collection and exceptions</span>
                    </div>
                    <div class="metric-row">
                        <span>Pending</span>
                        <span class="metric-value">@Model.PaymentReport.PendingCount</span>
                    </div>
                    <div class="metric-row">
                        <span>Submitted</span>
                        <span class="metric-value">@Model.PaymentReport.SubmittedCount</span>
                    </div>
                    <div class="metric-row">
                        <span>Verified</span>
                        <span class="metric-value">@Model.PaymentReport.VerifiedCount</span>
                    </div>
                    <div class="metric-row">
                        <span>Overdue</span>
                        <span class="metric-value">@Model.PaymentReport.OverdueCount</span>
                    </div>
                    <div class="metric-row">
                        <span>Total verified amount</span>
                        <span class="metric-value">@Model.PaymentReport.TotalVerifiedAmount.ToString("C")</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="panel-card h-100">
                    <div class="panel-heading">
                        <h2 class="panel-title">Recent payments</h2>
                        <span class="panel-meta">Latest payment activity</span>
                    </div>
                    @if (Model.RecentPayments.Count == 0)
                    {
                        <div class="empty-state">No payments found.</div>
                    }
                    else
                    {
                        <div class="activity-list">
                            @foreach (var item in Model.RecentPayments)
                            {
                                <div class="activity-item">
                                    <div class="activity-title">@item.TenantEmail</div>
                                    <div class="activity-meta">@item.PropertyName • @item.PaymentMonth @item.PaymentYear</div>
                                    <div class="activity-meta mt-2">
                                        <span class="badge @GetPaymentBadgeClass(item.Status)">@item.Status</span>
                                        <span>@item.Amount.ToString("C")</span>
                                        <span>@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="admin-pane d-none" data-admin-pane="audit">
        <div class="row g-4">
            <div class="col-12">
                <div class="panel-card audit-summary-card">
                    <div class="panel-heading">
                        <h2 class="panel-title">Audit summary</h2>
                        <span class="panel-meta">Admin actions</span>
                    </div>
                    <div class="audit-summary-grid">
                        <div class="audit-summary-item">
                            <span>Total events</span>
                            <strong>@Model.AuditSummary.TotalEvents</strong>
                        </div>
                        <div class="audit-summary-item">
                            <span>Last 24 hours</span>
                            <strong>@Model.AuditSummary.EventsLast24Hours</strong>
                        </div>
                        <div class="audit-summary-item">
                            <span>User management</span>
                            <strong>@Model.AuditSummary.UserManagementEvents</strong>
                        </div>
                        <div class="audit-summary-item">
                            <span>Password reset</span>
                            <strong>@Model.AuditSummary.PasswordResetEvents</strong>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="panel-card admin-users-card">
                    <div class="panel-heading audit-panel-heading">
                        <div>
                            <h2 class="panel-title">Audit trail</h2>
                            <div class="panel-meta">Search by actor, target, details, action, or date range.</div>
                        </div>
                        <span class="badge admin-count-badge">@Model.AuditLogs.Count of @Model.AuditTotalMatches shown</span>
                    </div>

                    <form asp-action="Dashboard" method="get" class="admin-filter-bar admin-audit-filter">
                        <input type="hidden" name="activePane" value="audit" />
                        <div class="admin-audit-field admin-audit-search">
                            <label class="admin-filter-label" for="auditSearch">Search</label>
                            <input type="text"
                                   id="auditSearch"
                                   name="auditSearch"
                                   class="form-control filter-input"
                                   placeholder="Search actor, target, details"
                                   value="@Model.AuditSearch" />
                        </div>
                        <div class="admin-audit-field">
                            <label class="admin-filter-label" for="auditActionFilter">Action</label>
                            <select id="auditActionFilter" name="auditActionFilter" class="form-select filter-select">
                                <option value="">All actions</option>
                                @foreach (var action in Model.AuditActions)
                                {
                                    <option value="@action" selected="@(Model.AuditActionFilter == action ? "selected" : null)">@action</option>
                                }
                            </select>
                        </div>
                        <div class="admin-audit-field">
                            <label class="admin-filter-label" for="auditFromDate">From</label>
                            <input type="date"
                                   id="auditFromDate"
                                   name="auditFromDate"
                                   class="form-control filter-input"
                                   value="@(Model.AuditFromDate?.ToString("yyyy-MM-dd"))"
                                   aria-label="Audit from date" />
                        </div>
                        <div class="admin-audit-field">
                            <label class="admin-filter-label" for="auditToDate">To</label>
                            <input type="date"
                                   id="auditToDate"
                                   name="auditToDate"
                                   class="form-control filter-input"
                                   value="@(Model.AuditToDate?.ToString("yyyy-MM-dd"))"
                                   aria-label="Audit to date" />
                        </div>
                        <div class="admin-audit-submit">
                            <button type="submit" class="btn admin-btn-primary">Apply</button>
                        </div>
                        <div class="admin-filter-actions admin-audit-actions">
                            <a asp-action="Dashboard" asp-route-activePane="audit" class="btn admin-btn-secondary btn-sm">Reset audit filters</a>
                            @if (Model.AuditTotalMatches > Model.AuditLogs.Count)
                            {
                                <span class="panel-meta">Showing newest @Model.AuditLogs.Count matching events. Narrow the filters for older records.</span>
                            }
                        </div>
                    </form>

                    @if (Model.AuditLogs.Count == 0)
                    {
                        <div class="empty-state">No audit events matched the current filters.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table admin-table audit-table">
                                <thead>
                                    <tr>
                                        <th>Time</th>
                                        <th>Action</th>
                                        <th>Actor</th>
                                        <th>Target</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.AuditLogs)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                <div class="panel-meta">@item.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                                            </td>
                                            <td>
                                                <span class="badge @GetAuditActionBadgeClass(item.Action)">@item.Action</span>
                                            </td>
                                            <td>
                                                <div class="audit-email">@item.ActorEmail</div>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@item.TargetType</div>
                                                <div class="panel-meta">
                                                    @if (item.TargetId.HasValue)
                                                    {
                                                        <span>#@item.TargetId</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(item.TargetEmail))
                                                    {
                                                        <span>@item.TargetEmail</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="audit-details">@item.Details</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="admin-pane d-none" data-admin-pane="announcements">
        <div class="row g-4">
            <div class="col-12">
                <div class="panel-card">
                    <div class="panel-heading">
                        <h2 class="panel-title">Create announcement</h2>
                        <span class="panel-meta">Visible to selected user roles</span>
                    </div>
                    <form asp-action="CreateAnnouncement" method="post" class="admin-announce-form">
                        @Html.AntiForgeryToken()
                        <div class="admin-announce-fields">
                            <div class="admin-announce-field-title">
                                <label class="admin-filter-label" for="newTitle">Title</label>
                                <input type="text" id="newTitle" name="Title" maxlength="200"
                                       class="form-control filter-input" placeholder="Announcement title" required />
                            </div>
                            <div class="admin-announce-field-visible">
                                <label class="admin-filter-label" for="newVisibleTo">Visible to</label>
                                <select id="newVisibleTo" name="VisibleTo" class="form-select filter-select">
                                    <option value="All">All users</option>
                                    <option value="Tenant">Tenants only</option>
                                    <option value="Landlord">Landlords only</option>
                                </select>
                            </div>
                        </div>
                        <div class="mt-2">
                            <label class="admin-filter-label" for="newBody">Message</label>
                            <textarea id="newBody" name="Body" maxlength="2000" rows="3"
                                      class="form-control filter-input" placeholder="Write your announcement here..." required></textarea>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="btn admin-btn-primary">
                                <i class="bi bi-megaphone"></i> Publish Announcement
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-12">
                <div class="panel-card admin-users-card">
                    <div class="panel-heading">
                        <h2 class="panel-title">Active announcements</h2>
                        <span class="badge admin-count-badge">@Model.Announcements.Count total</span>
                    </div>

                    @if (Model.Announcements.Count == 0)
                    {
                        <div class="empty-state">No announcements yet. Create one above.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table admin-table">
                                <thead>
                                    <tr>
                                        <th>Title &amp; Message</th>
                                        <th>Visible to</th>
                                        <th>Created by</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ann in Model.Announcements)
                                    {
                                        var visibleBadge = ann.VisibleTo switch
                                        {
                                            "Tenant" => "badge-soft-info",
                                            "Landlord" => "badge-soft-warning",
                                            _ => "badge-soft-success"
                                        };
                                        var visibleLabel = ann.VisibleTo switch
                                        {
                                            "Tenant" => "Tenants",
                                            "Landlord" => "Landlords",
                                            _ => "All users"
                                        };

                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@ann.Title</div>
                                                <div class="panel-meta announce-body-preview">@ann.Body</div>
                                            </td>
                                            <td>
                                                <span class="badge @visibleBadge">@visibleLabel</span>
                                            </td>
                                            <td>
                                                <div class="audit-email">@ann.CreatedByEmail</div>
                                                @if (ann.UpdatedAt.HasValue)
                                                {
                                                    <div class="panel-meta">Edited @ann.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                }
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@ann.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                                <div class="panel-meta">@ann.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                                            </td>
                                            <td>
                                                <div class="table-actions">
                                                    <button type="button"
                                                            class="btn admin-btn-secondary btn-sm"
                                                            onclick="toggleEditRow(@ann.SystemAnnouncementId)">
                                                        Edit
                                                    </button>
                                                    <form asp-action="DeleteAnnouncement" method="post" class="d-inline"
                                                          onsubmit="return confirm('Delete this announcement?')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@ann.SystemAnnouncementId" />
                                                        <button type="submit" class="btn admin-btn-danger btn-sm">Delete</button>
                                                    </form>
                                                </div>
                                                <div id="edit-row-@ann.SystemAnnouncementId" class="announce-edit-form d-none mt-2">
                                                    <form asp-action="EditAnnouncement" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="SystemAnnouncementId" value="@ann.SystemAnnouncementId" />
                                                        <div class="mb-2">
                                                            <input type="text" name="Title" value="@ann.Title" maxlength="200"
                                                                   class="form-control form-control-sm filter-input" required />
                                                        </div>
                                                        <div class="mb-2">
                                                            <textarea name="Body" maxlength="2000" rows="2"
                                                                      class="form-control form-control-sm filter-input" required>@ann.Body</textarea>
                                                        </div>
                                                        <div class="mb-2">
                                                            <select name="VisibleTo" class="form-select form-select-sm filter-select">
                                                                <option value="All" selected="@(ann.VisibleTo == "All" ? "selected" : null)">All users</option>
                                                                <option value="Tenant" selected="@(ann.VisibleTo == "Tenant" ? "selected" : null)">Tenants only</option>
                                                                <option value="Landlord" selected="@(ann.VisibleTo == "Landlord" ? "selected" : null)">Landlords only</option>
                                                            </select>
                                                        </div>
                                                        <button type="submit" class="btn admin-btn-primary btn-sm">Save</button>
                                                        <button type="button" class="btn admin-btn-secondary btn-sm"
                                                                onclick="toggleEditRow(@ann.SystemAnnouncementId)">Cancel</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        (() => {
            const page = document.querySelector('[data-admin-page]');
            const tabs = document.querySelectorAll('[data-admin-switch]');
            const panes = document.querySelectorAll('[data-admin-pane]');
            const headingKicker = document.querySelector('[data-admin-heading-kicker]');
            const headingTitle = document.querySelector('[data-admin-heading-title]');
            let chartsInitialized = false;

            const analyticsData = {
                labels: @Json.Serialize(Model.MonthlyAnalytics.Select(item => item.MonthLabel)),
                collectedAmounts: @Json.Serialize(Model.MonthlyAnalytics.Select(item => item.CollectedAmount)),
                newUsers: @Json.Serialize(Model.MonthlyAnalytics.Select(item => item.NewUsers)),
                maintenanceRequests: @Json.Serialize(Model.MonthlyAnalytics.Select(item => item.MaintenanceRequests)),
                maintenanceStatusLabels: @Json.Serialize(new[] { "Pending", "Approved", "In progress", "Completed", "Rejected" }),
                maintenanceStatusCounts: @Json.Serialize(new[]
                {
                    Model.MaintenanceReport.PendingCount,
                    Model.MaintenanceReport.ApprovedCount,
                    Model.MaintenanceReport.InProgressCount,
                    Model.MaintenanceReport.CompletedCount,
                    Model.MaintenanceReport.RejectedCount
                }),
                userRoleLabels: @Json.Serialize(new[] { "Admin", "Landlord", "Tenant" }),
                userRoleCounts: @Json.Serialize(new[]
                {
                    Model.UserReport.AdminCount,
                    Model.UserReport.LandlordCount,
                    Model.UserReport.TenantCount
                })
            };

            const currencyFormatter = new Intl.NumberFormat(undefined, {
                style: 'currency',
                currency: 'MYR',
                maximumFractionDigits: 0
            });

            const doughnutData = (labels, values) => {
                const hasData = values.some((value) => Number(value) > 0);

                return hasData
                    ? { labels, values, fallback: false }
                    : { labels: ['No data'], values: [1], fallback: true };
            };

            const initCharts = () => {
                if (chartsInitialized || !window.Chart) {
                    return;
                }

                const collectionCanvas = document.getElementById('adminCollectionTrendChart');
                const maintenanceCanvas = document.getElementById('adminMaintenanceStatusChart');
                const roleCanvas = document.getElementById('adminUserRoleChart');

                if (!collectionCanvas || !maintenanceCanvas || !roleCanvas) {
                    return;
                }

                const gridColor = 'rgba(148, 163, 184, 0.22)';
                const tickColor = '#64748b';
                const titleColor = '#0f172a';

                new Chart(collectionCanvas, {
                    type: 'bar',
                    data: {
                        labels: analyticsData.labels,
                        datasets: [
                            {
                                type: 'line',
                                label: 'Verified collection',
                                data: analyticsData.collectedAmounts,
                                yAxisID: 'amount',
                                borderColor: '#2563eb',
                                backgroundColor: 'rgba(37, 99, 235, 0.12)',
                                pointBackgroundColor: '#2563eb',
                                pointBorderColor: '#ffffff',
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                tension: 0.35,
                                fill: true
                            },
                            {
                                label: 'New users',
                                data: analyticsData.newUsers,
                                yAxisID: 'count',
                                backgroundColor: 'rgba(16, 185, 129, 0.72)',
                                borderRadius: 6,
                                maxBarThickness: 26
                            },
                            {
                                label: 'Maintenance requests',
                                data: analyticsData.maintenanceRequests,
                                yAxisID: 'count',
                                backgroundColor: 'rgba(245, 158, 11, 0.72)',
                                borderRadius: 6,
                                maxBarThickness: 26
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: {
                            mode: 'index',
                            intersect: false
                        },
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    boxHeight: 12,
                                    color: titleColor,
                                    font: { weight: '700' }
                                }
                            },
                            tooltip: {
                                callbacks: {
                                    label: (context) => {
                                        const label = context.dataset.label || '';
                                        const value = Number(context.parsed.y || 0);
                                        return context.dataset.yAxisID === 'amount'
                                            ? `${label}: ${currencyFormatter.format(value)}`
                                            : `${label}: ${value}`;
                                    }
                                }
                            }
                        },
                        scales: {
                            amount: {
                                beginAtZero: true,
                                position: 'left',
                                grid: { color: gridColor },
                                ticks: {
                                    color: tickColor,
                                    callback: (value) => currencyFormatter.format(value)
                                }
                            },
                            count: {
                                beginAtZero: true,
                                position: 'right',
                                grid: { drawOnChartArea: false },
                                ticks: {
                                    color: tickColor,
                                    precision: 0
                                }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { color: tickColor }
                            }
                        }
                    }
                });

                const maintenanceData = doughnutData(analyticsData.maintenanceStatusLabels, analyticsData.maintenanceStatusCounts);
                new Chart(maintenanceCanvas, {
                    type: 'doughnut',
                    data: {
                        labels: maintenanceData.labels,
                        datasets: [{
                            data: maintenanceData.values,
                            backgroundColor: maintenanceData.fallback
                                ? ['rgba(148, 163, 184, 0.28)']
                                : ['#f59e0b', '#0ea5e9', '#2563eb', '#10b981', '#ef4444'],
                            borderColor: '#ffffff',
                            borderWidth: 3,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '62%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    boxHeight: 12,
                                    color: titleColor,
                                    font: { weight: '700' }
                                }
                            }
                        }
                    }
                });

                const roleData = doughnutData(analyticsData.userRoleLabels, analyticsData.userRoleCounts);
                new Chart(roleCanvas, {
                    type: 'pie',
                    data: {
                        labels: roleData.labels,
                        datasets: [{
                            data: roleData.values,
                            backgroundColor: roleData.fallback
                                ? ['rgba(148, 163, 184, 0.28)']
                                : ['#7c3aed', '#06b6d4', '#22c55e'],
                            borderColor: '#ffffff',
                            borderWidth: 3,
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    boxWidth: 12,
                                    boxHeight: 12,
                                    color: titleColor,
                                    font: { weight: '700' }
                                }
                            }
                        }
                    }
                });

                chartsInitialized = true;
            };

            const setPane = (paneName) => {
                const selectedTab = document.querySelector(`[data-admin-switch="${paneName}"]`);

                panes.forEach((pane) => {
                    pane.classList.toggle('d-none', pane.dataset.adminPane !== paneName);
                });

                tabs.forEach((tab) => {
                    const active = tab.dataset.adminSwitch === paneName;
                    tab.classList.toggle('is-active', active);
                    tab.classList.toggle('active', active);
                    tab.setAttribute('aria-pressed', active ? 'true' : 'false');
                });

                if (headingKicker && selectedTab?.dataset.adminKicker) {
                    headingKicker.textContent = selectedTab.dataset.adminKicker;
                }

                if (headingTitle && selectedTab?.dataset.adminTitle) {
                    headingTitle.textContent = selectedTab.dataset.adminTitle;
                }

                if (paneName === 'dashboard') {
                    requestAnimationFrame(initCharts);
                }
            };

            tabs.forEach((tab) => {
                tab.addEventListener('click', (event) => {
                    event.preventDefault();
                    setPane(tab.dataset.adminSwitch);
                });
            });

            setPane(page?.dataset.adminDefault || 'users');
        })();

        function toggleEditRow(id) {
            const row = document.getElementById('edit-row-' + id);
            if (row) row.classList.toggle('d-none');
        }
    </script>
}
