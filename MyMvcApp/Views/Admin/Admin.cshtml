@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["AdminActivePane"] = Model.ActivePane;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/landlord.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/admin.css" asp-append-version="true" />
}

<div class="landlord-console admin-console" data-admin-page data-admin-default="@Model.ActivePane">
    <partial name="_AdminRail" />

    <section class="landlord-workspace admin-workspace">
        <div class="admin-shell">
            <partial name="_AdminHero" />
            <partial name="_AdminAlerts" />
            <partial name="_AdminDashboardPane" model="Model" />
            <partial name="_AdminUsersPane" model="Model" />
            <partial name="_AdminPropertiesPane" model="Model" />
            <partial name="_AdminMaintenancePane" model="Model" />
            <partial name="_AdminPaymentsPane" model="Model" />
            <partial name="_AdminAuditPane" model="Model" />
            <partial name="_AdminAnnouncementsPane" model="Model" />
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <partial name="_AdminDashboardScripts" model="Model" />
}
