@model MyMvcApp.Models.Property

@{
    ViewData["Title"] = "Edit Property";
}

<style>
    body {
        background-color: #14110F;
        color: #D9C5B2;
    }

    .form-card {
        background-color: #34312D;
        border-left: 4px solid #7E7F83;
        padding: 2rem;
        border-radius: 8px;
        margin-top: 2rem;
    }

    label {
        display: block;
        margin-top: 1rem;
        margin-bottom: 0.4rem;
        font-weight: 600;
    }

    input, select, textarea {
        width: 100%;
        padding: 0.7rem;
        border-radius: 5px;
        border: none;
        margin-bottom: 0.5rem;
    }

    .btn-custom {
        background-color: #7E7F83;
        color: #14110F;
        border: none;
        padding: 0.6rem 1.2rem;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
        margin-top: 1rem;
        margin-right: 0.8rem;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-custom:hover {
        background-color: #D9C5B2;
        color: #14110F;
    }

    .validation-text {
        color: #ff8a8a;
        font-size: 0.9rem;
    }

    .summary-validation {
        color: #ff8a8a;
        margin-bottom: 1rem;
    }
</style>

<div class="container">
    <div class="form-card">
        <h2>Edit Property</h2>
        <p style="color: #7E7F83;">
            Update the property information below.
        </p>

        <div asp-validation-summary="All" class="summary-validation"></div>

        <form asp-action="EditProperty" asp-controller="Landlord" method="post">
            @Html.AntiForgeryToken()

            <input asp-for="PropertyId" type="hidden" />
            <input asp-for="LandlordId" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />
            <input asp-for="UpdatedAt" type="hidden" />

            <label asp-for="PropertyName">Property Name</label>
            <input asp-for="PropertyName" />
            <span asp-validation-for="PropertyName" class="validation-text"></span>

            <label asp-for="PropertyType">Property Type</label>
            <select asp-for="PropertyType" asp-items="Html.GetEnumSelectList<MyMvcApp.Models.PropertyType>()"></select>
            <span asp-validation-for="PropertyType" class="validation-text"></span>

            <label asp-for="AddressLine1">Address Line 1</label>
            <input asp-for="AddressLine1" />
            <span asp-validation-for="AddressLine1" class="validation-text"></span>

            <label asp-for="AddressLine2">Address Line 2</label>
            <input asp-for="AddressLine2" />
            <span asp-validation-for="AddressLine2" class="validation-text"></span>

            <label asp-for="City">City</label>
            <input asp-for="City" />
            <span asp-validation-for="City" class="validation-text"></span>

            <label asp-for="State">State</label>
            <input asp-for="State" />
            <span asp-validation-for="State" class="validation-text"></span>

            <label asp-for="PostalCode">Postal Code</label>
            <input asp-for="PostalCode" />
            <span asp-validation-for="PostalCode" class="validation-text"></span>

            <label asp-for="FloorNumber">Floor Number</label>
            <input asp-for="FloorNumber" />
            <span asp-validation-for="FloorNumber" class="validation-text"></span>

            <label asp-for="UnitNumber">Unit Number</label>
            <input asp-for="UnitNumber" />
            <span asp-validation-for="UnitNumber" class="validation-text"></span>

            <label asp-for="SizeSqFt">Size (Sq Ft)</label>
            <input asp-for="SizeSqFt" type="number" step="0.01" />
            <span asp-validation-for="SizeSqFt" class="validation-text"></span>

            <label asp-for="Bedrooms">Bedrooms</label>
            <input asp-for="Bedrooms" type="number" />
            <span asp-validation-for="Bedrooms" class="validation-text"></span>

            <label asp-for="Bathrooms">Bathrooms</label>
            <input asp-for="Bathrooms" type="number" />
            <span asp-validation-for="Bathrooms" class="validation-text"></span>

            <label asp-for="MonthlyRent">Monthly Rent</label>
            <input asp-for="MonthlyRent" type="number" step="0.01" />
            <span asp-validation-for="MonthlyRent" class="validation-text"></span>

            <label asp-for="DepositAmount">Deposit Amount</label>
            <input asp-for="DepositAmount" type="number" step="0.01" />
            <span asp-validation-for="DepositAmount" class="validation-text"></span>

            <label asp-for="ParkingBay">Parking Bay</label>
            <input asp-for="ParkingBay" />
            <span asp-validation-for="ParkingBay" class="validation-text"></span>

            <label asp-for="Description">Description</label>
            <textarea asp-for="Description"></textarea>
            <span asp-validation-for="Description" class="validation-text"></span>

            <button type="submit" class="btn-custom">Update Property</button>
            <a href="/Landlord/MyProperties" class="btn-custom">Back to My Properties</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}