@model List<MyMvcApp.Models.Property>

@{
    ViewData["Title"] = "My Properties";
}

<div class="container landlord-shell">
    <section class="landlord-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            <div class="landlord-kicker">Property Management</div>
            <h1 class="landlord-title mb-2">My Properties</h1>
            <p class="landlord-subtitle mb-0">View and manage all properties in a cleaner cloud-style layout.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Landlord/AddProperty" class="btn landlord-btn">Add New Property</a>
            <a href="/Landlord/Dashboard" class="btn landlord-secondary-btn">Back to Dashboard</a>
        </div>
    </section>

    <section class="mt-4">
        @if (Model == null || !Model.Any())
        {
            <div class="landlord-panel landlord-empty">
                No properties found. Start by adding your first property.
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var property in Model)
                {
                    <div class="col-lg-6">
                        <div class="landlord-card h-100">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <div class="landlord-kicker">Property</div>
                                    <h4 class="mt-2 mb-2">@property.PropertyName</h4>
                                </div>
                                <span class="badge badge-soft-primary">@property.PropertyType</span>
                            </div>
                            <div class="landlord-muted mb-2">@property.AddressLine1 @property.AddressLine2</div>
                            <div class="row g-2 small">
                                <div class="col-6"><strong>City:</strong> @property.City</div>
                                <div class="col-6"><strong>State:</strong> @property.State</div>
                                <div class="col-6"><strong>Monthly Rent:</strong> RM @property.MonthlyRent</div>
                                <div class="col-6"><strong>Size:</strong> @property.SizeSqFt sq ft</div>
                                <div class="col-6"><strong>Bedrooms:</strong> @property.Bedrooms</div>
                                <div class="col-6"><strong>Bathrooms:</strong> @property.Bathrooms</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>