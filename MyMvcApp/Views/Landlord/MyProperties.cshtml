@model List<MyMvcApp.Models.Property>

@{
    ViewData["Title"] = "My Properties";
}

<style>
    body {
        background-color: #14110F;
        color: #D9C5B2;
    }

    .page-card {
        background-color: #34312D;
        border-left: 4px solid #7E7F83;
        padding: 2rem;
        border-radius: 8px;
        margin-top: 2rem;
    }

    .btn-custom {
        background-color: #7E7F83;
        color: #14110F;
        border: none;
        padding: 0.6rem 1.2rem;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
        margin-right: 0.8rem;
        margin-top: 1rem;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-custom:hover {
        background-color: #D9C5B2;
        color: #14110F;
    }

    .property-box {
        background-color: #2A2724;
        border: 1px solid #7E7F83;
        border-radius: 8px;
        padding: 1rem;
        margin-top: 1.5rem;
    }

    .muted-text {
        color: #7E7F83;
    }

    .error-text {
        color: #ff8a8a;
        margin-top: 1rem;
    }

    .success-text {
        color: #90ee90;
        margin-top: 1rem;
    }

    .action-row {
        margin-top: 1rem;
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
    }

    .inline-form {
        display: inline;
    }
</style>

<div class="container">
    <div class="page-card">
        <h2>My Properties</h2>
        <p class="muted-text">
            View and manage all your properties here.
        </p>

        @if (TempData["ErrorMessage"] != null)
        {
            <p class="error-text">@TempData["ErrorMessage"]</p>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <p class="success-text">@TempData["SuccessMessage"]</p>
        }

        <a href="/Landlord/AddProperty" class="btn-custom">Add New Property</a>
        <a href="/Landlord/Dashboard" class="btn-custom">Back to Dashboard</a>

        @if (Model == null || !Model.Any())
        {
            <div class="property-box">
                <p>No properties found. Start by adding your first property.</p>
            </div>
        }
        else
        {
            @foreach (var property in Model)
            {
                <div class="property-box">
                    <h4>@property.PropertyName</h4>
                    <p><strong>Type:</strong> @property.PropertyType</p>
                    <p><strong>Address:</strong> @property.AddressLine1 @property.AddressLine2</p>
                    <p><strong>City:</strong> @property.City</p>
                    <p><strong>State:</strong> @property.State</p>
                    <p><strong>Postal Code:</strong> @property.PostalCode</p>
                    <p><strong>Bedrooms:</strong> @property.Bedrooms</p>
                    <p><strong>Bathrooms:</strong> @property.Bathrooms</p>
                    <p><strong>Monthly Rent:</strong> RM @property.MonthlyRent</p>

                    <div class="action-row">
                        <a href="/Landlord/PropertyDetails/@property.PropertyId" class="btn-custom">Details</a>
                        <a href="/Landlord/EditProperty/@property.PropertyId" class="btn-custom">Edit</a>

                        <form asp-action="DeleteProperty" asp-controller="Landlord" method="post" class="inline-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@property.PropertyId" />
                            <button type="submit" class="btn-custom" onclick="return confirm('Are you sure you want to delete this property?');">
                                Delete
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>