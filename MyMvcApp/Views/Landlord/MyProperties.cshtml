@model List<MyMvcApp.Models.Property>

@{
    ViewData["Title"] = "My Properties";
}

<div class="landlord-console">

    <aside class="landlord-rail">
        <div class="landlord-rail-brand">
            <span class="landlord-rail-logo">
                <i class="bi bi-buildings"></i>
            </span>
            <div>
                <p class="landlord-rail-title">Landlord Console</p>
                <p class="landlord-rail-sub">Property Operations</p>
            </div>
        </div>

        <nav class="landlord-rail-nav">
            <a href="/Landlord/Dashboard" class="landlord-rail-link">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>
            <a href="/Landlord/MyProperties" class="landlord-rail-link active">
                <i class="bi bi-houses-fill"></i> Properties
            </a>
            <a href="/Landlord/Tenants" class="landlord-rail-link">
                <i class="bi bi-people-fill"></i> Tenants
            </a>
            <a href="/Landlord/AssignTenant" class="landlord-rail-link">
                <i class="bi bi-person-plus-fill"></i> Assign Tenant
            </a>
            <a href="/Landlord/MaintenanceRequests" class="landlord-rail-link">
                <i class="bi bi-tools"></i> Maintenance
            </a>
            <a href="/Landlord/Documents" class="landlord-rail-link">
                <i class="bi bi-file-earmark-text-fill"></i> Documents
            </a>
            <a href="/Landlord/Payments" class="landlord-rail-link">
                <i class="bi bi-wallet2"></i> Payments
            </a>
            <a href="/Landlord/Announcements" class="landlord-rail-link">
                <i class="bi bi-megaphone-fill"></i> Announcements
            </a>
        </nav>
    </aside>

    <section class="landlord-workspace">

        <div class="landlord-toolbar">
            <div>
                <p class="landlord-kicker">PROPERTY MANAGEMENT</p>
                <h1 class="landlord-heading">My Properties</h1>
                <p class="landlord-sub">
                    View, manage, update, and remove your registered rental properties.
                </p>
            </div>

            <div class="landlord-time">
                <strong>@DateTime.Now.ToString("dddd, dd MMM yyyy")</strong>
                <span>@DateTime.Now.ToString("hh:mm tt")</span>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="landlord-panel mb-3">
                <p class="landlord-error mb-0">@TempData["ErrorMessage"]</p>
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="landlord-panel mb-3">
                <p class="landlord-success mb-0">@TempData["SuccessMessage"]</p>
            </div>
        }

        <div class="landlord-hero">
            <div>
                <h2>Property Portfolio</h2>
                <p class="landlord-sub">
                    Total properties: @(Model == null ? 0 : Model.Count)
                </p>
            </div>

            <a href="/Landlord/AddProperty" class="landlord-btn landlord-btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Property
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <article class="landlord-panel">
                <div class="landlord-empty">
                    <i class="bi bi-inbox d-block mb-2"></i>
                    No properties found. Start by adding your first property.
                </div>
            </article>
        }
        else
        {
            <article class="landlord-panel">
                <div class="landlord-panel-head">
                    <h3 class="landlord-panel-title">Property List</h3>
                    <a href="/Landlord/Dashboard" class="landlord-link">Back to Dashboard</a>
                </div>

                <div class="landlord-list">
                    @foreach (var property in Model)
                    {
                        <div class="landlord-list-item">
                            @if (!string.IsNullOrWhiteSpace(property.ImageUrl))
                            {
                                <img src="@property.ImageUrl"
                                     alt="@property.PropertyName"
                                     style="width: 120px; height: 90px; object-fit: cover; border-radius: 8px; margin-right: 1rem;" />
                            }
                            <div>
                                <h4 class="mb-2">@property.PropertyName</h4>
                                <p class="landlord-sub mb-1">
                                    <strong>Type:</strong> @property.PropertyType |
                                    <strong>Rent:</strong> RM @property.MonthlyRent
                                </p>
                                <p class="landlord-sub mb-1">
                                    <strong>Availability:</strong> @property.AvailabilityStatus |
                                    <strong>Approval:</strong> @property.ApprovalStatus
                                </p>
                                <p class="landlord-sub mb-1">
                                    <strong>Address:</strong> @property.AddressLine1 @property.AddressLine2,
                                    @property.City, @property.State @property.PostalCode
                                </p>
                                <p class="landlord-sub mb-0">
                                    <strong>Bedrooms:</strong> @property.Bedrooms |
                                    <strong>Bathrooms:</strong> @property.Bathrooms
                                </p>
                            </div>

                            <div class="landlord-actions">
                                <a href="/Landlord/PropertyDetails/@property.PropertyId"
                                   class="landlord-btn landlord-btn-outline">
                                    Details
                                </a>

                                <a href="/Landlord/EditProperty/@property.PropertyId"
                                   class="landlord-btn landlord-btn-outline">
                                    Edit
                                </a>

                                <form asp-action="DeleteProperty"
                                      asp-controller="Landlord"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@property.PropertyId" />
                                    <button type="submit"
                                            class="landlord-btn landlord-btn-danger"
                                            onclick="return confirm('Archive this property? Properties with active tenants cannot be archived.');">
                                        Archive
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </article>
        }

    </section>
</div>
