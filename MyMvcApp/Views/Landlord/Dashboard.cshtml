@{
    ViewData["Title"] = "Landlord Dashboard";
}

<div class="container landlord-shell">
    <section class="landlord-hero">
        <div class="landlord-kicker">Landlord Workspace</div>
        <h1 class="landlord-title">Property operations center</h1>
        <p class="landlord-subtitle mb-4">
            Manage your properties, review rental details, and keep property operations in one clean cloud-style workspace.
        </p>
        <div class="d-flex flex-wrap gap-3">
            <a href="/Landlord/MyProperties" class="btn landlord-btn">Manage My Properties</a>
            <a href="/Landlord/AddProperty" class="btn landlord-secondary-btn">Add New Property</a>
        </div>
    </section>

    <section class="mt-4">
        <div class="row g-3">
            <div class="col-lg-4">
                <div class="landlord-card h-100">
                    <div class="landlord-kicker">Portfolio</div>
                    <h4 class="mt-2">Track every unit</h4>
                    <p class="landlord-muted mb-0">View properties, occupancy, and rental details with a clean dashboard surface.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="landlord-card h-100">
                    <div class="landlord-kicker">Workflow</div>
                    <h4 class="mt-2">Move faster</h4>
                    <p class="landlord-muted mb-0">Jump directly into property management actions without cluttered UI blocks.</p>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="landlord-card h-100">
                    <div class="landlord-kicker">Cloud style</div>
                    <h4 class="mt-2">Consistent design</h4>
                    <p class="landlord-muted mb-0">The landlord workspace now matches the admin system palette and panel language.</p>
                </div>
            </div>
        </div>
    </section>
</div>