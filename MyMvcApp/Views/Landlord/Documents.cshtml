@model MyMvcApp.Models.LandlordDocumentsViewModel

@{
    ViewData["Title"] = "Documents";
}

<div class="landlord-console">
    <aside class="landlord-rail">
        <div class="landlord-rail-brand">
            <span class="landlord-rail-logo">
                <i class="bi bi-buildings"></i>
            </span>
            <div>
                <p class="landlord-rail-title">Landlord Console</p>
                <p class="landlord-rail-sub">Property Operations</p>
            </div>
        </div>

        <nav class="landlord-rail-nav">
            <a href="/Landlord/Dashboard" class="landlord-rail-link">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>
            <a href="/Landlord/MyProperties" class="landlord-rail-link">
                <i class="bi bi-houses-fill"></i> Properties
            </a>
            <a href="/Landlord/Tenants" class="landlord-rail-link">
                <i class="bi bi-people-fill"></i> Tenants
            </a>
            <a href="/Landlord/AssignTenant" class="landlord-rail-link">
                <i class="bi bi-person-plus-fill"></i> Assign Tenant
            </a>
            <a href="/Landlord/MaintenanceRequests" class="landlord-rail-link">
                <i class="bi bi-tools"></i> Maintenance
            </a>
            <a href="/Landlord/Documents" class="landlord-rail-link active">
                <i class="bi bi-file-earmark-text-fill"></i> Documents
            </a>
            <a href="/Landlord/Payments" class="landlord-rail-link">
                <i class="bi bi-wallet2"></i> Payments
            </a>
            <a href="/Landlord/Announcements" class="landlord-rail-link">
                <i class="bi bi-megaphone-fill"></i> Announcements
            </a>
            <a asp-controller="Home" asp-action="Index" class="landlord-rail-link">
                <i class="bi bi-calendar-event"></i> Community Hub
            </a>
        </nav>
    </aside>

    <section class="landlord-workspace">
        <div class="landlord-toolbar">
            <div>
                <p class="landlord-kicker">DOCUMENT VAULT</p>
                <h1 class="landlord-heading">Landlord Documents</h1>
                <p class="landlord-sub">
                    Upload and manage documents connected to your properties and tenants.
                </p>
            </div>

            <button class="landlord-btn landlord-btn-primary" type="button" onclick="toggleDocumentForm()">
                <i class="bi bi-cloud-arrow-up"></i> Upload Document
            </button>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <article class="landlord-panel mb-3">
                <p class="landlord-error mb-0">@TempData["ErrorMessage"]</p>
            </article>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <article class="landlord-panel mb-3">
                <p class="landlord-success mb-0">@TempData["SuccessMessage"]</p>
            </article>
        }

        <article class="landlord-panel mb-3" id="documentFormPanel" style="display:none;">
            <div class="landlord-panel-head">
                <h3 class="landlord-panel-title">Upload New Document</h3>
            </div>

            <form id="landlordDocumentForm" asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="alert alert-info" id="landlordUploadStatusMessage" style="display:none;"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Document Name</label>
                        <input class="form-control" asp-for="NewDocument.DocumentName" placeholder="e.g. Tenancy Agreement 2026" />
                        <span asp-validation-for="NewDocument.DocumentName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Document Type</label>
                        <select class="form-select" asp-for="NewDocument.DocumentType">
                            <option value="">Select type</option>
                            <option value="TenancyAgreement">Tenancy Agreement</option>
                            <option value="IdentityCard">Identity Card</option>
                            <option value="PaymentReceipt">Payment Receipt</option>
                            <option value="InspectionReport">Inspection Report</option>
                            <option value="Others">Others</option>
                        </select>
                        <span asp-validation-for="NewDocument.DocumentType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Property</label>
                        <select class="form-select" asp-for="NewDocument.PropertyId" asp-items="Model.PropertyOptions">
                            <option value="">Select property</option>
                        </select>
                        <span asp-validation-for="NewDocument.PropertyId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Tenant</label>
                        <select class="form-select" asp-for="NewDocument.TenantId" asp-items="Model.TenantOptions">
                            <option value="">Optional tenant</option>
                        </select>
                        <span asp-validation-for="NewDocument.TenantId" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Notes</label>
                        <textarea class="form-control" asp-for="NewDocument.Notes" rows="3" placeholder="Optional notes for this document"></textarea>
                        <span asp-validation-for="NewDocument.Notes" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label">File</label>
                        <input class="form-control" asp-for="NewDocument.File" type="file" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.txt,.xlsx,.xls" />
                        <span asp-validation-for="NewDocument.File" class="text-danger"></span>
                        <p class="landlord-sub mt-2 mb-0">PDF, JPG, JPEG, PNG, DOC, DOCX, TXT, XLS, XLSX - max 10MB.</p>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button class="landlord-btn landlord-btn-outline" type="button" onclick="toggleDocumentForm()">Cancel</button>
                    <button class="landlord-btn landlord-btn-primary" id="landlordUploadButton" type="submit">Upload Document</button>
                </div>
            </form>
        </article>

        <article class="landlord-panel">
            <div class="landlord-panel-head">
                <h3 class="landlord-panel-title">Document Library</h3>
                <div style="max-width:260px;">
                    <input class="form-control" type="text" placeholder="Search documents..." oninput="searchDocuments(this.value)" />
                </div>
            </div>

            @if (Model.Documents.Count == 0)
            {
                <div class="landlord-empty">
                    <i class="bi bi-inbox d-block mb-2"></i>
                    No documents uploaded yet.
                </div>
            }
            else
            {
                <div class="landlord-list" id="documentList">
                    @foreach (var document in Model.Documents)
                    {
                        var fileSizeText = document.FileSize.HasValue
                            ? $"{Math.Round(document.FileSize.Value / 1024d, 1)} KB"
                            : "Unknown size";
                        var propertyName = document.Property?.PropertyName ?? "-";
                        var tenantEmail = document.Tenant?.User?.Email ?? "-";

                        <div class="landlord-list-item document-item" data-name="@document.DocumentName.ToLowerInvariant() @propertyName.ToLowerInvariant() @tenantEmail.ToLowerInvariant()">
                            <div>
                                <h4 class="mb-2">@document.DocumentName</h4>
                                <p class="landlord-sub mb-1">
                                    <strong>Type:</strong> @document.DocumentType |
                                    <strong>Size:</strong> @fileSizeText
                                </p>
                                <p class="landlord-sub mb-1">
                                    <strong>Property:</strong> @propertyName
                                </p>
                                <p class="landlord-sub mb-1">
                                    <strong>Tenant:</strong> @tenantEmail
                                </p>
                                <p class="landlord-sub mb-0">
                                    <strong>Uploaded:</strong> @document.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    @if (document.UploadStatus != DocumentUploadStatus.Confirmed)
                                    {
                                        <span> | <strong>Status:</strong> @document.UploadStatus</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(document.Notes))
                                    {
                                        <span> | <strong>Notes:</strong> @document.Notes</span>
                                    }
                                </p>
                            </div>

                            <div class="landlord-actions">
                                @if (document.UploadStatus == DocumentUploadStatus.Confirmed)
                                {
                                    <a asp-action="DownloadDocument" asp-route-id="@document.DocumentId" target="_blank" class="landlord-btn landlord-btn-outline">
                                        View
                                    </a>
                                    <a asp-action="DownloadDocument" asp-route-id="@document.DocumentId" class="landlord-btn landlord-btn-outline">
                                        Download
                                    </a>
                                }
                                else
                                {
                                    <button class="landlord-btn landlord-btn-outline" type="button" disabled>Validating</button>
                                }
                                <form asp-action="DeleteDocument" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@document.DocumentId" />
                                    <button class="landlord-btn landlord-btn-danger" type="submit" onclick="return confirm('Archive this document?')">
                                        Archive
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    </section>
</div>

<script>
    function toggleDocumentForm() {
        const panel = document.getElementById('documentFormPanel');
        panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
        if (panel.style.display === 'block') {
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    if (document.querySelector('.text-danger:not(:empty)')) {
        document.getElementById('documentFormPanel').style.display = 'block';
    }

    function searchDocuments(query) {
        const value = query.toLowerCase();
        document.querySelectorAll('.document-item').forEach(item => {
            const name = item.dataset.name || '';
            item.style.display = name.includes(value) ? '' : 'none';
        });
    }

    const landlordDocumentForm = document.getElementById('landlordDocumentForm');
    const landlordUploadButton = document.getElementById('landlordUploadButton');
    const landlordUploadStatusMessage = document.getElementById('landlordUploadStatusMessage');

    function setLandlordUploadMessage(message, isError) {
        landlordUploadStatusMessage.textContent = message;
        landlordUploadStatusMessage.className = isError ? 'alert alert-danger' : 'alert alert-info';
        landlordUploadStatusMessage.style.display = 'block';
    }

    async function readLandlordUploadJsonResponse(response, fallbackMessage) {
        const responseText = await response.text();
        const contentType = response.headers.get('content-type') || '';

        if (!contentType.includes('application/json')) {
            if (response.status === 401) {
                throw new Error('Your session expired. Please log in again before uploading.');
            }

            if (response.status === 403) {
                throw new Error('You do not have permission to upload this document.');
            }

            throw new Error(`${fallbackMessage} Server returned ${response.status} with a non-JSON response.`);
        }

        const payload = responseText ? JSON.parse(responseText) : {};
        if (!response.ok) {
            throw new Error(payload.message || fallbackMessage);
        }

        return payload;
    }

    async function pollLandlordUploadStatus(documentId) {
        for (let attempt = 0; attempt < 15; attempt++) {
            await new Promise(resolve => setTimeout(resolve, 2000));
            const response = await fetch(`/Landlord/GetDocumentUploadStatus/${documentId}`, {
                headers: { 'Accept': 'application/json' }
            });

            if (!response.ok) {
                continue;
            }

            const result = await response.json();
            if (result.status === 'Confirmed') {
                setLandlordUploadMessage('Upload confirmed. Refreshing document library...', false);
                window.location.reload();
                return;
            }

            if (result.status === 'FailedValidation') {
                setLandlordUploadMessage(result.validationMessage || 'Upload failed validation.', true);
                landlordUploadButton.disabled = false;
                landlordUploadButton.textContent = 'Upload Document';
                return;
            }
        }

        setLandlordUploadMessage('File reached S3. Waiting for backend validation event; the document will become available after confirmation.', false);
        setTimeout(() => window.location.reload(), 2500);
    }

    landlordDocumentForm.addEventListener('submit', async function (event) {
        event.preventDefault();

        const fileInput = document.getElementById('NewDocument_File');
        const file = fileInput.files[0];
        if (!file) {
            setLandlordUploadMessage('Please choose a valid file.', true);
            return;
        }

        landlordUploadButton.disabled = true;
        landlordUploadButton.textContent = 'Preparing upload...';
        setLandlordUploadMessage('Creating secure upload session...', false);

        try {
            const token = landlordDocumentForm.querySelector('input[name="__RequestVerificationToken"]').value;
            const propertyValue = document.getElementById('NewDocument_PropertyId').value;
            const tenantValue = document.getElementById('NewDocument_TenantId').value;
            const payload = {
                documentName: document.getElementById('NewDocument_DocumentName').value,
                documentType: document.getElementById('NewDocument_DocumentType').value,
                notes: document.getElementById('NewDocument_Notes').value,
                propertyId: propertyValue ? Number(propertyValue) : null,
                tenantId: tenantValue ? Number(tenantValue) : null,
                fileName: file.name,
                contentType: file.type || 'application/octet-stream',
                fileSize: file.size
            };

            const createResponse = await fetch('/Landlord/CreateDocumentUpload', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token,
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: JSON.stringify(payload)
            });

            const uploadSession = await readLandlordUploadJsonResponse(createResponse, 'Unable to create upload session.');
            landlordUploadButton.textContent = 'Uploading to S3...';
            setLandlordUploadMessage('Uploading file directly to S3...', false);

            const putResponse = await fetch(uploadSession.uploadUrl, {
                method: 'PUT',
                headers: { 'Content-Type': payload.contentType },
                body: file
            });

            if (!putResponse.ok) {
                throw new Error('S3 upload failed. Please try again.');
            }

            landlordUploadButton.textContent = 'Waiting for validation...';
            setLandlordUploadMessage('Upload completed. Waiting for S3 validation event...', false);
            await pollLandlordUploadStatus(uploadSession.documentId);
        } catch (error) {
            setLandlordUploadMessage(error.message || 'Upload failed.', true);
            landlordUploadButton.disabled = false;
            landlordUploadButton.textContent = 'Upload Document';
        }
    });
</script>
