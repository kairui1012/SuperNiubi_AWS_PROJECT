@model MyMvcApp.Models.Property

@{
    ViewData["Title"] = "Add Property";
}

<div class="landlord-console">

    <!-- Sidebar -->

    <aside class="landlord-rail">

        <div class="landlord-rail-brand">

            <span class="landlord-rail-logo">
                <i class="bi bi-buildings"></i>
            </span>

            <div>
                <p class="landlord-rail-title">
                    Landlord Console
                </p>

                <p class="landlord-rail-sub">
                    Property Operations
                </p>
            </div>

        </div>

        <nav class="landlord-rail-nav">

            <a href="/Landlord/Dashboard"
               class="landlord-rail-link">
                <i class="bi bi-grid-1x2-fill"></i>
                Dashboard
            </a>

            <a href="/Landlord/MyProperties"
               class="landlord-rail-link active">
                <i class="bi bi-houses-fill"></i>
                Properties
            </a>

            <a href="/Landlord/Tenants"
               class="landlord-rail-link">
                <i class="bi bi-people-fill"></i>
                Tenants
            </a>

            <a href="/Landlord/AssignTenant"
               class="landlord-rail-link">
                <i class="bi bi-person-plus-fill"></i>
                Assign Tenant
            </a>

            <a href="/Landlord/MaintenanceRequests"
               class="landlord-rail-link">
                <i class="bi bi-tools"></i>
                Maintenance
            </a>

            <a href="/Landlord/Documents"
               class="landlord-rail-link">
                <i class="bi bi-file-earmark-text-fill"></i>
                Documents
            </a>

            <a href="/Landlord/Payments"
               class="landlord-rail-link">
                <i class="bi bi-wallet2"></i>
                Payments
            </a>

            <a href="/Landlord/Announcements"
               class="landlord-rail-link">
                <i class="bi bi-megaphone-fill"></i>
                Announcements
            </a>
            <a asp-controller="Home" asp-action="Index" class="landlord-rail-link">
                <i class="bi bi-calendar-event"></i> Community Hub
            </a>

        </nav>

    </aside>



    <!-- Workspace -->

    <section class="landlord-workspace">

        <div class="landlord-toolbar">

            <div>

                <p class="landlord-kicker">
                    ADD PROPERTY
                </p>

                <h1 class="landlord-heading">
                    Register New Property
                </h1>

                <p class="landlord-sub">
                    Enter property details below to add a new rental unit.
                </p>

            </div>

        </div>



        <!-- Form Panel -->

        <article class="landlord-panel">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="landlord-success mb-3">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div asp-validation-summary="All"
                 class="landlord-error mb-3">
            </div>


            <form asp-action="AddProperty"
                  asp-controller="Landlord"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <!-- Basic Info -->

                <h4 class="mb-3">
                    Basic Information
                </h4>

                <label asp-for="PropertyName"
                       class="landlord-label">
                </label>

                <input asp-for="PropertyName"
                       class="landlord-input" />

                <span asp-validation-for="PropertyName"
                      class="landlord-error">
                </span>



                <label asp-for="PropertyType"
                       class="landlord-label">
                </label>

                <select asp-for="PropertyType"
                        class="landlord-select"
                        asp-items="Html.GetEnumSelectList<MyMvcApp.Models.PropertyType>()">
                </select>

                <span asp-validation-for="PropertyType"
                      class="landlord-error">
                </span>

                <label asp-for="AvailabilityStatus"
                       class="landlord-label">
                </label>

                <select asp-for="AvailabilityStatus"
                        class="landlord-select"
                        asp-items="Html.GetEnumSelectList<MyMvcApp.Models.PropertyAvailabilityStatus>()">
                </select>

                <label class="landlord-label" for="PropertyImage">
                    Property Image
                </label>

                <input id="PropertyImage"
                       name="PropertyImage"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                       class="landlord-input" />



                <!-- Address -->

                <h4 class="mt-4 mb-3">
                    Address Information
                </h4>

                <label asp-for="AddressLine1"
                       class="landlord-label">
                </label>

                <input asp-for="AddressLine1"
                       class="landlord-input" />

                <span asp-validation-for="AddressLine1"
                      class="landlord-error">
                </span>



                <label asp-for="AddressLine2"
                       class="landlord-label">
                </label>

                <input asp-for="AddressLine2"
                       class="landlord-input" />



                <label asp-for="City"
                       class="landlord-label">
                </label>

                <input asp-for="City"
                       class="landlord-input" />



                <label asp-for="State"
                       class="landlord-label">
                </label>

                <input asp-for="State"
                       class="landlord-input" />



                <label asp-for="PostalCode"
                       class="landlord-label">
                </label>

                <input asp-for="PostalCode"
                       class="landlord-input" />



                <!-- Unit Details -->

                <h4 class="mt-4 mb-3">
                    Unit Details
                </h4>

                <label asp-for="FloorNumber"
                       class="landlord-label">
                </label>

                <input asp-for="FloorNumber"
                       class="landlord-input" />



                <label asp-for="UnitNumber"
                       class="landlord-label">
                </label>

                <input asp-for="UnitNumber"
                       class="landlord-input" />



                <label asp-for="SizeSqFt"
                       class="landlord-label">
                </label>

                <input asp-for="SizeSqFt"
                       type="number"
                       step="0.01"
                       class="landlord-input" />



                <label asp-for="Bedrooms"
                       class="landlord-label">
                </label>

                <input asp-for="Bedrooms"
                       type="number"
                       class="landlord-input" />



                <label asp-for="Bathrooms"
                       class="landlord-label">
                </label>

                <input asp-for="Bathrooms"
                       type="number"
                       class="landlord-input" />



                <!-- Financial -->

                <h4 class="mt-4 mb-3">
                    Financial Details
                </h4>

                <label asp-for="MonthlyRent"
                       class="landlord-label">
                </label>

                <input asp-for="MonthlyRent"
                       type="number"
                       step="0.01"
                       class="landlord-input" />



                <label asp-for="DepositAmount"
                       class="landlord-label">
                </label>

                <input asp-for="DepositAmount"
                       type="number"
                       step="0.01"
                       class="landlord-input" />

                <div class="form-check my-3">
                    <input asp-for="AllowShortTerm"
                           class="form-check-input" />
                    <label asp-for="AllowShortTerm"
                           class="form-check-label">
                        Enable Book a Stay listing
                    </label>
                </div>

                <label asp-for="DailyRate"
                       class="landlord-label">
                    Daily rate for Book a Stay
                </label>

                <input asp-for="DailyRate"
                       type="number"
                       step="0.01"
                       min="0"
                       class="landlord-input" />

                <span asp-validation-for="DailyRate"
                      class="landlord-error">
                </span>



                <label asp-for="ParkingBay"
                       class="landlord-label">
                </label>

                <input asp-for="ParkingBay"
                       class="landlord-input" />



                <label asp-for="Description"
                       class="landlord-label">
                </label>

                <textarea asp-for="Description"
                          class="landlord-textarea">
                </textarea>

                <label class="landlord-label" for="AmenitiesText">
                    Amenities
                </label>

                <input id="AmenitiesText"
                       name="AmenitiesText"
                       class="landlord-input"
                       placeholder="Pool, Gym, Parking, Security" />



                <!-- Buttons -->

                <div class="landlord-actions mt-4">

                    <button type="submit"
                            class="landlord-btn landlord-btn-primary">

                        Save Property

                    </button>

                    <a href="/Landlord/MyProperties"
                       class="landlord-btn landlord-btn-outline">

                        Back to My Properties

                    </a>

                </div>

            </form>

        </article>

    </section>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
