@model List<MyMvcApp.Models.SystemAnnouncement>
@using MyMvcApp.Models

@{
    ViewData["Title"] = "Announcements";
}

<div class="landlord-console">
    <aside class="landlord-rail">
        <div class="landlord-rail-brand">
            <span class="landlord-rail-logo">
                <i class="bi bi-buildings"></i>
            </span>
            <div>
                <p class="landlord-rail-title">Landlord Console</p>
                <p class="landlord-rail-sub">Property Operations</p>
            </div>
        </div>

        <nav class="landlord-rail-nav">
            <a href="/Landlord/Dashboard" class="landlord-rail-link">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>
            <a href="/Landlord/MyProperties" class="landlord-rail-link">
                <i class="bi bi-houses-fill"></i> Properties
            </a>
            <a href="/Landlord/Tenants" class="landlord-rail-link">
                <i class="bi bi-people-fill"></i> Tenants
            </a>
            <a href="/Landlord/AssignTenant" class="landlord-rail-link">
                <i class="bi bi-person-plus-fill"></i> Assign Tenant
            </a>
            <a href="/Landlord/MaintenanceRequests" class="landlord-rail-link">
                <i class="bi bi-tools"></i> Maintenance
            </a>
            <a href="/Landlord/Documents" class="landlord-rail-link">
                <i class="bi bi-file-earmark-text-fill"></i> Documents
            </a>
            <a href="/Landlord/Payments" class="landlord-rail-link">
                <i class="bi bi-wallet2"></i> Payments
            </a>
            <a href="/Landlord/Announcements" class="landlord-rail-link active">
                <i class="bi bi-megaphone-fill"></i> Announcements
            </a>
        </nav>
    </aside>

    <section class="landlord-workspace">
        <div class="landlord-toolbar">
            <div>
                <p class="landlord-kicker">System Notices</p>
                <h1 class="landlord-heading">Announcements</h1>
                <p class="landlord-sub">Important notices from property management.</p>
            </div>
            <div class="landlord-time">
                <strong>@DateTime.Now.ToString("dddd, dd MMM yyyy")</strong>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <article class="landlord-panel landlord-announce-card">
            <div class="landlord-panel-head">
                <h3 class="landlord-panel-title">Publish Announcement</h3>
            </div>

            <form asp-action="CreateAnnouncement" asp-controller="Landlord" method="post">
                @Html.AntiForgeryToken()

                <div class="landlord-announce-form-grid">
                    <div>
                        <label class="landlord-label" for="announcementTitle">Title</label>
                        <input id="announcementTitle"
                               name="Title"
                               maxlength="200"
                               class="landlord-input"
                               placeholder="Announcement title"
                               required />
                    </div>

                    <div>
                        <label class="landlord-label" for="announcementVisibleTo">Visible to</label>
                        <select id="announcementVisibleTo"
                                name="VisibleTo"
                                class="landlord-select">
                            <option value="All">All users</option>
                            <option value="Tenant">Tenants only</option>
                            <option value="Landlord">Landlords only</option>
                        </select>
                    </div>
                </div>

                <label class="landlord-label" for="announcementBody">Message</label>
                <textarea id="announcementBody"
                          name="Body"
                          maxlength="2000"
                          rows="4"
                          class="landlord-textarea"
                          placeholder="Write your announcement here..."
                          required></textarea>

                <div class="landlord-actions mt-4">
                    <button type="submit" class="landlord-btn landlord-btn-primary">
                        <i class="bi bi-megaphone"></i>
                        Publish Announcement
                    </button>
                </div>
            </form>
        </article>

        @if (Model == null || Model.Count == 0)
        {
            <article class="landlord-panel">
                <div class="landlord-empty">No announcements at this time.</div>
            </article>
        }
        else
        {
            <div class="landlord-announce-list">
                @foreach (var ann in Model)
                {
                    var badgeClass = ann.VisibleTo switch
                    {
                        "Tenant" => "badge-primary",
                        "Landlord" => "badge-warning",
                        _ => "badge-success"
                    };
                    var badgeLabel = ann.VisibleTo switch
                    {
                        "Tenant" => "Tenants",
                        "Landlord" => "Landlords",
                        _ => "All users"
                    };

                    <article class="landlord-panel landlord-announce-card">
                        <div class="landlord-announce-header">
                            <div>
                                <h3 class="landlord-announce-title">@ann.Title</h3>
                                <div class="landlord-announce-meta">
                                    <span class="badge @badgeClass">@badgeLabel</span>
                                    <span class="landlord-sub">@ann.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                                    @if (ann.UpdatedAt.HasValue)
                                    {
                                        <span class="landlord-sub">(edited @ann.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy"))</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <p class="landlord-announce-body">@ann.Body</p>
                    </article>
                }
            </div>
        }
    </section>
</div>

<style>
    .landlord-announce-list { display: flex; flex-direction: column; gap: 1rem; }
    .landlord-announce-card { padding: 1.25rem 1.5rem; }
    .landlord-announce-form-grid { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 1rem; }
    .landlord-announce-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: .5rem; }
    .landlord-announce-title { font-size: 1rem; font-weight: 700; margin: 0 0 .35rem; }
    .landlord-announce-meta { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .landlord-announce-body { margin: 0; white-space: pre-wrap; }

    @@media (max-width: 720px) {
        .landlord-announce-form-grid { grid-template-columns: 1fr; }
    }
</style>
