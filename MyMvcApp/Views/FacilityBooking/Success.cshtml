@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="container mt-5 text-center">
    <div class="card shadow p-5 mx-auto" style="max-width: 600px;">
        <div class="text-success mb-4">
            <i class="bi bi-check-circle-fill" style="font-size: 4rem;"></i>
        </div>
        <h1 class="display-5 text-success">Booking Confirmed!</h1>
        <p class="lead mt-3">Your payment was successful and your time slot is locked in.</p>
        <p class="text-muted">You will receive an email shortly containing your digital access pass to show the security guards.</p>
        
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-5">Return Home</a>
        </div>
    </div>
</div>