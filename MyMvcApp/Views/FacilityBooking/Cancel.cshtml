@{
    ViewData["Title"] = "Booking Cancelled";
}

<div class="container mt-5 text-center">
    <div class="card shadow p-5 mx-auto" style="max-width: 600px;">
        <div class="text-warning mb-4">
            <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem;"></i>
        </div>
        <h2>Payment Cancelled</h2>
        <p class="text-muted mt-3">You cancelled the checkout process. Your booking request has not been confirmed and no charges were made.</p>
        
        <div class="mt-4">
            <a asp-controller="FacilityBooking" asp-action="Index" class="btn btn-secondary">View Facilities</a>
        </div>
    </div>
</div>