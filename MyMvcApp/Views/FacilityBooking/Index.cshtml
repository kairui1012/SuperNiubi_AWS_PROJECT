@model IEnumerable<MyMvcApp.Models.Facility>

@{
    ViewData["Title"] = "Book a Facility";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4">Our Facilities</h1>
        <p class="lead text-muted">Book a space for your next event, workout, or gathering.</p>
    </div>

    <div class="row">
        @foreach (var facility in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    @* If you add images later, you can bind the src to facility.ImageUrl *@
                    <div class="card-body">
                        <h4 class="card-title text-primary">@facility.Name</h4>
                        <p class="card-text text-muted">@facility.Description</p>
                        <h5 class="mb-4">RM @facility.HourlyRate.ToString("0.00") <small class="text-muted" style="font-size: 0.6em;">/ hour</small></h5>
                        
                        <a asp-controller="FacilityBooking" asp-action="Book" asp-route-id="@facility.Id" class="btn btn-outline-primary w-100">
                            Check Availability & Book
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>