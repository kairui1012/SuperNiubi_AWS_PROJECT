@model IEnumerable<MyMvcApp.Models.CommunityUpdate>
@{
    ViewData["Title"] = "Manage Community Hub";
}

<div class="d-flex justify-content-between align-items-center mb-4 pt-4">
    <h2 class="fw-bold">Manage Community Hub</h2>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-lg me-2"></i> Create New Update
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Type</th>
                        <th>Title</th>
                        <th>End Date</th>
                        <th>Image</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                @if (item.Type == MyMvcApp.Models.UpdateType.Event) { <span class="badge bg-success">Event</span> }
                                else if (item.Type == MyMvcApp.Models.UpdateType.Promotion) { <span class="badge bg-primary">Promotion</span> }
                                else { <span class="badge bg-danger">Notice</span> }
                            </td>
                            <td class="fw-medium">@item.Title</td>
                            <td>
                                @if(item.EndDate < DateTime.UtcNow) { <span class="text-danger">Expired</span> } 
                                else { <span>@item.EndDate.ToString("MMM dd, yyyy")</span> }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <a href="@item.ImageUrl" target="_blank" class="text-decoration-none">View Image</a>
                                }
                                else { <span class="text-muted">No Image</span> }
                            </td>
                            <td class="text-end pe-4">
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this update?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle p-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">No community updates found. Click "Create New Update" to add one.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>