@model MyMvcApp.Models.PropertyBooking

@{
    ViewData["Title"] = "Verify Property Guest Pass";
    Layout = "_Layout"; 
}

<div class="container mt-5 mb-5" style="max-width: 500px;">
    <div class="text-center mb-4">
        <h2 class="fw-bold">Guest Scanner</h2>
        <p class="text-muted">Enter the 8-character pass code or scan the QR.</p>
    </div>

    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body p-4">
            <div class="guest-scan-panel mb-3">
                <div class="d-grid gap-2 mt-3">
                    <button type="button" id="startScannerBtn" class="btn btn-outline-primary fw-bold">
                        <i class="bi bi-camera"></i> Open Camera Scanner
                    </button>
                </div>
                <p class="text-muted small text-center mt-2 mb-0">
                    Open the camera window and place the QR code inside the square frame.
                </p>
            </div>

            <form method="get" asp-action="Verify">
                <div class="input-group input-group-lg">
                    <input type="text" id="manualCode" name="code" class="form-control text-uppercase text-center fw-bold bg-light" placeholder="E.G. A1B2C3D4" value="@Context.Request.Query["code"]" required maxlength="8">
                    <button class="btn btn-primary px-4 fw-bold" type="submit">Verify</button>
                </div>
            </form>
        </div>
    </div>

    @if (ViewBag.Status != null)
    {
        <div class="card shadow border-0 overflow-hidden">
            @if (ViewBag.Status == "Valid")
            {
                <div class="bg-success text-white text-center py-5">
                    <i class="bi bi-check-circle-fill" style="font-size: 5rem;"></i>
                    <h3 class="mt-3 mb-0 fw-bold">ACTIVE GUEST</h3>
                </div>
            }
            else if (ViewBag.Status == "Invalid")
            {
                <div class="bg-danger text-white text-center py-5">
                    <i class="bi bi-x-octagon-fill" style="font-size: 5rem;"></i>
                    <h3 class="mt-3 mb-0 fw-bold">INVALID PASS</h3>
                </div>
            }
            else
            {
                <div class="bg-warning text-dark text-center py-5">
                    <i class="bi bi-clock-history" style="font-size: 5rem;"></i>
                    <h3 class="mt-3 mb-0 fw-bold">@ViewBag.Status.ToUpper()</h3>
                </div>
            }

            <div class="card-body text-center p-4">
                <h5 class="text-muted mb-4 fw-bold">@ViewBag.Message</h5>

                @if (Model != null)
                {
                    <div class="bg-light p-3 rounded-3 text-start">
                        <p class="mb-2"><span class="text-muted">Property:</span> <strong class="float-end">@Model.Property.PropertyName</strong></p>
                        <p class="mb-2"><span class="text-muted">Guest:</span> <strong class="float-end">@Model.GuestName</strong></p>
                        <p class="mb-2"><span class="text-muted">Check-In:</span> <strong class="float-end">@Model.CheckInDate.ToString("dd MMM") (3 PM)</strong></p>
                        <p class="mb-0"><span class="text-muted">Check-Out:</span> <strong class="float-end">@Model.CheckOutDate.ToString("dd MMM") (11 AM)</strong></p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="modal fade guest-scanner-modal" id="guestScannerModal" tabindex="-1" aria-labelledby="guestScannerTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-fullscreen-sm-down">
        <div class="modal-content border-0">
            <div class="modal-header border-0">
                <div>
                    <h5 class="modal-title fw-bold" id="guestScannerTitle">
                        <i class="bi bi-qr-code-scan"></i> Scan Guest QR Pass
                    </h5>
                    <p class="text-muted small mb-0">Move the phone until the QR code is clear inside the square.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close scanner"></button>
            </div>
            <div class="modal-body pt-0">
                <div class="guest-camera-shell">
                    <div id="guest-qr-reader" class="guest-qr-reader"></div>
                    <div class="guest-scan-frame" aria-hidden="true"></div>
                </div>
                <p id="scannerStatus" class="text-muted small text-center mt-3 mb-0">
                    Camera is not running yet.
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" id="stopScannerBtn" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Close Scanner
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .guest-scanner-modal .modal-content {
            border-radius: 12px;
        }

        .guest-camera-shell {
            position: relative;
            width: 100%;
            min-height: min(72vh, 520px);
            overflow: hidden;
            border-radius: 12px;
            background: #050505;
        }

        .guest-qr-reader {
            width: 100%;
            min-height: min(72vh, 520px);
            background: #050505;
        }

        .guest-qr-reader video {
            width: 100% !important;
            min-height: min(72vh, 520px);
            object-fit: cover;
        }

        .guest-scan-frame {
            position: absolute;
            inset: 50% auto auto 50%;
            width: min(68vw, 320px);
            aspect-ratio: 1;
            transform: translate(-50%, -50%);
            border: 3px solid #ffffff;
            border-radius: 14px;
            box-shadow:
                0 0 0 999px rgba(0, 0, 0, 0.32),
                0 0 24px rgba(37, 99, 235, 0.45);
            pointer-events: none;
        }

        .guest-scan-frame::before,
        .guest-scan-frame::after {
            content: "";
            position: absolute;
            inset: 12px;
            border-top: 4px solid #22c55e;
            border-bottom: 4px solid #22c55e;
            border-radius: 8px;
        }

        .guest-scan-frame::after {
            border-top: 0;
            border-bottom: 0;
            border-left: 4px solid #22c55e;
            border-right: 4px solid #22c55e;
        }

        @@media (max-width: 575.98px) {
            .guest-scanner-modal .modal-content {
                min-height: 100dvh;
                border-radius: 0;
            }

            .guest-camera-shell,
            .guest-qr-reader,
            .guest-qr-reader video {
                min-height: 64dvh;
            }
        }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
    <script>
        (() => {
            const readerId = 'guest-qr-reader';
            const startButton = document.getElementById('startScannerBtn');
            const stopButton = document.getElementById('stopScannerBtn');
            const statusText = document.getElementById('scannerStatus');
            const manualCode = document.getElementById('manualCode');
            const modalElement = document.getElementById('guestScannerModal');
            let scanner;
            let scanLocked = false;
            let modal;

            function setStatus(message) {
                if (statusText) {
                    statusText.textContent = message;
                }
            }

            function extractGuestCode(rawValue) {
                const text = (rawValue || '').trim();
                if (!text) {
                    return '';
                }

                try {
                    const url = new URL(text);
                    const code = url.searchParams.get('code');
                    if (code) {
                        return code.trim().toUpperCase();
                    }
                } catch {
                }

                const codeParamMatch = text.match(/[?&]code=([A-Za-z0-9]+)/i);
                if (codeParamMatch && codeParamMatch[1]) {
                    return codeParamMatch[1].trim().toUpperCase();
                }

                const tokenMatch = text.match(/[A-Z0-9]{8}/i);
                if (tokenMatch && tokenMatch[0]) {
                    return tokenMatch[0].toUpperCase();
                }

                return text.toUpperCase();
            }

            async function stopScanner() {
                if (!scanner) {
                    return;
                }

                try {
                    await scanner.stop();
                    await scanner.clear();
                } catch {
                } finally {
                    scanner = null;
                    scanLocked = false;
                    setStatus('Camera stopped.');
                }
            }

            async function startScanner() {
                if (scanner) {
                    return;
                }

                if (typeof Html5Qrcode === 'undefined') {
                    setStatus('QR scanner library could not load. Please check your connection and try again.');
                    return;
                }

                try {
                    scanner = new Html5Qrcode(readerId);
                    setStatus('Starting camera...');
                    const qrboxSize = Math.min(320, Math.max(220, Math.floor(window.innerWidth * 0.68)));

                    await scanner.start(
                        { facingMode: 'environment' },
                        {
                            fps: 10,
                            qrbox: { width: qrboxSize, height: qrboxSize },
                            aspectRatio: 1
                        },
                        async decodedText => {
                            if (scanLocked) {
                                return;
                            }

                            const code = extractGuestCode(decodedText);
                            if (!code) {
                                return;
                            }

                            scanLocked = true;
                            if (manualCode) {
                                manualCode.value = code;
                            }
                            setStatus('QR scanned. Verifying pass...');
                            await stopScanner();
                            modal?.hide();
                            window.location.href = `/PropertyGuard/Verify?code=${encodeURIComponent(code)}`;
                        },
                        () => {
                        });

                    setStatus('Camera is active. Point it at the guest QR code.');
                } catch {
                    scanner = null;
                    setStatus('Unable to start camera. Use HTTPS and allow camera permission in your browser.');
                }
            }

            startButton?.addEventListener('click', () => {
                modal ??= bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.show();
            });

            stopButton?.addEventListener('click', stopScanner);

            modalElement?.addEventListener('shown.bs.modal', startScanner);
            modalElement?.addEventListener('hidden.bs.modal', stopScanner);

            window.addEventListener('beforeunload', () => {
                if (scanner) {
                    scanner.stop().catch(() => {});
                }
            });
        })();
    </script>
}
